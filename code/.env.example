# Which model every phase uses: provider:model (CLI --llm / config `llm:` override this).
# TASK2VIEW_LLM=anthropic:claude-opus-5-5
# TASK2VIEW_LLM_EFFORT=high          # Anthropic effort: low | medium | high | xhigh | max

# Gemini (default provider)
GEMINI_API_KEY=your_key
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic — or use an `ant auth login` profile instead of a key
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Open-source models through OpenAI-compatible servers
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# Claude subscription through the Agent SDK (no API key): --llm claude-code:claude-sonnet-5-5
# needs: pip install -e ".[claude-code]" and a one-time `claude` -> /login. Leave ANTHROPIC_API_KEY unset.
# CLAUDE_CODE_MODEL=claude-sonnet-5-5
