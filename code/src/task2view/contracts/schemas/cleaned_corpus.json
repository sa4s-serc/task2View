{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task2view.local/schemas/cleaned_corpus.json",
  "title": "CleanedCorpus",
  "type": "object",
  "required": ["request_id", "repository", "kept", "dropped", "counts"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "repository": { "type": "string" },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "bytes", "reason"],
        "properties": {
          "path": { "type": "string" },
          "language": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["kept", "dropped"],
      "properties": {
        "kept": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 },
        "languages": { "type": "object" }
      }
    }
  }
}
