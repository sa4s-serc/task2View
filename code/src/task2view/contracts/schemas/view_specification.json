{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task2view.local/schemas/view_specification.json",
  "title": "ViewSpecification",
  "type": "object",
  "required": [
    "request_id",
    "stakeholder",
    "task_summary",
    "architectural_concerns",
    "selected_view",
    "required_information"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "stakeholder": { "type": "string" },
    "task_summary": { "type": "string" },
    "architectural_concerns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "selected_view": {
      "type": "object",
      "required": ["view_type", "notation", "diagram_language", "granularity", "purpose"],
      "properties": {
        "view_type": { "type": "string" },
        "notation": { "type": "string" },
        "diagram_language": { "type": "string" },
        "granularity": { "type": "string" },
        "purpose": { "type": "string" },
        "viewpoint_id": { "type": ["string", "null"] },
        "grain_unit": { "type": ["string", "null"] }
      }
    },
    "required_information": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "need"],
        "properties": {
          "id": { "type": "string", "pattern": "^RI-" },
          "need": { "type": "string", "minLength": 1 }
        }
      }
    },
    "declared_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "selection_trace": { "type": "object" }
  }
}
