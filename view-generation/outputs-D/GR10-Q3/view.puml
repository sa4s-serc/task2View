@startuml
' ---- house style (print) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 260 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 360 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
classDiagram {
  class { BackgroundColor #F8FAFC }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

left to right direction
left to right direction
title UML class diagram: persisted data of the municipal report system (JPA entities and their users)
hide empty members
skinparam classAttributeIconSize 0

abstract class "User" as User <<accent>> {
  userId: Long {PK}
  name: String
  lastName: String
  phoneNumber: String
  role: String {discriminator}
}
class "Citizen" as Citizen
class "MunicipalOperator" as Operator
class "Credentials" as Credentials <<dataType>> <<muted>> {
  email: String {unique}
  password: String
}
class "Report" as Report <<accent>> {
  reportId: Long {PK}
  title: String {max 50}
  description: String {max 1000}
  category: ReportCategory
  dateReport: Date
  imageAttached: String
  currentStatusName: String
  citizenEditable: boolean
}
class "Location" as Location <<dataType>> <<muted>> {
  city: String
  cap: String
  street: String
  streetNumber: String
  municipalArea: String
}
enum "ReportCategory" as Category {
  BROKEN_STREETLIGHT
  DAMAGED_ROAD
  ABANDONED_WASTE
  GENERAL_HAZARD
  DAMAGED_STREET_FURNITURE
}
class "StatusUpdate" as StatusUpdate {
  updateId: Long {PK}
  updateDate: Date
  newStatus: String
}
class "InternalNote" as Note {
  noteId: Long {PK}
  text: String {max 1000}
  dateEntry: Date
}
class "Notification" as Notification {
  notificationId: Long {PK}
  sentDate: Date
  message: String {max 1000}
  notifiedStatus: String
}
class "ReportService" as ReportService <<alert>> {
  registerNewReport()
  updateReportStatus()
  registerInternalNote()
  generateStatusChangeNotification()
}
class "UserService" as UserService <<alert>> {
  registerUser()
}
class "PersistenceService" as Persistence <<alert>> {
  save(object)
  update(object)
  findById(class, id)
  findByFields(class, filters)
}

User <|-- Citizen
User <|-- Operator
User *-- "1" Credentials
Report *-- "1" Location
Report --> "1" Category : category
Citizen "1" <-- "0..*" Report : citizen_id NOT NULL
Operator "0..1" <--- "0..*" Report : operator_id
Report "1" *-- "0..*" StatusUpdate : report_id NOT NULL
Report "1" *-- "0..*" Note : report_id NOT NULL
Operator "1" <-- "0..*" StatusUpdate : operator_id NOT NULL
Operator "1" <-- "0..*" Note : operator_id NOT NULL
Citizen "1" <-- "0..*" Notification : citizen_id NOT NULL
Report "1" <-- "0..*" Notification : report_id NOT NULL

ReportService ..> Persistence : <<call>>
UserService ..> Persistence : <<call>>
ReportService ..> Report : <<use>>
ReportService ..> StatusUpdate : <<use>>
ReportService ..> Note : <<use>>
ReportService ..> Notification : <<use>>
UserService ..> User : <<use>>

note bottom of Report
  Tables: users, reports, status_updates, internal_notes,
  notifications. Schema is generated by hibernate.hbm2ddl.auto=update
  (no migration scripts).
  Stored status values, shared by Report.currentStatusName,
  StatusUpdate.newStatus and Notification.notifiedStatus:
  submitted -> assigned -> in_progress -> resolved.
  citizenEditable is true only while submitted. The operator is set
  on the report when its status is updated, and each change adds a
  StatusUpdate row. The Java state classes are not persisted.
end note
note bottom of Notification
  Created only for assigned and resolved, saved explicitly by
  ReportService (no cascade from Report). Its report_id FK
  blocks deleting a report.
end note
note bottom of User
  One table users; role = CITIZEN or MUNICIPAL_OPERATOR.
  Credentials and Location are embedded columns.
end note
note bottom of UserService
  Used by 8 controllers: UserLogin, UserRegistration,
  ReportCreation, ReportReview, ReportDetails,
  ReportStatusUpdate, InternalNote, ActivityMonitoring.
  Also loads Citizen and MunicipalOperator by id. Queries use
  attribute paths, e.g. credentials.email.
end note
note bottom of ReportService
  Used by 7 controllers: ReportCreation, ReportReview,
  ReportDetails, ReportStatusUpdate, InternalNote,
  ActivityMonitoring, Notification.
  Queries use attribute paths, e.g. report.reportId and
  citizenReporting.userId: renaming a mapped attribute breaks them.
  Also loads MunicipalOperator by id.
end note
legend right
  Blue: core entities. Grey: embedded value types (no own table).
  Red: persistence access classes that depend on the entities.
  Solid diamond: lifecycle-owned (cascade ALL). Column names on
  associations are the foreign key join columns.
end legend
@enduml
