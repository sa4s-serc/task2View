@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

actor       "Client\n(REST client / Swing form)"        as client
participant "AuthenticationController\n(REST, /api/auth)"  as ctl
participant "UserManager\n(via LibraryFacade)"          as um
participant "UserRegistry"                              as registry
participant "Student / Librarian\nFactory"              as factory
participant "PersistenceManager\n(JPA, MySQL)"          as pm

client -> ctl ++ : POST /register (role, name,\nsurname, email, password, identifier)
ctl -> um ++ : register(...)
um -> um : validate role, name, password;\n[Student] ID format / [Librarian] code
alt invalid data or role
  um --> ctl : IllegalArgumentException
else valid
  um -> registry : institutionalEmailExists(email)
  alt email found
    um --> ctl : IllegalArgumentException\n"Email is already associated"
  else free
    um -> registry : findStudentByStudentNumber /\nfindLibrarianByCode(identifier)
    alt identifier found
      um --> ctl : IllegalArgumentException\n"Identifier is already in use"
    else free
      um -> factory : createUser(...)\n[Student] StudentFactory / [Librarian] LibrarianFactory
      um -> registry : registerUser(newUser)
      registry -> pm : save(newUser)
      alt not saved
        um --> ctl : RuntimeException "could not be saved"
      else saved
        um --> ctl : UserDTO
      end
    end
  end
end
ctl --> client -- : HTTP response
deactivate um
note right of ctl
  RestExceptionHandler: IllegalArgumentException -> 400 {"error"};
  the save-failure RuntimeException is not mapped (Spring default 500).
  Lookups in UserRegistry go through PersistenceManager.findFirstByFields.
end note
note over client, pm
  Swing form calls LibraryFacade.register directly (no controller)
  and shows the exception text in a dialog.
end note
@enduml
