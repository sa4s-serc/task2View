@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

title UML component diagram: Municipal Report Management System, whole system (overview)

actor "Citizen /\nMunicipal operator" as user

  component "Swing screens (package Boundary)\nUser interface: forms and tables" as gui
  component "Use-case controllers (package Control)\nOrchestrate one use case each, mostly via\nSystemServicesController" as ctrl
  component "Domain services (package Entity)\nBusiness rules; return Map-based data" as svc
  component "Domain entities (package Entity)\nReports, users, notifications, report states" as dom <<accent>>
  component "Persistence access (package Database)\nGeneric JPA queries and transactions" as persist
component "MySQL database\nreports_db (external)" as db <<muted>>

user --> gui : operates
gui ..> ctrl : invokes use cases
gui ..> dom : reads report categories
ctrl ..> svc : delegates
svc ..> dom : manipulates
svc .down..> persist : persists
persist ..> dom : maps to tables
persist ..> db : JDBC

@enduml
