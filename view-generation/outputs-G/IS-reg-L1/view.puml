@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (student or librarian)
hide footbox
autonumber "<b>00"

actor       "Student or librarian\n(or HTTP test client)"            as user
participant "Registration entry\n(Swing form / POST /api/auth/register)" as entry
participant "LibraryFacade"                                         as facade
participant "UserManager"                                           as mgr
participant "UserRegistry"                                          as reg
participant "PersistenceManager\n(JPA / Hibernate)"                 as pm
participant "MySQL\nreservationsdb"                                 as db

user -> entry ++ : submit role, name, surname,\nemail, password, identifier
entry -> facade ++ : register(...)
facade -> mgr ++ : register(...)
mgr -> mgr : validate role, names, password,\nunina.it email, identifier format
mgr -> reg ++ : check email and identifier unused
reg -> pm ++ : findFirstByFields (2 lookups)
pm -> db : SELECT
pm --> reg -- : existing user or null
reg --> mgr -- : not found
alt valid, unique
  mgr -> mgr : create Student or Librarian\n(StudentFactory / LibrarianFactory)
  mgr -> reg ++ : registerUser(newUser)
  reg -> pm ++ : save(newUser)
  pm -> db : INSERT (persist, commit)
  pm --> reg -- : true
  reg --> mgr -- : true
  mgr --> facade -- : UserDTO
  facade --> entry -- : UserDTO
  entry --> user -- : confirmation (then login screen)
else invalid, duplicate, save failed
  mgr --> facade : IllegalArgumentException /\nRuntimeException
  facade --> entry : exception propagates
  entry --> user : error message
end
@enduml
