@startuml
' ---- house style ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 260 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 360 }
</style>
skinparam linetype polyline
skinparam nodesep 70
skinparam ranksep 80
left to right direction
hide empty members
skinparam classAttributeIconSize 0

title UML class diagram: persisted report data and its dependents (MySQL reports_db via JPA/Hibernate)

abstract class "User" as User #DBEAFE {
  userId: Long {PK}
  name: String {≤ 50}
  lastName: String {≤ 50}
  phoneNumber: String {≤ 20}
}
class "Credentials" as Credentials {
  email: String {unique, ≤ 100}
  password: String {≤ 100}
}
class "Citizen" as Citizen {
  discriminator role = CITIZEN
}
class "MunicipalOperator" as MunicipalOperator {
  discriminator role = MUNICIPAL_OPERATOR
}
class "Report" as Report #DBEAFE {
  reportId: Long {PK}
  title: String {≤ 50}
  description: String {≤ 1000}
  category: ReportCategory {≤ 50}
  dateReport: Date {DATE}
  imageAttached: String {optional}
  currentStatusName: String {≤ 30}
  citizenEditable: boolean
}
class "Location" as Location {
  city: String {≤ 80}
  cap: String {≤ 5}
  street: String {≤ 100}
  streetNumber: String {≤ 10}
  municipalArea: String {≤ 80}
}
enum "ReportCategory" as ReportCategory {
  BROKEN_STREETLIGHT
  DAMAGED_ROAD
  ABANDONED_WASTE
  GENERAL_HAZARD
  DAMAGED_STREET_FURNITURE
}
interface "ReportStatus" as ReportStatus #F8FAFC {
  updateStatus(report)
  isStatusNotifiable()
}
class "StatusUpdate" as StatusUpdate {
  updateId: Long {PK}
  updateDate: Date {TIMESTAMP}
  newStatus: String {≤ 30}
}
class "InternalNote" as InternalNote {
  noteId: Long {PK}
  text: String {≤ 1000}
  dateEntry: Date {TIMESTAMP}
}
class "Notification" as Notification {
  notificationId: Long {PK}
  sentDate: Date {TIMESTAMP}
  message: String {≤ 1000}
  notifiedStatus: String {≤ 50}
}
class "ReportService" as ReportService #F8FAFC
class "UserService" as UserService #F8FAFC
class "PersistenceService" as PersistenceService #F8FAFC

User "1" *-- "1" Credentials : credentials
User <|-- Citizen
User <|-- MunicipalOperator
Report "1" *-- "1" Location : location
Report "0..*" --> "1" Citizen : citizenReporting (citizen_id)
Report "0..*" --> "0..1" MunicipalOperator : operator (operator_id)
Report "1" *-- "0..*" StatusUpdate : statusUpdates
Report "1" *-- "0..*" InternalNote : internalNotes
Notification "0..*" --> "1" Report : report (report_id)
Notification "0..*" --> "1" Citizen : destinatario (citizen_id)
StatusUpdate "0..*" --> "1" MunicipalOperator : operator (operator_id)
InternalNote "0..*" --> "1" MunicipalOperator : operator (operator_id)
Report --> ReportCategory : category
Report --> ReportStatus : currentStatus {transient}

ReportService ..> PersistenceService : save / update / find
UserService ..> PersistenceService : save / find
ReportService ..> Report
ReportService ..> StatusUpdate
ReportService ..> InternalNote
ReportService ..> Notification
ReportService ..> User
ReportService ..> MunicipalOperator
UserService ..> User

note right of Report
  currentStatusName, StatusUpdate.newStatus and
  Notification.notifiedStatus share one vocabulary:
  submitted | assigned | in_progress | resolved
  (any other value on load throws IllegalStateException).
  citizenEditable is true only while submitted.
  A StatusUpdate is written only when an operator is assigned.
  Notification: only assigned / resolved, enforced in code,
  not by the schema.
end note
note bottom of ReportStatus
  Not stored as a table: Submitted, Assigned,
  InProgress, Resolved implement it and are
  rebuilt from Report.currentStatusName (@PostLoad).
end note
note bottom of UserService
  Callers: the controllers (login, registration, creation, review, details, status update, notes, monitoring, notification) instantiate these services; the GUIs reach them via the controllers.
end note
legend right
  Filled diamond = composition: JPA cascade ALL + orphanRemoval,
  or @Embedded (same table). Users share one table (single table
  inheritance, column role). Light grey = dependents / non-persistent.
  Schema is generated by hbm2ddl=update.
end legend
@enduml
