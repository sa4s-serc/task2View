@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

actor       "Client\n(HTTP request)"                      as client
participant "REST controller\n(AuthenticationController)" as ctl
participant "Facade\n(LibraryFacade)"                     as facade
participant "User manager\n(UserManager)"                 as um
participant "User registry\n(UserRegistry)"               as reg
participant "User factory\n(Student/LibrarianFactory)"    as factory
participant "Persistence manager\n(PersistenceManager, MySQL)" as pm

note over client, facade
  Second entry point: the Swing Registration form rejects blank fields,
  then calls LibraryFacade.register directly (no REST controller).
end note
client -> ctl : register(role, name, surname,\nemail, password, identifier)
ctl -> facade : register(...)
facade -> um : register(...)
um -> um : validate role, names, email, password,\nidentifier format (Student ID: one letter + 8 digits;\nLibrarian code: alphanumeric)
break invalid data
  um --> facade : IllegalArgumentException\n(registry never called)
  facade --> ctl : IllegalArgumentException
  ctl --> client : HTTP 400 (RestExceptionHandler)
end
um -> reg : institutionalEmailExists(email)
reg -> pm : find by email
reg --> um : exists?
break email taken
  um --> facade : IllegalArgumentException\n(propagates as above, HTTP 400)
end
alt role Student
  um -> reg : findStudentByStudentNumber(id)
  reg -> pm : find by studentNumber
else role Librarian
  um -> reg : findLibrarianByCode(code)
  reg -> pm : find by librarian code
end
reg --> um : exists?
break ID in use
  um --> facade : IllegalArgumentException\n(propagates as above, HTTP 400)
end
alt role Student
  um -> factory : StudentFactory.createUser(...)
  factory --> um : Student (studentNumber set)
else role Librarian
  um -> factory : LibrarianFactory.createUser(...)
  factory --> um : Librarian (internalIdentifierCode set)
end
um -> reg : registerUser(user)
reg -> pm : save(user)
pm --> reg : true, or false after rollback
reg --> um : saved?
alt saved
  um --> facade : UserDTO
  facade --> ctl : UserDTO
  ctl --> client : UserDTO
else save failed
  um --> facade : RuntimeException "not saved"\n(not mapped by RestExceptionHandler)
end
@enduml
