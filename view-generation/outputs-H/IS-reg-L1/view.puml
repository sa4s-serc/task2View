@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

title cmp User registration, components involved

actor "Student or librarian" as user

package "Presentation" {
  component "Registration form (Swing)" as form
  component "Authentication REST API" as api
}
package "Application" {
  component "Library facade" as facade
  component "User manager" as manager
  component "User factories" as factories
}
package "Domain and persistence" {
  component "User registry" as registry
  component "Persistence manager" as persistence
}
component "MySQL database" as db

user --> form : fills in form
user --> api : POST /api/auth/register
form --> facade : register
api --> facade : register
facade --> manager : register
manager --> factories : create user
manager --> registry : check and save
registry --> persistence : save, find
persistence --> db : JPA / Hibernate
@enduml
