@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaxWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaxWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaxWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60


title UML package diagram: seat booking modules
package "boundary" as boundaryPkg {
  package "Booking wizard (Swing)" as wizard {
  }
  package "Booking REST API" as rest {
  }
  class "Email notification adapter" as email
  class "Notification configuration" as notifcfg
}
package "controller" as controller {
  class "Library facade" as facade
  class "Reservation manager" as resmgr
  class "Study room manager" as roommgr
  class "Notification manager" as notifmgr
  interface "Notification service" as notifApi
  package "Seat assignment strategy" as strategy {
  }
}
package "Data transfer objects" as dto {
}
package "entity" as entity {
  package "Reservation model and registries" as model {
  }
  package "Reservation state" as state {
  }
}
package "database" as database {
  package "Persistence manager (JPA, Hibernate)" as persist {
  }
}

wizard ..> facade : calls
rest ..> facade : calls
boundaryPkg ..> dto : sends DTOs
controller ..> dto : returns DTOs
facade ..> resmgr : makes reservation
facade ..> roommgr : lists rooms
resmgr ..> strategy : picks seat if none given
resmgr ..> notifmgr : notifies
resmgr ..> model : saves
resmgr ..> state : sets state
roommgr ..> model : reads rooms
strategy ..> model : reads seats
notifmgr ..> model : reads
notifmgr ..> notifApi : sends via
email ..|> notifApi : realizes
notifcfg ..> notifmgr : installs
notifcfg ..> email : creates
model ..> persist : saves and loads
legend right
  Dashed arrows are «use» dependencies;
  the hollow arrow is interface realization.
end legend
@enduml
