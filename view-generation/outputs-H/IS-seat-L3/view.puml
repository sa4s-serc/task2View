@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

' ---- body ----
title Seat booking: components and dependencies

actor "Student" as student

package "Presentation" as presentation {
  [Swing Desktop Client] as swing
  [REST API] as rest
  [Notification Scheduler] as sched
}
package "Application" as application {
  [Library Facade] as facade
  component "Reservation Manager\napplies booking rules: room, area, slot,\none booking per slot, seat choice" as resman <<accent>>
  component "Seat Assignment Strategy\nfirst available seat" as strategy <<accent>>
  component "Study Room Manager\nown seat occupancy for browsing" as roomman <<alert>>
  [Notification Manager] as notifman <<alert>>
}
package "Domain and registries" as domainlayer {
  component "Reservation Domain Model\nSeat.isAvailable, states, check-in\ntolerance, student uniqueness check" as domain <<accent>>
  [Reservation Registry] as resreg <<accent>>
  [Study Room Registry] as roomreg
  [User Registry] as userreg <<alert>>
}
package "Notification integration" as integration {
  interface "NotificationService" as notifsvc
  [Email Notification Adapter] as adapter
}
database "MySQL database\n(via Persistence Manager)" as db
component "External email gateway (stub)" as gateway <<muted>>


student ..> swing : books seats
student ..> rest : books seats
swing ..> facade : calls operations
rest ..> facade : calls operations
sched ..> facade : triggers expiry, reminders
facade ..> resman : delegates booking
facade ..> roomman : browsing
facade ..> notifman : delegates reminders
resman ..> strategy : selects seat
resman ...> domain : checks availability
resman ...> resreg : saves reservations
resman --> roomreg : looks up rooms
resman ...> userreg : loads student
resman ..> notifman : registers observer, notifies
roomman ...> domain : counts free seats
roomman ...> resreg : derives occupancy
roomman --> roomreg : reads rooms
domain ...> resreg : queries seat bookings
domain ..> roomreg : lists area seats
notifman .[norank].> domain : observes reservations
notifman ..> notifsvc : requires
adapter -up- notifsvc
adapter ..> gateway : sends email
resreg ..> db : persists via JPA
roomreg ..> db : persists
userreg ..> db : persists

legend right
  Blue: likely changed for new booking rules
  Red: may be affected, keep consistent
  Grey: external stub, outside the application
  Facade and clients are affected only if the
  request or its error messages change
endlegend
@enduml
