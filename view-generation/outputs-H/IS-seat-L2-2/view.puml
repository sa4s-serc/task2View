@startuml
' ---- house style (document) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 260 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 420 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 70

title pkg Seat booking in the study-room reservation application

package "Entry points" as entry {
  package "Desktop booking screens" as swing {
    note "Swing wizard calls the facade.\nImpact: needs a new input or message\nwhen a rule needs one." as nSwing
  }
  package "Reservation REST API" as rest {
    note "HTTP booking endpoints.\nImpact: same as the screens." as nRest
  }
  package "Reservation scheduler" as sched {
    note "Ends bookings, sends reminders.\nImpact: none for a booking rule." as nSched
  }
}
package "Booking logic" as logic {
  package "Library facade" as facade {
    note "Single entry, delegates.\nImpact: signature if input changes." as nFacade
  }
  package "Reservation manager" as resMgr {
    note "Runs the booking flow in makeReservation:\nvalidate seat, check one booking per slot,\nlist free seats, select, save, notify.\nImpact: a new rule check is added here." as nRes
  }
  package "Seat assignment strategy" as strategy {
    note "Picks a seat from the free ones.\nImpact: changes if a rule affects which\nseat is chosen." as nStrat
  }
  package "Room availability manager" as roomMgr {
    note "Availability shown to users,\nroom deletion cancels bookings.\nImpact: shows availability with the same\npredicates, so a rule change shows here." as nRoom
  }
  package "Notification manager" as notifMgr {
    note "Confirmations and reminders.\nImpact: new messages if a rule rejects\nor changes a booking." as nNotif
  }
}
package "Booking data" as data {
  package "Booking DTOs" as dto {
    note "Booking request and reservation data.\nImpact: new rule input or error data." as nDto
  }
}
package "Domain and persistence" as domain {
  package "Reservation and seat model" as model {
    note "Rule predicates: Seat.isAvailable,\nArea.getAvailableSeats, one booking per\nslot (Student), StudyRoom.isOpenOnDate.\nImpact: likely changed by a new rule." as nModel
  }
  package "Registries" as registries {
    note "Queries and stores; ReservationRegistry\n.occupiesSlot is the shared occupancy rule.\nImpact: likely changed by a new rule." as nReg
  }
  package "Persistence (JPA, MySQL)" as persist {
    note "Stores reservations and rooms.\nImpact: only if the stored data changes." as nPers
  }
}

swing ..> facade : calls
rest ..> facade : calls
sched ..> facade : calls
swing ..> dto : builds request
rest ..> dto : builds request
facade ..> dto : passes request
resMgr ..> dto : reads request
facade ..> resMgr : books, cancels
facade ..> roomMgr : queries rooms
facade ....> notifMgr : sends reminders
resMgr ..> strategy : selects seat
resMgr ..> notifMgr : notifies
resMgr ....> registries : saves reservation
resMgr ..> model : creates reservation
roomMgr ..> registries : reads, cancels bookings
roomMgr ..> model : reads availability
roomMgr ..> notifMgr : notifies on deletion
strategy ..> model : picks Seat
notifMgr ....> registries : saves status
model ..> registries : checks occupancy
registries ..> model : loads
registries ..> persist : stores data
@enduml
