@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

' ---- body ----
title UML component diagram: Municipal report management application

component "Boundary (presentation: Swing screens)" as screens
component "Control (application: use-case controllers)" as controllers
component "Entity (domain: entities and services)" as domain
component "Database (persistence: JPA access)" as storage
component "jakarta.persistence (JPA API, external)" as jpa <<library>>

interface "Controller facade" as ctlApi
interface "Login controller" as loginApi
interface "Report and user services (logical interface)" as domApi
interface "PersistenceService" as dbApi

controllers -up- ctlApi
controllers -up- loginApi
domain -up- domApi
storage -up- dbApi

screens ..> ctlApi : <<use>>
screens ..> loginApi : <<use>>
screens ..> domain : <<use>>
controllers ..> domApi : <<use>>
domain ..> dbApi : <<use>>
domain ..> jpa : <<use>>
storage ..> jpa : <<use>>


note right of screens
  Swing screens for login, registration,
  dashboard, reports, status and notes.
end note
note left of controllers
  One controller per use case. The facade exposes
  register, create report, review, details, status
  update, internal note and activity monitoring.
  Login is not part of the facade.
end note
note left of domain
  JPA entities plus ReportService and UserService,
  which call PersistenceService directly, so domain
  and persistence are coupled. Entities use JPA
  annotations.
end note
note right of storage
  Generic JPA/Hibernate access to MySQL.
end note

legend right
  «library»: external library, not part of the code base.
endlegend
@enduml
