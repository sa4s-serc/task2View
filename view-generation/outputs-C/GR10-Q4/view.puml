@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title Use case diagram: Municipal Issue Reporting System

actor "User" as usr
actor "Citizen" as cit
actor "Municipal Operator" as op

rectangle "Municipal Issue Reporting System" {
  usecase "Register account" as UC1
  usecase "Log in" as UC2
  usecase "Create report" as UC3
  usecase "View submitted reports" as UC4
  usecase "View received reports" as UC5
  usecase "View report details" as UC6
  usecase "Update report status" as UC7
  usecase "Add internal note" as UC8
  usecase "Monitor activity trends" as UC9
}

cit -up-|> usr
op -up-|> usr
usr --> UC1
usr --> UC2
cit --> UC3
cit --> UC4
op --> UC5
op --> UC7
op --> UC8
op --> UC9
UC6 ..> UC4 : <<extend>>
UC6 ..> UC5 : <<extend>>
UC7 ..> UC5 : <<include>>
UC8 ..> UC5 : <<include>>
UC7 ..> UC6 : <<include>>
@enduml
