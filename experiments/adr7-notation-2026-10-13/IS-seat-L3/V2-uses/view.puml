@startuml
title Uses view — seat booking functionality
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false

package "Progetto-IS-main-English" {
  component "Web client\n----\napp.js" as p_web_client <<web_client>>
  component "Library booking desktop app\n----\nSwing screens for selecting rooms, areas, seats and time slots\nSeatSelection, ReservationSummary, WizardState, …" as p_ui <<ui>>
  component "Reservation reminder scheduler\n----\nperiodically triggers reservation end handling and reminders\nNotificationScheduler\nanswers: interacting with external services such as the notification service; managing and storing reservations; …" as p_job <<job>>
  component "Booking and availability REST API\n----\nREST boundary for reservation create, cancel, check-in and room availability queries\nStudyRoomController, ReservationController, StudentController\nanswers: handling booking requests; checking seat availability; …" as p_api <<api>>
  component "Booking service\n----\napplies seat assignment, handles cancel and check-in, manages rooms and availability\nLibraryFacade, ReservationManager, StudyRoomManager\nanswers: managing and storing reservations; handling booking requests; …" as p_service_1 <<service>> #FAC775
  component "Notification service\n----\nbuilds notification messages, sends reminders and delivers them to recipients\nNotificationManager, NotificationService\nanswers: interacting with external services such as the notification service; managing and storing reservations; …" as p_service_2 <<service>>
  component "Reservation domain model\n----\nreservations, seats, rooms and states; computes available seats per date and slot\nReservation, Student, Area, …\nanswers: checking seat availability; applying booking rules; …" as p_domain <<domain>>
  component "Reservation storage\n----\nsaves, updates and queries reservations, rooms and users via EntityManager\nStudyRoomRegistry, ReservationRegistry, PersistenceManager, …\nanswers: managing and storing reservations; applying booking rules; …" as p_data_access <<data_access>>
}
database "MySQL database\n<size:10>MySQL</size>" as p_database
p_service_1 ..> p_domain : <<use>>
p_service_1 ..> p_data_access : <<use>>
p_ui ..> p_service_1 : <<use>>
p_api ..> p_service_1 : <<use>>
p_service_1 ..> p_service_2 : <<use>>
p_domain .[#A32D2D].> p_data_access : <<use>>
p_web_client ..> p_api : <<use>>
legend right
dashed arrow <<use>> = the source needs the target to be correct (V&B uses relation)
<back:#FAC775>highlighted</back> = the part being changed
<color:#A32D2D>red arrow</color> = dependency against the layering
endlegend
@enduml
