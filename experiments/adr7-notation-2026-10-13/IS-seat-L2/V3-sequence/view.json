  "fragments": [
    {
      "id": "scn:book-seat:alt1",
      "kind": "alt",
      "guard": "roomId is not null and >= 1; otherwise IllegalArgumentException (room not found, inactive or closed on date)"
    },
    {
      "id": "scn:book-seat:alt2",
      "kind": "alt",
      "guard": "areaId not null and >= 1; if area is null or not in the room, IllegalArgumentException 'The area is not in the selected room'"
    },
    {
      "id": "scn:book-seat:alt3",
      "kind": "alt",
      "guard": "seatId != 0; if seat is null, IllegalArgumentException 'Invalid seat identifier.'"
    },
    {
      "id": "scn:book-seat:alt4",
      "kind": "alt",
      "guard": "duplicate booking: student already has active or confirmed reservation for date and slot -> IllegalArgumentException"
    },
    {
      "id": "scn:book-seat:alt5",
      "kind": "alt",
      "guard": "no seats available -> IllegalArgumentException 'No seats are available in the selected area'"
    },
    {
      "id": "scn:book-seat:alt6",
      "kind": "alt",
      "guard": "save returns false -> RuntimeException 'Server error: the reservation could not be saved'"
    },
    {
      "id": "scn:book-seat:alt7",
      "kind": "alt",
      "guard": "reservation saved successfully"
    }
