digraph view {
  rankdir=TB; newrank=true; labelloc=t; fontname=Helvetica; fontsize=16; nodesep=0.3; ranksep=0.35;
  label=<<b>Decomposition view — user registration functionality</b>>;
  node [shape=tab, style=filled, fillcolor="#F1EFE8", color="#444441", fontname=Helvetica, fontsize=11];
  edge [color="#444441", style=dashed, fontname=Helvetica, fontsize=10];
  subgraph cluster_system { label=<<b>Progetto-IS-main-English</b>>; style=rounded; color="#444441";
    subgraph cluster_layer0 { label=<<i>«layer»</i> Presentation>; style="dashed"; color="#888780";
      p_web_client [label=<<b>Web client</b><font point-size="10"><br/>app.js</font>>];
      p_ui [label=<<b>Registration desktop app</b><br/><font point-size="9">Swing screens for registration and student and librarian dashboards</font><font point-size="10"><br/>Registration<br/>StudentDashboard<br/>LibrarianDashboard</font>>];
      p_api [label=<<b>Registration REST endpoint</b><br/><font point-size="9">exposes POST /api/auth/register, forwards to facade, maps validation errors to HTTP 400</font><font point-size="10"><br/>AuthenticationController<br/>RestExceptionHandler<br/>StudentController</font>>];
    }
    subgraph cluster_layer1 { label=<<i>«layer»</i> Application>; style="dashed"; color="#888780";
      p_service [label=<<b>Registration validation service</b><br/><font point-size="9">validates registration data and role, checks uniqueness, creates and registers users</font><font point-size="10"><br/>LibraryFacade<br/>UserManager<br/><i>… 5 more</i></font>>];
    }
    subgraph cluster_layer2 { label=<<i>«layer»</i> Domain>; style="dashed"; color="#888780";
      p_domain [label=<<b>User and reservation entities</b><br/><font point-size="9">JPA entities for users, students, librarians and reservations</font><font point-size="10"><br/>Reservation<br/>Student<br/>User<br/><i>… 1 more</i></font>>];
    }
    subgraph cluster_layer3 { label=<<i>«layer»</i> Data access>; style="dashed"; color="#888780";
      p_data_access_1 [label=<<b>User persistence storage</b><br/><font point-size="9">persists entities in JPA transactions, rolling back and returning false on failure</font><font point-size="10"><br/>PersistenceManager<br/>ReservationRegistry</font>>];
      p_data_access_2 [label=<<b>User account lookup storage</b><font point-size="10"><br/>UserRegistry</font>>];
    }
  }
  p_database [shape=cylinder, label=<<b>MySQL database</b><br/>MySQL>];
  p_web_client -> p_service [style=invis];
  p_ui -> p_service [style=invis];
  p_api -> p_service [style=invis];
  p_service -> p_domain [style=invis];
  p_domain -> p_data_access_1 [style=invis];
  { rank=same; p_web_client p_ui p_api }
  { rank=same; p_service }
  { rank=same; p_domain }
  { rank=same; p_data_access_1 p_data_access_2 }
  subgraph cluster_legend { label="Legend"; fontsize=10; style=dashed; color="#B4B2A9";
    lg_layer [shape=plaintext, label="dashed frame = layer", fontsize=9];
    lg_pkg [label="part (UML package) with its main classes", fontsize=9]; }
}
