@startuml
title 0. Architecture: view generation from 42010 inputs (condition F, the current design)
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowFontSize 11

actor "Researcher" as researcher
actor "Rater" as rater

component "Request sheet\n(entity of interest, stakeholder,\nperspective + detail level, concern\n+ details, aspect, viewpoint, model kind)" as sheet
component "Orchestrator\n(run_generate.py)" as orch

package "Before the session (deterministic, no LLM)" as before {
  component "Workspace preparation\n(repository copy without\nUML models, + skills)" as prep
  component "Static graph builder\n(Phase 0 repository card,\ntree-sitter)" as builder
}
component "Subject repository\n(copy)" as repo
component "Repository graph\n(symbols, dependencies with file:line,\nentry points, entities, deployment)" as graph

package "Generator agent: Sonnet 5.5, skills, tools" as genpkg {
  component "Generator session" as gen
  component "uml-view skill\n(levels, budgets, abstraction,\nUML rules, examples)" as skill
  component "Graph query\n(graph_query.py: summary,\nsearch, around, members)" as gq
  component "Inventory checker\n(check_inventory.py: evidence,\ntwo-way, budget, graph)" as chk
  component "plantuml-diagrams skill\n(templates, PlantUML,\npuml-check layout)" as pskill
}

component "Critic agent\n(Opus 5.5, fresh session,\nread-only)" as critic
component "Results\n(view, inventory with members,\nREADME, critiques, keep-best record)" as results
component "Evaluation pages\n(side-by-side, blind rating)" as pages

note bottom of results
  No memory across cases: every case starts
  from a fresh copy and a fresh session.
  Within a case: the generator session is
  resumed once for the revision, and v1/ keeps
  the first version.
end note

researcher --> sheet : writes requests
orch --> sheet : reads inputs
orch --> prep : prepares workspace
prep --> repo : copies
orch --> builder : builds graph
builder --> repo : parses code
builder --> graph : writes
orch --> gen : prompts; resumes once\nwith the critique
gen --> skill : follows
gen --> gq : finds the concern's code
gq --> graph : queries
gen --> repo : reads code and config
gen --> chk : checks inventory
chk ---> graph : checks relations\nand members
gen --> pskill : renders, checks layout
orch --> critic : asks for review
critic --> repo : checks claims
critic --> results : writes critique
gen --> results : writes view
orch --> results : keeps the better version
pages --> results : reads
rater --> pages : rates views blind
@enduml
