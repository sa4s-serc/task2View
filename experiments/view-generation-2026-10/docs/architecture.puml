@startuml
title View generation pipeline (condition F, the current design)
left to right direction
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowFontSize 12
skinparam rectangleRoundCorner 10
skinparam nodesep 40
skinparam ranksep 45
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam card {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}

card "**Request**\n(ISO 42010 inputs)\n\nstakeholder\nperspective + detail level\nconcern + details\naspect, viewpoint\nmodel kind" as req
card "**Repository**" as repo

rectangle "**1. Prepare**\n(no LLM)\n\ncopy the repository,\nremove existing\nUML models,\nadd the skills" as prep
rectangle "**2. Static graph**\n(no LLM, tree-sitter)\n\nclasses and dependencies\nwith file:line,\nentry points, entities,\ndeployment files" as graph
rectangle "**3. Generator agent**\n(Sonnet 5.5, uml-view skill)\n\na. find the concern's code\n    (graph search + reading code)\nb. group code into elements\n    at the given detail level\nc. inventory: elements, relations,\n    evidence, members\nd. draw PlantUML" as gen
rectangle "**4. Checks**\n(scripts, no LLM)\n\nevidence lines exist\ndiagram = inventory\nelement budget for the level\narrows backed by the graph\nlayout (overlaps, crossings)" as chk
rectangle "**5. Critic agent**\n(Opus 5.5, fresh session)\n\nconcern details answered?\nright detail level?\nsupported by the code?\ncorrect UML?" as critic
rectangle "**6. Keep the better version**\n(critic score)" as keep
card "**View**\n\nview.png / view.puml\ninventory.json\nREADME.md" as out

req --> prep
repo --> prep
prep --> graph
graph --> gen
gen --> chk
chk --> gen : fix issues\n(repeat)
chk --> critic
critic --> gen : critique\n(one revision)
critic --> keep : accept, or\nafter the revision
keep --> out
@enduml
