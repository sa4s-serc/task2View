@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title er example
hide circle
skinparam classAttributeIconSize 0
' Columns: * = NOT NULL, no marker = nullable; tag keys <<PK>>, <<FK>>, <<UQ>> (one tag per column).
' Crow's feet: ||--o{ one to zero-or-many, ||--|{ one to one-or-many, ||--o| one to zero-or-one,
' |o--o{ zero-or-one to many (a nullable FK). One dash (||-o{) = same rank, two (||--o{) = next rank:
' build rows. Two FKs to the same table: label both edges (users ||--o{ refunds : requested_by).
' Edges are polyline (house style); switch to linetype ortho only when no edge carries a label.

entity "customer" as customer {
  * id : uuid <<PK>>
  --
  * email : text
    name : text
}
entity "order" as order {
  * id : uuid <<PK>>
  --
  * customer_id : uuid <<FK>>
  * status : text
  * created_at : timestamptz
}
entity "order_line" as line {
  * id : uuid <<PK>>
  --
  * order_id : uuid <<FK>>
  * sku : text
  * quantity : int
}
entity "payment" as payment {
  * id : uuid <<PK>>
  --
  * order_id : uuid <<FK>>
  * amount_cents : int
}

customer ||--o{ order
order    ||--|{ line
order    ||--o| payment
@enduml
