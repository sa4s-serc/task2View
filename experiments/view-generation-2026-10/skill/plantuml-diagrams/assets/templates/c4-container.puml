@startuml
!include <C4/C4_Container>
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
LAYOUT_LEFT_RIGHT()

' ---- body ----
title c4-container example
' C4-PlantUML from the bundled stdlib (offline). Layout helpers: LAYOUT_TOP_DOWN(), LAYOUT_LEFT_RIGHT(),
' LAYOUT_LANDSCAPE(), Lay_D/U/L/R(a, b). SHOW_LEGEND() must be the last line.

Person(customer, "Customer", "Buys products")

System_Boundary(shop, "Shop") {
  Container(web, "Web App", "SPA framework", "Storefront UI")
  Container(api, "API", "REST, serverless", "Orders, inventory, payments")
  ContainerDb(db, "Database", "managed SQL", "Orders and customers")
  ContainerQueue(bus, "Event Bus", "managed queue", "Domain events")
}
System_Ext(payments, "Payment provider", "Card payments")

Rel(customer, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads/writes", "SQL")
Rel(api, bus, "Publishes", "events")
Rel(api, payments, "Charges", "REST")

SHOW_LEGEND()
@enduml
