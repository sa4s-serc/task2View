@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
classDiagram {
  class { BackgroundColor #F8FAFC }
}
</style>
hide stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title class example
hide empty members
skinparam classAttributeIconSize 0
skinparam groupInheritance 2

' Keep members to what the reader needs (3-6 per class). Use notes for detail.
' Multiplicities sit at their own end: A "1" --> "0..*" B puts 0..* at B. Build rows for wide models:
' A -> B same rank, A --> B next row; flip the arrowhead (A <-- B), not the operands, to keep rows.
' Enums: show them as attribute types; draw an enum box only when the diagram is about it.
class Customer {
  +id: UUID
  +email: String
  +placeOrder(cart): Order
}
class Order {
  +id: UUID
  +status: OrderStatus
  +total(): Money
}
class OrderLine {
  +sku: String
  +quantity: int
}
enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
interface PaymentGateway {
  +authorize(amount): Auth
}
class CardGateway

Customer "1" --> "0..*" Order : places
Order    "1" *--  "1..*" OrderLine
Order    -->  OrderStatus
Order    ..>  PaymentGateway
PaymentGateway <|.. CardGateway
@enduml
