@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide stereotype

' ---- body ----
title sequence example
hide footbox
autonumber "<b>00"

' Declare every participant up front, in reading order, with a short alias.
actor       "Customer"        as cust
participant "Web App"         as web
participant "Order Service"   as orders
participant "Payment Gateway" as pay
database    "Orders DB"       as db

cust  -> web    : place order
web   -> orders ++ : POST /orders
orders -> db    : insert PENDING
orders -> pay   ++ : authorize(amount)
alt authorized
  pay --> orders -- : AUTH_OK
  orders -> db  : status = CONFIRMED
else declined
  pay --> orders : DECLINED
  orders -> db  : status = DECLINED
end
orders --> web  -- : 201 {orderId, status}
web   --> cust  : confirmation page
@enduml
