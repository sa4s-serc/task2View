#!/usr/bin/env python3
"""puml-new: scaffold a PlantUML file from a tested template with the house style inlined.

Usage:
  puml-new TYPE [OUT.puml] [--preset slide|print] [--direction lr|tb] [--title "Text"] [--no-style] [--force]

TYPE: sequence | activity | component | deployment | class | state | usecase | er | network | dfd |
      c4-context | c4-container | c4-component
      (or 'list' to print the types, 'style' to print just the style block)

--preset slide (default): 14 px text; print: 12 px text. (PNG dpi is set at export time by puml-render,
  never inside the file: skinparam dpi also scales the SVG and breaks size checks.)
--no-style: omit the inline style (use when the project has lib/house.puml and you !include it).
Writes to OUT.puml (or stdout if omitted). Never overwrites an existing file unless --force.
"""
import argparse, os, sys

# --------------------------------------------------------------------------- house style
# Verified on PlantUML 1.2026.8. Appearance lives in <style>; the skinparams below are layout
# knobs that have NO <style> equivalent (linetype, nodesep, ranksep) or are kept for
# older renderers (maxMessageSize/wrapWidth; the <style> MaximumWidth is the modern form).
# Never add: skinparam padding / ParticipantPadding / handwritten (they paint a warning banner
# into the image on 1.2026.x), linetype ortho (labels overlap), SameClassWidth.
# Never set LineColor/LineThickness on root or title: `title { LineThickness 0 }` and `LineColor transparent`
# strip the stroke from EVERY element in description diagrams (SVG renders borderless). Line properties
# live on element/arrow/note/legend only, which also leaves the title without a border.
STYLE = """\
' ---- house style ({preset}) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize {wrap}
skinparam wrapWidth {wrap}
<style>
root {{
  FontName Helvetica
  FontSize {fs}
  FontColor #1F2937
}}
element {{ BackgroundColor #F1F5F9; LineColor #475569; LineThickness {lt}; RoundCorner 6 }}
arrow   {{ LineColor #475569; LineThickness {lt}; FontSize {fs_small}; MaximumWidth {wrap} }}
note    {{ BackgroundColor #FFF7E0; LineColor #B45309; FontSize {fs_small}; MaximumWidth {wrap_note} }}
title   {{ FontSize {fs_title}; FontStyle bold }}
caption {{ FontSize {fs_small}; FontColor #64748B }}
legend  {{ FontSize {fs_small}; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }}
.accent {{ BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }}
.alert  {{ BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }}
.muted  {{ BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }}
{extra}</style>
hide stereotype
"""

PRESETS = {
    "slide": dict(preset="slide", dpi=192, fs=14, fs_small=12, fs_title=18, lt="1.2", wrap=180, wrap_note=220),
    "print": dict(preset="print", dpi=300, fs=12, fs_small=11, fs_title=15, lt="1", wrap=160, wrap_note=200),
}

# Graphviz-backed diagram types get spacing + routing knobs (dot only; ignored by smetana/elk).
GRAPHVIZ_EXTRA = """\
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
"""

TEMPLATES = {
"sequence": dict(style_extra="""sequenceDiagram {{
  participant {{ Margin 0 12 }}
  lifeLine    {{ LineColor #94A3B8 }}
  group       {{ FontSize {fs_small} }}
}}
""", body="""\
title {title}
hide footbox
autonumber "<b>00"

' Declare every participant up front, in reading order, with a short alias.
actor       "Customer"        as cust
participant "Web App"         as web
participant "Order Service"   as orders
participant "Payment Gateway" as pay
database    "Orders DB"       as db

cust  -> web    : place order
web   -> orders ++ : POST /orders
orders -> db    : insert PENDING
orders -> pay   ++ : authorize(amount)
alt authorized
  pay --> orders -- : AUTH_OK
  orders -> db  : status = CONFIRMED
else declined
  pay --> orders : DECLINED
  orders -> db  : status = DECLINED
end
orders --> web  -- : 201 {{orderId, status}}
web   --> cust  : confirmation page
"""),

