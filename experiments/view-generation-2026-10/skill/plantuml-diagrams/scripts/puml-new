def build(kind, title, preset, with_style=True, direction=None):
    t = TEMPLATES[kind]
    p = dict(PRESETS[preset])
    out = ["@startuml"]
    if t.get("c4"):
        out.append(f"!include <C4/{t['c4']}>")
    if with_style:
        extra = t["style_extra"].format(**p)
        out.append(STYLE.format(extra=extra, **p).rstrip())
        if t.get("graphviz"):
            out.append(GRAPHVIZ_EXTRA.rstrip())
    if t.get("graphviz"):
        d = direction or t.get("direction") or ("lr" if preset == "slide" else "tb")
        if t.get("c4"):
            out.append("LAYOUT_LEFT_RIGHT()" if d == "lr" else "LAYOUT_TOP_DOWN()")
        else:
            out.append("left to right direction" if d == "lr" else "top to bottom direction")
    out.append("")
    out.append("' ---- body ----")
    body = t["body"].format(title=title).rstrip().replace("LAYOUT_TOP_DOWN()\n", "")
    out.append(body)
    out.append("@enduml")
    return "\n".join(out) + "\n"

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("kind"); ap.add_argument("out", nargs="?")
    ap.add_argument("--preset", choices=list(PRESETS), default="slide")
    ap.add_argument("--title", default="Diagram title")
    ap.add_argument("--no-style", action="store_true"); ap.add_argument("--force", action="store_true")
    ap.add_argument("--direction", choices=["lr", "tb"], help="Graphviz diagrams: left-to-right (slides default) or top-to-bottom (print default)")
    a = ap.parse_args()
    if a.kind == "list":
        print("\n".join(TEMPLATES)); return
    if a.kind == "style":
        p = PRESETS[a.preset]
        hdr = ("' house.puml: the plantuml-diagrams skill's house style as an include file.\n"
               "' Copy to <project>/docs/diagrams/lib/house.puml and write  !include lib/house.puml  (relative to the diagram).\n"
               "' Prefer the inline form from puml-new when the diagram must render on Kroki / VS Code server / MCP.\n"
               "' NOTE: an included file must never contain the text @start""uml, even in a comment, or the include fails.\n"
               "' Regenerate: scripts/puml-new style > assets/lib/house.puml\n")
        print(hdr + STYLE.format(extra="", **p) + GRAPHVIZ_EXTRA); return
    if a.kind not in TEMPLATES:
        sys.exit(f"unknown type {a.kind!r}; one of: {', '.join(TEMPLATES)}")
    text = build(a.kind, a.title, a.preset, not a.no_style, a.direction)
    if a.out:
        if os.path.exists(a.out) and not a.force:
            sys.exit(f"{a.out} exists (use --force to overwrite)")
        os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
        open(a.out, "w").write(text); print(a.out)
    else:
        sys.stdout.write(text)

if __name__ == "__main__":
    main()
