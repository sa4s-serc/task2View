@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title UML component diagram: visit scheduling in Owners & Pets

actor "Clinic user (browser)" as user

component "Owners & Pets" as owners {
  interface "GET/POST\n/owners/{ownerId}/pets/{petId}/visits/new" as visitsApi
  component "VisitController\n(Spring MVC)" as visitCtl
  component "Visit form view\n(Thymeleaf)" as visitForm
  component "Owner aggregate\n(Owner > Pet > Visit, JPA)" as ownerAgg
  component "OwnerRepository\n(Spring Data JPA)" as ownerRepo
}
component "Clinic database\n(visits table)" as db

user      --> visitsApi : HTTP form post
visitsApi  -- visitCtl
visitCtl  --> visitForm : renders, shows errors
visitCtl  --> ownerAgg  : addVisit(petId, visit)
visitCtl  --> ownerRepo : findById, save(owner)
ownerRepo --> db        : INSERT visit (cascade)

note top of visitCtl
  Scheduling rules (VisitController):
  minVisitDate = today + 1
  date must be after today
end note
note right of ownerAgg
  Visit: date defaults to tomorrow;
  description required, max 255
end note
@enduml
