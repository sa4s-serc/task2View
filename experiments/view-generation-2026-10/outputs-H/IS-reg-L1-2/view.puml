@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration
hide footbox

actor       "Student or librarian"      as user
participant "Registration form\n(Swing)" as form
participant "Library facade"            as facade
participant "User manager"              as manager
participant "User registry"             as registry
participant "User factories"            as factories
participant "Persistence manager"       as persistence
database    "MySQL database"            as db

user -> form ++ : fill in and submit
break empty field
  form --> user : "Complete all fields"\n(no facade call)
end
form -> facade ++ : register(role, name, surname,\nemail, password, id)
facade -> manager ++ : register(...)
manager -> manager : validate fields for role
break fields invalid
  manager --> facade : IllegalArgumentException
  facade --> form : exception
  form --> user : show error
end
manager -> registry ++ : email already used?
registry -> persistence ++ : find user by email
persistence -> db : query
db --> persistence : row or none
persistence --> registry -- : user or none
registry --> manager -- : yes or no
break email in use
  manager --> facade : IllegalArgumentException
  facade --> form : exception
  form --> user : show error
end
manager -> registry ++ : identifier already used?\n(student number or librarian code)
registry -> persistence ++ : find by identifier
persistence -> db : query
db --> persistence : row or none
persistence --> registry -- : account or none
registry --> manager -- : yes or no
break id in use
  manager --> facade : IllegalArgumentException
  facade --> form : exception
  form --> user : show error
end
manager -> factories ** : create (Student or\nLibrarian factory by role)
factories --> manager : new user
manager -> registry ++ : register user
registry -> persistence ++ : save
persistence -> db : insert
db --> persistence : ok or failure
persistence --> registry -- : true, or false\nafter rollback
registry --> manager -- : success flag
break save failed
  manager --> facade : RuntimeException "Server error"
  facade --> form : exception
  form --> user : show error
end
manager --> facade -- : user data
facade --> form -- : user data
form --> user -- : show success, open login

note over form, facade
  The REST endpoint POST /api/auth/register
  (Authentication REST API) calls the facade
  with the same arguments. Its exception handler
  turns IllegalArgumentException into HTTP 400
  with an error body; the save-failure
  RuntimeException is not handled there.
end note
@enduml
