@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

' ---- body ----
title UML sequence diagram: new user registration (student or librarian)
hide footbox
autonumber "<b>00"

participant "Authentication\nREST API" as rest
participant "Registration form\n(desktop)" as form
participant "Library facade" as facade
participant "User manager" as um
participant "User registry" as reg
participant "Persistence\nmanager" as pm
participant "Account database\n(MySQL)" as db

alt desktop entry
  [-> form : submit\nsix fields
  form -> form : reject blank fields
  form -> facade : register(...)
else REST entry
  [-> rest : POST /api/auth/register
  rest -> facade : register(...)
end
facade -> um : register(...)
um -> um : validate role, name,\npassword, other fields
alt invalid input
  um --> facade : IllegalArgumentException
else valid
  loop 2 lookups
    um -> reg : look up email,\nthen identifier by role
    reg -> pm : findFirstByFields
    pm -> db : SELECT user
    pm --> reg : match or none
    reg --> um : match or none
  end
  alt in use
    um --> facade : IllegalArgumentException
  else free
    um -> um : create Student or Librarian
    um -> reg : registerUser(newUser)
    reg -> pm : save(user)
    pm -> db : INSERT (JPA transaction)
    pm --> reg : true, or false after rollback
    reg --> um : saved or not
    alt save failed
      um --> facade : RuntimeException
    else saved
      um --> facade : UserDTO
    end
  end
end
alt desktop
  facade --> form : result
  form -> form : show error dialog,\nor confirmation and login
else REST
  facade --> rest : result
  rest -->] : 200, 400 or 500
end
note over rest, facade
  Result: UserDTO (200), IllegalArgumentException for
  invalid or duplicate input (400 {error}), RuntimeException
  for save failure (not handled, so 500)
end note
@enduml
