@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

' ---- body ----
title cmp User registration, components and dependencies

actor "Student or librarian" as user

package "Presentation" {
  [Registration form] as form
  [Registration API] as api
}
package "Application" {
  [Library facade] as facade
  [User manager] as um
  [User factories] as fac
}
package "Domain" {
  [User registry] as reg
  [User accounts] as acc
}
package "Persistence" {
  [Persistence manager] as pm
}
database "Reservations database" as db <<muted>>

user --> form : fills in
user --> api : POST /api/auth/register
form --> facade : submit registration
api --> facade : submit registration
facade --> um : delegate register
um --> fac : create by role
um --> reg : check duplicates
um --> reg : save new user
fac --> acc : builds users
reg --> pm : find and save
reg ..> acc : stores
pm --> db : JPA / MySQL

note right of um
  Rejects invalid role, names,
  email, password and identifier
  format; rejects duplicate email
  or identifier. Errors go back
  to the caller as exceptions.
end note
legend bottom
  Muted box = external system.
endlegend
@enduml
