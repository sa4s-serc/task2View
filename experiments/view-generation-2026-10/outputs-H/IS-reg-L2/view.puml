@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 130
skinparam ranksep 60
top to bottom direction

' ---- body ----
title Component view: user registration (student and librarian)

actor "New user (student or librarian)" as user
actor "HTTP client" as client

package "Presentation" as pres {
  component "Registration form (desktop)\nRejects blank fields, shows errors" as form
  component "Authentication REST API\nMaps validation errors to HTTP 400" as rest
}
package "Application" as app {
  component "Library facade\nForwards register to the manager" as facade
  component "User manager\nValidates role, name, password, unina.it email,\nID format; rejects duplicate email or ID;\nbuilds Student or Librarian; fails if save fails" as um
}
package "Domain and persistence" as dom {
  component "User registry\nLooks up users by email,\nstudent number, librarian code" as reg
  component "Persistence manager\nSaves in a JPA transaction,\nreturns false on rollback" as pm
}
component "Account database (MySQL)" as db <<muted>>

interface "Sign-up screen" as screen
interface "POST /api/auth/register" as http
interface "Library facade API\nregister(role, name, surname,\nemail, password, identifier) : UserDTO" as facadeApi
interface "User manager API\nregister(...) : UserDTO" as regOp
interface "User registry API\ninstitutionalEmailExists, findStudentByStudentNumber,\nfindLibrarianByCode, registerUser" as regApi
interface "Persistence API\nsave, findFirstByFields" as pmApi
interface "JDBC (MySQL)" as jdbc

form - screen
rest - http
facade - facadeApi
um - regOp
reg - regApi
pm - pmApi
db - jdbc

user ..> screen : <<use>>
client ..> http : <<use>>
form ..> facadeApi : <<use>>
rest ..> facadeApi : <<use>>
facade ..> regOp : <<use>>
um ..> regApi : <<use>>
reg ..> pmApi : <<use>>
pm ..> jdbc : <<use>>

note as errors
  Paths worth testing:
  - invalid input: IllegalArgumentException
    (REST: HTTP 400 with error message)
  - duplicate email, student number or librarian code
  - save failure: save returns false, manager
    throws RuntimeException (not mapped to 400)
end note
errors .. pm

legend bottom
  Lollipop = provided interface; dashed arrow = required interface (use).
  Grey = external system. Operation names are listed on each interface.
endlegend
@enduml
