@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 40

title Seat booking: UML package diagram of modules and dependencies

package "Presentation" as presentation {
  package "Swing Desktop Client" as swing {
  }
  package "REST API" as rest {
  }
  package "Notification Scheduler" as sched {
  }
  package "Email Notification Adapter" as adapter {
  }
  package "External email gateway (stub)" as gateway <<muted>> {
  }
}
package "Application" as application {
  package "Library Facade" as facade {
  }
  package "Reservation Manager\napplies booking rules" as resman <<accent>> {
  }
  package "Seat Assignment Strategy" as strategy <<accent>> {
  }
  package "Study Room Manager" as roomman <<alert>> {
  }
  package "Notification Manager" as notifman <<alert>> {
  }
  package "NotificationService\n(interface)" as notifsvc {
  }
}
package "Domain and registries" as domainlayer {
  package "Reservation Domain Model\nseat availability, states" as domain <<accent>> {
  }
  package "Reservation Registry" as resreg <<accent>> {
  }
  package "Study Room Registry" as roomreg {
  }
  package "User Registry" as userreg <<alert>> {
  }
}
package "Persistence" as persistence {
  package "Persistence Manager" as pm {
  }
}

swing --> facade : calls operations
rest --> facade : calls operations
sched --> facade : triggers expiry
facade ..> resman : delegates booking
facade ..> roomman : browsing
facade ..> notifman : delegates
resman ..> strategy : selects seat
resman ...> domain : checks seats
resman ....> resreg : saves bookings
resman ..> roomreg : looks up rooms
resman ...> userreg : loads student
resman ..> notifman : notifies
roomman ..> domain : counts free seats
roomman ...> resreg : derives occupancy
roomman ..> roomreg : reads rooms
domain ...> resreg : queries bookings
domain ..> roomreg : lists area seats
notifman ..> domain : observes reservations
notifman ..> notifsvc : depends on
adapter ..> notifsvc : realizes
adapter ..> gateway : sends email
resreg ...> pm : opens sessions
roomreg ...> pm : opens sessions
userreg ...> pm : opens sessions



swing -[hidden]right-> rest
sched -[hidden]down-> adapter
swing -[hidden]down-> gateway
roomman -[hidden]down-> notifman
strategy -[hidden]down-> notifsvc

legend right
  Blue: likely changed for new booking rules
  Red: may be affected, keep consistent
  Grey: external stub, outside the application
  Dashed arrows: package dependency
endlegend
@enduml
