@startuml
title User Registration - Control Flow and Collaboration (UML Sequence Diagram)
skinparam shadowing false
skinparam sequenceMessageAlign left

actor "Registering user\n(Student / Librarian)" as U
participant "Registration UI\n(Swing Registration form /\nweb registration.html + app.js)" as UI <<boundary>>
participant "AuthenticationController\n(POST /api/auth/register)" as AC <<boundary, Spring REST>>
participant "RestExceptionHandler" as REH <<boundary>>
participant "LibraryFacade" as LF <<controller, singleton>>
participant "UserManager" as UM <<controller, singleton>>
participant "StudentFactory /\nLibrarianFactory\n(UserFactory)" as UF <<factory>>
participant "UserRegistry" as UR <<entity, singleton>>
participant "PersistenceManager" as PM <<database, JPA>>
database "Database\n(User / Student / Librarian tables)" as DB

U -> UI : fill form (role, name, surname,\nemail, password, identifier)
alt Swing client: any field blank
  UI --> U : "Complete all fields" (no backend call)
else web client or all fields filled
  alt Web client
    UI -> AC : POST /api/auth/register\n(role, name, surname, email, password, identifier)
    AC -> LF : register(role, name, surname,\nemail, password, identifier)
  else Swing client (in-process call)
    UI -> LF : register(role, name, surname,\nemail, password, identifier)
  end
  LF -> UM : register(...)

  == 1. Validation of personal data and role ==
  UM -> UM : validate(role, name, password)\n[role in {Student, Librarian}; name present;\npassword 8..32 chars]
  alt Student role
    UM -> UM : validateStudent(name, surname, email, studentNumber)\n[name/surname letters only <=20; email <255 and @unina.it;\nstudent ID = uppercase letter + 8 digits]
  else Librarian role
    UM -> UM : validateLibrarian(name, surname, email, code)\n[name/surname/email rules; code alphanumeric, non-empty]
  end

  alt Validation fails (invalid role, name, surname, email, password or identifier format)
    UM --> LF : throw IllegalArgumentException(message)
    LF --> AC : exception propagates
    AC --> REH : exception
    REH --> UI : HTTP 400 {"error": message}
    UI --> U : show error (Swing: error dialog on RuntimeException)
  else Validation passes

    == 2. Uniqueness check of the account ==
    UM -> UR : institutionalEmailExists(email)
    UR -> PM : findFirstByFields(User.class, {institutionalEmail})
    PM -> DB : query
    DB --> PM : result
    PM --> UR : User or null
    UR --> UM : boolean
    alt Email already registered
      UM --> LF : throw IllegalArgumentException("Email is already associated with an account.")
      LF --> AC : exception propagates
      AC --> REH : exception
      REH --> UI : HTTP 400 {"error": ...}
      UI --> U : show error
    else Email free
      alt Student role
        UM -> UR : findStudentByStudentNumber(identifier)
        UR -> PM : findFirstByFields(Student.class, {studentNumber})
      else Librarian role
        UM -> UR : findLibrarianByCode(identifier)
        UR -> PM : findFirstByFields(Librarian.class, {internalIdentifierCode})
      end
      PM -> DB : query
      DB --> PM : result
      PM --> UR : entity or null
      UR --> UM : entity or null
      alt Identifier already in use
        UM --> LF : throw IllegalArgumentException("Identifier is already in use.")
        LF --> AC : exception propagates
        AC --> REH : exception
        REH --> UI : HTTP 400 {"error": ...}
        UI --> U : show error
      else Identifier free

        == 3. Role-specific creation and persistence ==
        UM -> UF : createUser(name, surname, email, password, identifier)\n[StudentFactory sets studentNumber;\nLibrarianFactory sets internalIdentifierCode]
        UF --> UM : new Student / Librarian
        UM -> UR : registerUser(newUser)
        UR -> PM : save(newUser)
        PM -> DB : persist in transaction
        alt Persist succeeds (commit)
          DB --> PM : ok
          PM --> UR : true
          UR --> UM : true
          UM -> UM : toDTO(newUser) [role + identifier]
          UM --> LF : UserDTO
          LF --> AC : UserDTO
          AC --> UI : HTTP 200 UserDTO
          UI --> U : "Registration complete" -> open Login
        else Persist fails (rollback, e.g. DB unique constraint)
          DB --> PM : error
          PM --> UR : false
          UR --> UM : false
          UM --> LF : throw RuntimeException("Server error: the user could not be saved...")
          LF --> AC : exception propagates
          note right of AC : RuntimeException is not mapped by\nRestExceptionHandler (only IllegalArgument/\nIllegalState/Security) -> default server error
          AC --> UI : HTTP 500 (default)
          UI --> U : show error
        end
      end
    end
  end
end
@enduml
