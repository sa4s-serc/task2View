@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 240 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

title UML component diagram: seat booking (make reservation) control flow

actor "Student" as student
actor "Librarian" as librarian

component "Web client\n(static HTML + app.js)" as web
component "Desktop client\n(Swing)" as swing
component "REST controllers\n(Spring MVC)" as rest
component "LibraryFacade" as facade
component "ReservationManager" as resmgr <<accent>>
component "StudyRoomManager" as roommgr
component "AssignmentStrategy\n(FirstAvailableAssignment)" as strategy
component "Domain entities\n(Reservation, Seat, Area, ...)" as entities
component "Registries\n(Reservation, StudyRoom, User)" as registries
component "NotificationManager" as notifmgr
component "Email adapter\n(NotificationServiceAdapter)" as adapter
component "MySQL database\n(JPA / Hibernate)" as db <<muted>>

student   --> web   : books seat
student   --> swing : books seat
librarian --> web   : creates rooms
web       --> rest  : HTTP /api
swing     --> facade : calls
rest      --> facade : calls
facade    --> resmgr  : makeReservation
facade    --> roommgr : list rooms, slots, seats
resmgr    --> registries : resolve, save
resmgr    --> entities   : check availability
resmgr    --> strategy   : pick seat
resmgr    --> notifmgr   : attach, notify
roommgr   --> registries : read rooms
notifmgr  --> adapter    : send email
registries --> db        : persists

note right of facade
  makeReservation: validate student, room,
  area, slot; then synchronized block:
  uniqueness check, seat selection,
  save, notify. seatId 0 = automatic seat.
end note

legend right
  Blue: the component to modify.
  Grey: external persistence.
end legend
@enduml
