@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

participant "Registration page\n(registration.html)" as page
participant "AuthenticationController\n(Spring REST)" as ctl
participant "LibraryFacade" as facade
participant "UserManager" as mgr
participant "UserRegistry\n(+ PersistenceManager, JPA)" as reg
participant "MySQL\nreservationsdb" as db

page -> ctl ++ : POST /api/auth/register\n(role, name, surname, email,\npassword, identifier)
ctl -> facade ++ : register(...)
facade -> mgr ++ : register(...)
mgr -> mgr : validate role, names, password,\nunina.it email, identifier format
mgr -> reg ++ : check email and identifier\nare unused (2 lookups)
reg -> db : SELECT user by email,\nthen by studentNumber / code
deactivate reg
alt all checks pass
  mgr -> mgr : create Student or Librarian\n(StudentFactory / LibrarianFactory)
  mgr -> reg ++ : registerUser(newUser)
  reg -> db : INSERT (persist + commit)
  deactivate reg
  mgr --> facade -- : UserDTO
  facade --> ctl -- : UserDTO
  ctl --> page -- : 200 UserDTO
else invalid / duplicate
  mgr --> facade : IllegalArgumentException
  facade --> ctl : (propagated)
  ctl --> page : 400 {"error": message}
end

note over page
  Swing form (Registration.java) calls
  LibraryFacade.register directly, no REST
end note
@enduml
