@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title UML use case diagram: municipal problem reporting application

actor "Visitor" as visitor
actor "Citizen" as citizen
actor "Municipal operator" as operator

rectangle "Municipal problem reporting application" as sys {
  usecase "Register and log in" as ucAccess
  usecase "Report a problem" as ucCreate
  usecase "Review my submitted reports" as ucSubmitted
  usecase "Review received reports" as ucReceived
  usecase "View report details\nand status history" as ucDetails
  usecase "Update report status\nand notify citizen" as ucStatus
  usecase "Add internal note" as ucNote
  usecase "Monitor activity trends" as ucMonitor
}

visitor -- ucAccess
citizen -- ucCreate
citizen -- ucSubmitted
operator -- ucReceived
operator -- ucStatus
operator -- ucNote
operator -- ucMonitor

ucSubmitted ..> ucDetails : <<include>>
ucReceived ..> ucDetails : <<include>>
ucStatus ..> ucReceived : <<extend>>
ucNote ..> ucReceived : <<extend>>

note bottom of visitor
  Role (Citizen or Municipal
  operator) is chosen at
  registration; the dashboard
  offers only that role's functions.
end note
@enduml
