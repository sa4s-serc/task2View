@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60

title UML component diagram: seat booking (make reservation)

component "Web pages\n(static HTML/JS)" as web
component "Swing desktop UI" as swing
component "REST controllers\n(Spring MVC)" as rest
component "LibraryFacade" as facade
component "ReservationManager\n(booking rules)" as resmgr <<accent>>
component "AssignmentStrategy\n(seat auto-assignment)" as strat <<accent>>
component "StudyRoomManager\n(rooms, slots, seat map)" as roommgr
component "Reservation domain model\n(Reservation + states, Seat, Area,\nStudyRoom, TimeSlot, Student)" as domain <<accent>>
component "NotificationManager" as notif
component "NotificationServiceAdapter\n(email gateway)" as adapter <<muted>>
component "NotificationScheduler" as sched <<muted>>
component "Registries\n(Reservation, StudyRoom, User)" as reg
component "PersistenceManager\n(JPA)" as pers
component "MySQL reservationsdb" as db <<muted>>

web --> rest : HTTP /api/reservations
swing --> facade : makeReservation
rest --> facade : makeReservation
facade --> resmgr : delegates booking
facade --> roommgr : delegates room queries
resmgr -right-> strat : selects seat
resmgr --> domain : creates reservation
resmgr --> reg : finds, saves
resmgr --> notif : notifies student
roommgr --> domain : counts free seats
roommgr --> reg : finds rooms
domain --> reg : checks seat occupancy
reg --> pers : reads, writes
pers -right-> db : JDBC
notif --> adapter : sends email
sched --> facade : ends, reminds

note left of resmgr
  Existing rules live here:
  room active/open, slot not past,
  one booking per student and slot,
  seat still free
end note

legend right
  Blue = most likely edit points for new rules
  Grey = peripheral, probably unaffected
end legend
@enduml
