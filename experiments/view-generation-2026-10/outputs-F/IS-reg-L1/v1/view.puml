@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide footbox
autonumber "<b>00"
title UML sequence diagram: user registration (student or librarian)

actor       "Student /\nLibrarian"                 as user
participant "Registration form\n(Swing)"          as form
participant "LibraryFacade"                       as facade
participant "UserManager"                         as um
participant "UserRegistry /\nPersistenceManager"  as reg
participant "MySQL database"                      as db

user -> form ++ : submit role, name, surname,\nemail, password, identifier
form -> facade ++ : register(...)
facade -> um ++ : register(...)
um -> reg ++ : validate, find by email\nand identifier
reg -> db : SELECT
alt valid and unique
  um -> reg : create user (factory), save
  reg -> db : INSERT
  um --> facade : UserDTO
  facade --> form : UserDTO
  form --> user : "Registration complete",\nopen Login
else failure
  um --> facade : exception
  facade --> form : exception
  form --> user : error dialog with message
end
note over form
  The REST entry point AuthenticationController
  (POST /api/auth/register) calls the same
  LibraryFacade.register and returns the UserDTO.
end note
@enduml
