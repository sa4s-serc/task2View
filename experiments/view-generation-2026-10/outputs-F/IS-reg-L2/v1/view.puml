@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: new user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

participant "Client\n(REST or Swing form)" as client
participant "Authentication\nController" as ctl
participant "Library\nFacade" as facade
participant "User\nManager" as um
participant "User\nRegistry" as reg
participant "Persistence\nManager" as pm
participant "MySQL\nreservationsdb" as db

client -> ctl ++ : POST /api/auth/register\n(role, name, surname, email,\npassword, identifier)
ctl -> facade ++ : register(...)
facade -> um ++ : register(...)
um -> um : validate role, fields,\nunina.it email, ID format
um -> reg ++ : institutionalEmailExists,\nfind by student no. / code
reg -> pm ++ : findFirstByFields
pm -> db : SELECT
db --> pm
pm --> reg -- : match or null
reg --> um -- : duplicate?
alt valid and not duplicate
  um -> um : create Student or Librarian\n(UserFactory)
  um -> reg ++ : registerUser(newUser)
  reg -> pm ++ : save
  pm -> db : INSERT (transaction)
  pm --> reg -- : true
  reg --> um -- : true
  um --> facade -- : UserDTO
  facade --> ctl -- : UserDTO
  ctl --> client -- : UserDTO (role, id, email)
else validation or duplicate failure
  um --> facade -- : IllegalArgumentException\n(nothing saved)
  facade --> ctl -- : exception
  ctl --> client -- : error response
end
note over client, facade
  Swing path: Registration.register() calls
  LibraryFacade.register directly and shows
  the exception message in a dialog.
end note
@enduml
