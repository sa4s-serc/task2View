@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60

title UML component diagram: seat booking (makeReservation) in the study-room reservation app

component "Swing booking wizard\n(student UI)" as swing
component "REST controllers\n(Spring MVC, /api)" as rest
component "LibraryFacade\n(single entry point)" as facade
component "ReservationManager\n(booking rules)" as resMgr <<accent>>
component "AssignmentStrategy\n(seat auto-assignment)" as strategy <<accent>>
component "StudyRoomManager\n(room, slot, seat queries)" as roomMgr
component "Reservation model\n(Reservation, Student, states)" as resModel <<alert>>
component "Study-room model\n(StudyRoom, Area, Seat, TimeSlot)" as roomModel <<alert>>
component "Registries\n(Reservation, StudyRoom, User)" as regs
component "NotificationManager\n(Observer)" as notif
component "PersistenceManager\n(JPA / Hibernate)" as persist
component "MySQL database\n(reservationsdb)" as db

swing    --> facade   : calls
rest     --> facade   : calls
facade   --> resMgr   : makeReservation
facade   --> roomMgr  : queries availability
resMgr   --> strategy : selectSeat
resMgr   --> roomModel : checks room, area, seat
resMgr   --> resModel : creates booking
resMgr   --> regs     : finds, saves
resMgr   --> notif    : notifies
roomMgr  --> regs     : finds rooms
roomModel --> regs    : queries bookings
resModel --> notif    : notifies observers
notif    --> regs     : reads reservations
regs     --> persist  : delegates
persist  --> db       : JDBC

note bottom of resMgr
  Rules today: room active and open,
  slot not started, one booking per
  student and slot, seat free
end note
legend right
  Blue: first place to add booking rules
  Red: also affected (rule data and state)
end legend
@enduml
