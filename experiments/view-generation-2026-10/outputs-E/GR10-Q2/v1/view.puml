@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

title UML deployment diagram: Municipal Report Management System (desktop client + MySQL)

node "Build machine" as build <<device>> {
  node "Maven 3 + JDK 23" as mvn <<executionEnvironment>>
}
node "Maven Central\nrepo.maven.apache.org" as central <<device>> <<muted>>

node "User workstation" as ws <<device>> {
  node "JVM (Java 23)\nSwing desktop client" as jvm <<executionEnvironment>> {
    artifact "municipal-report-management\n-1.0-SNAPSHOT (Java classes)" as app
    artifact "META-INF/persistence.xml\n(unit Municipal_Report_Management_System)" as pxml
    artifact "hibernate-core 6.6.50.Final\n(JPA provider)" as hib
    artifact "mysql-connector-j 9.4.0\n(JDBC driver)" as jdbc
    artifact "forms_rt 7.0.3\n(GUI Designer runtime)" as forms
  }
}

node "Database host\n(default 127.0.0.1)" as dbhost <<device>> {
  node "MySQL server\nport 3306" as mysql <<executionEnvironment>> {
    artifact "schema reports_db\n(user reports_user)" as schema
  }
}

mvn --> central : downloads dependencies,\nHTTPS
mvn ..> app : <<create>>
app ..> pxml : <<use>> reads
app ..> hib : <<use>> JPA API
app ..> forms : <<use>> form layouts
hib ..> jdbc : <<use>> loads driver
jvm --> mysql : JDBC over TCP :3306

note bottom of dbhost
  hbm2ddl.auto=update: the app creates
  and alters tables in reports_db at first
  connect; the schema must exist before.
end note

note bottom of ws
  Entry points: main() in HomePageGUI,
  UserLoginGUI, UserRegistrationGUI.
  No fat jar or launcher: classpath
  must include the dependencies.
end note
@enduml
