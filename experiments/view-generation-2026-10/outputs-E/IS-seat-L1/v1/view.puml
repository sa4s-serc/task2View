@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<muted>> stereotype
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60

title UML component diagram: seat booking (make reservation), overview


component "Swing booking wizard\n(Swing, ReservationSummary)" as swing
component "REST controllers\n(Spring MVC, /api/reservations)" as rest
component "LibraryFacade\n(single entry point)" as facade <<accent>>
component "ReservationManager\n(validates, picks seat, saves)" as resmgr <<accent>>
component "StudyRoomManager\n(room and seat availability)" as roommgr
component "Registries and domain model\n(JPA, MySQL)" as registries
component "Notification\n(Observer, email adapter)" as notif

swing --> facade : makeReservation,\nget room detail
rest --> facade : makeReservation
facade --> resmgr : makeReservation
facade --> roommgr : getRoomDetail
resmgr --> registries : find, save
roommgr --> registries : query seats
resmgr --> notif : notifyObservers
@enduml
