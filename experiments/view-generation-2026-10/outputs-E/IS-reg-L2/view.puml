@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

participant "Registration form\n(registration.html)\nsends form fields" as form
participant "AuthenticationController\n+ RestExceptionHandler\nHTTP in, exception to status" as ctl
participant "LibraryFacade\npass-through entry,\nalso used by Swing" as facade
participant "UserManager\nvalidate, check unique,\nchoose factory, persist" as mgr
participant "User factory\nbuilds Student or\nLibrarian" as fac
participant "UserRegistry\nlookups and save\nof users" as reg
participant "PersistenceManager\n(JPA, MySQL)\ntransaction, rollback" as pm

form -> ctl : IP1 POST /api/auth/register\n(role, name, surname, email,\npassword, identifier)
ctl -> facade : register(...)
facade -> mgr : register(...)
alt bad format
  mgr --> ctl : IP2 IllegalArgumentException\n(via facade) -> 400 {error}
else ok
  mgr -> reg : email / identifier used?
  reg -> pm : IP4 findFirstByFields\n(2 lookups collapsed)
  alt duplicate
    mgr --> ctl : IP2 IllegalArgumentException\n(via facade) -> 400 {error}
  else new
    mgr -> fac : IP3 createUser(...)\n[Student -> StudentFactory,\notherwise LibrarianFactory]
    mgr -> reg : registerUser(user)
    reg -> pm : IP4 save(user)\n(persist + commit, else rollback)
    alt save ok
      ctl --> form : 200 UserDTO
    else save returned false
      mgr --> ctl : IP2 RuntimeException\nunmapped -> default 500
    end
  end
end

legend bottom left
  Integration points to exercise
  IP1  HTTP form parameters at the REST controller (also the Swing form,
       which calls LibraryFacade.register directly and skips this step)
  IP2  Validation (role, names, email, password, identifier) and exception-to-HTTP mapping: IllegalArgumentException -> 400, RuntimeException unmapped
  IP3  Role-based factory choice (Student, Librarian, unknown role rejected earlier)
  IP4  JPA lookups and save transaction against MySQL (rollback returns false)
end legend
@enduml
