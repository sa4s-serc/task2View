@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (POST /api/auth/register)
hide footbox
autonumber "<b>00"

participant "Registration form\n(registration.html)" as form
participant "AuthenticationController\n(Spring REST)" as ctl
participant "LibraryFacade" as facade
participant "UserManager" as mgr
participant "User factory\n(Student / Librarian)" as fac
participant "UserRegistry" as reg
participant "PersistenceManager\n(JPA, MySQL)" as pm

form -> ctl : POST /api/auth/register\n(role, name, surname, email,\npassword, identifier)
ctl -> facade : register(...)
facade -> mgr : register(...)
mgr -> mgr : validate formats
alt input valid and unique
  mgr -> reg : email / identifier used?
  reg -> pm : findFirstByFields\n(2 lookups collapsed)
  mgr -> fac : createUser(...)
  mgr -> reg : registerUser(user)
  reg -> pm : save(user)
  ctl --> form : 200 UserDTO
else invalid or duplicate
  ctl --> form : 400 {error}
end

note over form, ctl
  Swing Registration form calls
  LibraryFacade.register directly,
  bypassing the REST controller.
  Errors surface as IllegalArgumentException
  (-> 400); a failed save throws
  RuntimeException (not mapped, unconfirmed).
end note
@enduml
