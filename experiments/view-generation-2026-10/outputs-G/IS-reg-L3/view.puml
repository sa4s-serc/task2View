@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

title UML sequence diagram: user registration (Student or Librarian)
hide footbox
autonumber "<b>00"

actor       "Registrant"                                   as user
participant "Registration boundary\n(Swing form /\nPOST /api/auth/register)" as ui
participant "LibraryFacade"                                as facade
participant "UserManager\n(validation, rules)"             as um
participant "UserFactory\n(Student / Librarian)"           as fac
participant "UserRegistry"                                 as reg
participant "PersistenceManager\n(JPA)"                    as pm
database    "reservationsdb\n(MySQL)"                      as db

user -> ui ++ : role, name, surname,\nemail, password, identifier
ui -> facade ++ : register(...)
facade -> um ++ : register(...)
um -> um : validate role, name, password;\nthen role-specific fields
note right of um
  Student: ID = letter + 8 digits.
  Librarian: alphanumeric code.
  Email must end in unina.it.
end note
alt a field is invalid
  um --> facade : IllegalArgumentException\n(no lookup, nothing saved)
else valid
  um -> reg ++ : institutionalEmailExists(email)
  reg -> pm ++ : findFirstByFields(User, email)
  pm -> db : SELECT
  pm --> reg -- : User or null
  reg --> um -- : exists?
  alt email already registered
    um --> facade : IllegalArgumentException\n"Email already associated"
  else free
    um -> reg ++ : findStudentByStudentNumber /\nfindLibrarianByCode(identifier)
    reg -> pm ++ : findFirstByFields(role entity)
    pm -> db : SELECT
    pm --> reg -- : entity or null
    reg --> um -- : match or null
    alt identifier already used
      um --> facade : IllegalArgumentException\n"Identifier already in use"
    else free
      um -> fac ++ : createUser(name, surname,\nemail, password, identifier)
      fac --> um -- : Student or Librarian
      um -> reg ++ : registerUser(newUser)
      reg -> pm ++ : save(newUser)
      pm -> db : INSERT
      pm --> reg -- : boolean
      reg --> um -- : saved?
      alt save failed
        um --> facade : RuntimeException\n"user could not be saved"
      else saved
        um --> facade : UserDTO
      end
    end
  end
end
facade --> ui -- : UserDTO or exception
ui --> user -- : confirmation or error message
@enduml
