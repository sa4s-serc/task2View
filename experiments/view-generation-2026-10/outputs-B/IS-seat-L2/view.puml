@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
top to bottom direction

title Component view: seat booking (make reservation) and its dependencies
skinparam nodesep 40
skinparam ranksep 70

package "Entry points (boundary)" {
  [Swing Booking Wizard] as wiz
  [REST Controllers] as rest
  [Notification Scheduler] as sched
}
[Library Facade] as facade
package "Application logic (controller)" {
  [Reservation Manager] as resmgr #1D4ED8;text:white
  [Seat Assignment Strategy] as strat #1D4ED8;text:white
  [Study Room Manager] as roommgr
  [Notification Manager] as notif
}
package "Domain model (entity)" {
  [Reservation Domain\n(Reservation, states, Seat, Area, Student)] as dom #FEE2E2;line:B91C1C
  [Registries\n(Reservation, StudyRoom, User)] as reg
}
[Persistence Manager\n(JPA/Hibernate)] as pm
[MySQL database] as db #F8FAFC;line:94A3B8;text:64748B
[Email Adapter\n(external gateway)] as mail #F8FAFC;line:94A3B8;text:64748B

wiz --> facade : makeReservation
rest --> facade : POST /api/reservations
sched --> facade : end-of-slot job
facade --> resmgr : delegate booking
facade --> roommgr : room, slot, seat queries
resmgr --> strat : select seat
resmgr --> dom : check, change state
resmgr --> reg : find, save
resmgr --> notif : notify observers
roommgr ---> dom : seat availability
roommgr --> reg : find rooms
dom --> reg : look up occupancy
reg --> pm : persist
pm --> db : JDBC
notif --> mail : send email

legend right
  Blue: main place for new booking rules (validation and seat selection).
  Light red: domain rules that also hold booking constraints.
  Grey: external systems.
endlegend
@enduml
