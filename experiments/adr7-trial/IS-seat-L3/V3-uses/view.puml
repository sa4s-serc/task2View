@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
AddRelTag("against", $textColor="#A32D2D", $lineColor="#A32D2D", $lineStyle=DashedLine(), $legendText="dependency against the layering (found in code)")
AddElementTag("focus", $bgColor="#FAC775", $fontColor="#412402", $borderColor="#854F0B", $legendText="the part being changed")
title Uses view — seat booking functionality

System_Boundary(app, "Progetto-IS-main-English") {
  Component(web_client, "Web client", "HTML / JavaScript", "app.js")
  Component(ui, "Seat booking desktop app", "Java Swing", "Swing screens for choosing room, area, seat and time slot\nWizardState, SeatSelection, AreaSelection, …")
  Component(job, "Reservation reminder scheduler", "scheduled", "periodically triggers reservation-end handling and reminders\nNotificationScheduler")
  Component(api, "Reservation REST API", "Spring Boot REST", "REST entry point for creating, cancelling and checking in reservations\nReservationController, StudyRoomController, StudentController")
  Component(service, "Application services", "Java", "LibraryFacade, ReservationManager, StudyRoomManager, …", $tags="focus")
  Component(integration, "Email notification gateway", "adapters", "adapts notification sending to the external email service stub\nNotificationServiceAdapter, ExternalEmailGateway")
  Component(domain, "Reservation and seat model", "JPA entities", "reservation, seat and room entities with state-based cancel and check-in rules\nReservation, Student, Area, …")
  Component(data_access, "Reservation storage", "JPA / Hibernate", "StudyRoomRegistry, ReservationRegistry, PersistenceManager, …")
}
ComponentDb(database, "MySQL database", "MySQL", "reservationsdb")

Rel(service, domain, "creates and updates")
Rel(service, data_access, "reads and saves")
Rel(api, service, "depends on", "in-process")
Rel(ui, service, "depends on", "in-process")
Rel(domain, data_access, "queries", $tags="against")
Rel(web_client, api, "depends on", "HTTP/JSON")

SHOW_LEGEND()
@enduml
