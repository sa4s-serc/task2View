  "fragments": [
    {
      "id": "scn:make-seat-reservation:alt1",
      "kind": "alt",
      "guard": "student is null -> IllegalArgumentException(\"Student not found.\")"
    },
    {
      "id": "scn:make-seat-reservation:alt2",
      "kind": "alt",
      "guard": "room missing, inactive or closed on date -> IllegalArgumentException"
    },
    {
      "id": "scn:make-seat-reservation:alt3",
      "kind": "alt",
      "guard": "area null or not in selected room -> IllegalArgumentException(\"The area is not in the selected room\")"
    },
    {
      "id": "scn:make-seat-reservation:alt4",
      "kind": "alt",
      "guard": "date in the past, or slot not found/already started -> IllegalArgumentException(\"The selected time slot is not available\")"
    },
    {
      "id": "scn:make-seat-reservation:alt5",
      "kind": "alt",
      "guard": "seatId != 0 and seat not found or not in area -> IllegalArgumentException"
    },
    {
      "id": "scn:make-seat-reservation:alt6",
      "kind": "alt",
      "guard": "duplicate reservation -> IllegalArgumentException(\"You already have an active or confirmed reservation...\")"
    },
    {
      "id": "scn:make-seat-reservation:alt7",
      "kind": "alt",
      "guard": "no available seats -> IllegalArgumentException(\"No seats are available in the selected area\")"
    },
    {
      "id": "scn:make-seat-reservation:alt8",
      "kind": "alt",
      "guard": "seatId > 0 and seat taken -> IllegalStateException(\"The selected seat is no longer available\")"
    },
    {
      "id": "scn:make-seat-reservation:alt9",
      "kind": "alt",
      "guard": "seatId == 0 (automatic assignment)"
    },
    {
      "id": "scn:make-seat-reservation:alt10",
      "kind": "alt",
      "guard": "save returns false -> RuntimeException(\"Server error: the reservation could not be saved...\")"
    }
  ],
