@startuml
mainframe cmp Client-Server view — seat booking functionality
skinparam shadowing false
hide empty members
hide circle
top to bottom direction
skinparam componentStyle uml2

package "Progetto-IS-main-English" as system {
  component p_web_client [
  Web client
  ..realizations..
  app.js
  ]
  component p_ui [
  Seat booking wizard UI
  --
  Swing screens where users pick room, area, seat and confirm reservations
  ..realizations..
  WizardState, SeatSelection, AreaSelection, … 12 more
  ]
  component p_job [
  Notification scheduler
  --
  runs scheduled jobs that trigger notifications
  ..realizations..
  NotificationScheduler
  ]
  component p_api [
  Reservation REST API
  --
  REST entry point for creating, cancelling and checking in reservations
  ..realizations..
  ReservationController, StudyRoomController, StudentController
  ]
  component p_service [
  Booking rules service
  --
  validates booking requests, assigns seats, and creates and saves reservations
  ..realizations..
  LibraryFacade, ReservationManager, NotificationManager
  ]
  component p_domain <<Entity>> [
  Reservation domain model
  --
  entities for students, rooms, areas, seats, time slots and reservation states
  ..realizations..
  Student, Area, Seat, … 13 more
  ]
  component p_data_access [
  Reservation storage
  --
  saves and queries reservations, rooms, seats and students through JPA
  ..realizations..
  StudyRoomRegistry, ReservationRegistry, PersistenceManager, … 2 more
  ]
}
component p_database <<database>> [
MySQL database
..realizations..
reservationsdb
]
p_service ..> p_domain : creates and updates
p_service ..> p_data_access : reads and saves
p_ui ..> p_service : requests operations {in-process}
p_api ..> p_service : delegates requests {in-process}
p_domain .[#A32D2D].> p_data_access : queries {against the layering}
p_data_access ..> p_database : persists {JPA / JDBC}
p_web_client ..> p_api : sends requests {HTTP/JSON}
@enduml
