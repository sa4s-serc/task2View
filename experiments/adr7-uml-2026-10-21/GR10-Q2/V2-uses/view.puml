@startuml
mainframe pkg Uses view — progetto_ing_software_gr10-main-English
skinparam shadowing false
hide empty members
hide circle
top to bottom direction

package "Report desktop screens" as p_ui {
  class "ReportCreationGUI" as p_ui_0
  class "ActivityMonitoringGUI" as p_ui_1
  class "ReceivedReportsGUI" as p_ui_2
  note "and 4 more" as p_ui_note
  p_ui_0 -[hidden]right- p_ui_1
  p_ui_1 -[hidden]right- p_ui_2
}
package "Report handling services" as p_service {
  class "ReportService" as p_service_0
  class "SystemServicesController" as p_service_1
  class "UserService" as p_service_2
  note "and 1 more / the part being changed" as p_service_note
  p_service_0 -[hidden]right- p_service_1
  p_service_1 -[hidden]right- p_service_2
}
package "Report domain entities" as p_domain {
  class "Report" as p_domain_0
  class "User" as p_domain_1
  class "Notification" as p_domain_2
  note "and 11 more" as p_domain_note
  p_domain_0 -[hidden]right- p_domain_1
  p_domain_1 -[hidden]right- p_domain_2
}
package "Report database access" as p_data_access {
  class "PersistenceService" as p_data_access_0
  note "and 1 more" as p_data_access_note
}
p_service ..> p_domain : <<use>>
p_service ..> p_data_access : <<use>>
p_ui ..> p_service : <<use>>
@enduml
