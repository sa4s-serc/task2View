  ]
  component p_domain <<Entity>> [
  Municipal report entities
  --
  JPA entities for reports, users, citizens, operators, notes, status updates and locations
  ..realizations..
  Report, Notification, MunicipalOperator, … 11 more
  ]
  component p_data_access [
  Report data storage
  --
  generic save, update and find operations over JPA with a shared EntityManagerFactory
  ..realizations..
  PersistenceService, … 1 more
  ]
}
component p_database <<database>> [
MySQL database
..realizations..
reports_db
]
p_service_2 ..> p_domain : creates and updates
p_service_2 ..> p_data_access : reads and saves
p_ui ..> p_service_1 : requests operations {in-process}
p_service_1 ..> p_service_2 : uses
p_data_access ..> p_database : persists {JPA / JDBC}
