@startuml
mainframe pkg Decomposition view — seat booking functionality
skinparam shadowing false
hide empty members
hide circle
top to bottom direction

package "Presentation" as layer0 <<layer>> {
  package "Web client" as p_web_client {
    class "app.js" as p_web_client_0
  }
  package "Student and librarian screens" as p_ui {
    class "SeatSelection" as p_ui_0
    class "ReservationSummary" as p_ui_1
    class "WizardState" as p_ui_2
    note "and 9 more" as p_ui_note
    p_ui_0 -[hidden]right- p_ui_1
    p_ui_1 -[hidden]right- p_ui_2
  }
  package "Reservation REST endpoints" as p_api {
    class "ReservationController" as p_api_0
    class "StudyRoomController" as p_api_1
    class "StudentController" as p_api_2
    p_api_0 -[hidden]right- p_api_1
    p_api_1 -[hidden]right- p_api_2
  }
}
package "Application" as layer1 <<layer>> {
  package "Notification scheduler" as p_job {
    class "NotificationScheduler" as p_job_0
  }
  package "Seat reservation services" as p_service {
    class "LibraryFacade" as p_service_0
    class "ReservationManager" as p_service_1
    class "StudyRoomManager" as p_service_2
    note "and 1 more" as p_service_note
    p_service_0 -[hidden]right- p_service_1
    p_service_1 -[hidden]right- p_service_2
  }
}
package "Domain" as layer2 <<layer>> {
  package "Library reservation model" as p_domain {
    class "Student" as p_domain_0
    class "StudyRoom" as p_domain_1
    class "Area" as p_domain_2
    note "and 13 more" as p_domain_note
    p_domain_0 -[hidden]right- p_domain_1
    p_domain_1 -[hidden]right- p_domain_2
  }
}
package "Data access" as layer3 <<layer>> {
  package "Reservation and room storage" as p_data_access {
    class "StudyRoomRegistry" as p_data_access_0
    class "ReservationRegistry" as p_data_access_1
    class "PersistenceManager" as p_data_access_2
    note "and 2 more" as p_data_access_note
    p_data_access_0 -[hidden]right- p_data_access_1
    p_data_access_1 -[hidden]right- p_data_access_2
  }
}
