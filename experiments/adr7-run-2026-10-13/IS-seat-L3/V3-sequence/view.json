      "kind": "alt",
      "guard": "POST /api/reservations/create"
    },
    {
      "id": "scn:make-reservation:alt2",
      "kind": "alt",
      "guard": "student missing -> IllegalArgumentException(\"Student not found.\")"
    },
    {
      "id": "scn:make-reservation:alt3",
      "kind": "alt",
      "guard": "room null, inactive or closed on date -> IllegalArgumentException"
    },
    {
      "id": "scn:make-reservation:alt4",
      "kind": "alt",
      "guard": "area missing or not in room -> IllegalArgumentException"
    },
    {
      "id": "scn:make-reservation:alt5",
      "kind": "alt",
      "guard": "seatId != 0; seat missing or not in selected area -> IllegalArgumentException"
    },
    {
      "id": "scn:make-reservation:alt6",
      "kind": "alt",
      "guard": "inside synchronized block; true -> IllegalArgumentException (duplicate booking)"
    },
    {
      "id": "scn:make-reservation:alt7",
      "kind": "alt",
      "guard": "empty list -> IllegalArgumentException(\"No seats are available in the selected area\")"
    },
    {
      "id": "scn:make-reservation:alt8",
      "kind": "alt",
      "guard": "seatId > 0 and seat not available -> IllegalStateException(\"The selected seat is no longer available\")"
    },
    {
      "id": "scn:make-reservation:alt9",
      "kind": "alt",
      "guard": "false -> RuntimeException (save failed)"
    },
    {
      "id": "scn:make-reservation:alt10",
      "kind": "alt",
      "guard": "seatId == 0 uses automatic assignment strategy"
    },
    {
      "id": "scn:make-reservation:alt11",
      "kind": "alt",
      "guard": "after successful save"
    },
    {
      "id": "scn:make-reservation:alt12",
      "kind": "alt",
      "guard": "reservation has a student"
    }
