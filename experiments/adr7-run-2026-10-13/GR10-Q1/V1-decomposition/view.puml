@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
AddRelTag("against", $textColor="#A32D2D", $lineColor="#A32D2D", $lineStyle=DashedLine(), $legendText="dependency against the layering (found in code)")
AddElementTag("focus", $bgColor="#FAC775", $fontColor="#412402", $borderColor="#854F0B", $legendText="the part being changed")
title Decomposition view — progetto_ing_software_gr10-main-English

System_Boundary(app, "progetto_ing_software_gr10-main-English") {
  Boundary(layer0, "Presentation") {
    Component(ui, "Report management desktop screens", "Java Swing", "Swing screens for creating, reviewing, updating reports and monitoring activity\nUserDashboardGUI, ReportCreationGUI, ActivityMonitoringGUI, …\nanswers: user-facing functionality")
  }
  Boundary(layer1, "Application") {
    Component(service_1, "Use case controllers", "Java", "Facade and controllers delegating report creation and user registration, validating registration data\nSystemServicesController, ReportCreationController, UserRegistrationController\nanswers: application logic; user-facing functionality; …")
    Component(service_2, "Report and user services", "Java", "creates reports, registers users, retrieves reports and credentials through persistence\nReportService, UserService\nanswers: domain entities; user-facing functionality; …")
  }
  Boundary(layer2, "Domain") {
    Component(domain, "Municipal report entities", "JPA entities", "JPA entities for reports, users, citizens, operators, notes, status updates and locations\nReport, Notification, MunicipalOperator, …\nanswers: domain entities; data persistence")
  }
  Boundary(layer3, "Data access") {
    Component(data_access, "Report data storage", "JPA / Hibernate", "generic save, update and find operations over JPA with a shared EntityManagerFactory\nPersistenceService, …\nanswers: data persistence; user-facing functionality; …")
  }
}
ComponentDb(database, "MySQL database", "MySQL", "reports_db")


SHOW_LEGEND()
@enduml
