  "deploy": [
    {
      "kind": "persistence-unit",
      "name": "Municipal_Report_Management_System",
      "file": "src/main/resources/META-INF/persistence.xml",
      "details": {
        "provider": "org.hibernate.jpa.HibernatePersistenceProvider",
        "transaction-type": "RESOURCE_LOCAL",
        "jdbc.url": "jdbc:mysql://127.0.0.1:3306/reports_db",
        "hbm2ddl.auto": "update"
      }
    }
  ],
  "build": [
    {
      "tool": "maven",
      "file": "pom.xml",
      "name": "municipal-report-management",
      "packaging": "jar",
      "dependencies": [
        "junit-jupiter",
        "forms_rt",
        "mysql-connector-j",
        "hibernate-core"
      ]
    }
  ],
  "signals": {
    "layered": [
      "presentation: Boundary",
      "application: Control",
      "domain: Entity",
      "persistence: Database"
    ],
    "gui-client": [
      "Boundary/*GUI.java import javax.swing (10 files)"
    ],
    "persisted-data": [
      "Entity.Report: @Entity @Table(name = \"reports\")",
      "Entity.User: @Entity @Table(name = \"users\")"
    ],
    "inheritance": [
      "Entity.Citizen extends User",
      "Entity.MunicipalOperator extends User",
      "Submitted/Assigned/InProgress/Resolved implement ReportStatus"
    ],
    "lifecycle": [
      "Entity.ReportStatus implemented by Submitted, Assigned, InProgress, Resolved; Report.STATUS_* constants"
    ],
    "deploy-config": [
      "src/main/resources/META-INF/persistence.xml: persistence-unit Municipal_Report_Management_System"
    ],
    "build-config": [
      "pom.xml: artifactId municipal-report-management"
    ],
    "tests": [
      "src/test/java/testingBlackBox, testingWhiteBox (JUnit 5)"
    ]
  },
  "notes": [
    "Report is persisted with a status name string; the ReportStatus state objects are @Transient and rebuilt in @PostLoad.",
    "Schema is generated by Hibernate (hbm2ddl.auto=update); there is no SQL script.",
    "ReportService and UserService live in package Entity (domain layer) and are the only users of Database.PersistenceService."
  ]
}