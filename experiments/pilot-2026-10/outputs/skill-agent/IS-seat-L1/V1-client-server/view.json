      "responsibilities": [
        "ExternalEmailGateway: stub e-mail sender",
        "NotificationConfiguration: wires the e-mail adapter into NotificationManager at startup",
        "NotificationScheduler: runs reservation-end handling and reminders every minute",
        "NotificationServiceAdapter: delivers notifications through the e-mail gateway",
        "ReservationController: exposes POST /api/reservations/create to book a seat",
        "RestExceptionHandler: maps booking validation errors to HTTP 400",
        "StudyRoomController: returns per-seat availability of a room for a date and time slot",
        "AreaSelection: loads room detail with seat availability for the Swing wizard",
        "ReservationSummary: submits the booking from the Swing wizard",
        "SeatSelection: lets the student pick a seat or automatic assignment in the Swing wizard"
      ],
