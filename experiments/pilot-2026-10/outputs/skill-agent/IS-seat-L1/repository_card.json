    "inheritance": [
      "entity.state.*State implements ReservationState (5 classes)",
      "Student/Librarian extend User; Reservation extends Subject"
    ],
    "persisted-data": [
      "entity.Reservation: @Entity @Table(name = \"reservation\")",
      "entity.Seat: @Entity"
    ],
    "threads": [
      "boundary.NotificationScheduler: @Scheduled(initialDelay = 60000, fixedDelay = 60000)",
      "Launcher: new Thread(() -> SpringApplication.run(...))"
    ],
    "lifecycle": [
      "entity.state.ActiveState/ConfirmedState/... implement ReservationState; entity.StatusEnum"
    ],
    "deploy-config": [
      "JavaProject/src/main/resources/META-INF/persistence.xml: persistence-unit reservationsPU (MySQL)"
