    {
      "id": "group:layer:application",
      "kind": "layer",
      "name": "Application",
      "stereotype": "layer",
      "parent": null,
      "responsibilities": [
        "SystemServicesController: facade giving the boundary one entry point; delegates each use case to its use-case controller",
        "UserLoginController: validates login data and obtains the user session data from UserService",
        "UserRegistrationController: validates registration data and rejects an already registered email before registering the user",
        "ReportCreationController: validates report data, checks the user is a citizen and requests report registration",
        "ReportReviewController: checks the user role and retrieves submitted (citizen) or received (operator) reports",
        "ReportDetailsController: checks access to a report (operator or owning citizen) and retrieves its details and history",
        "ReportStatusUpdateController: checks operator privileges, advances the report status and then requests the notification",
        "InternalNoteController: checks operator permission and requests registration of an internal note",
        "ActivityMonitoringController: authorises the operator, validates criteria and requests monitoring results",
        "NotificationController: decides whether a status is notifiable and requests the citizen notification"
      ],
