    {
      "id": "group:layer:domain",
      "kind": "layer",
      "name": "Domain",
      "stereotype": "layer",
      "parent": null,
      "responsibilities": [
        "ReportService: domain service for reports: registers reports, retrieves them, updates status, adds notes, generates notifications and monitoring statistics",
        "UserService: domain service for users: registers users, looks up credentials and checks citizen/operator roles",
        "Report: persistent report: data, location, assigned operator, internal notes, status updates and a status object that drives status changes",
        "User: abstract persistent user with name, phone number and credentials (single-table inheritance)",
        "Citizen: user who submits reports",
        "MunicipalOperator: user who reviews, updates and annotates reports",
        "InternalNote: persistent internal note written by an operator on a report",
        "StatusUpdate: persistent record of a status change made by an operator",
        "Notification: persistent notification sent to a citizen about a report status change",
        "ReportCategory: enumerates the categories a report can have",
        "ReportStatus: state interface: advances a report and tells whether the status is notifiable",
        "Submitted: initial state; advancing makes the report Assigned",
        "Assigned: state; advancing makes the report InProgress; notifiable",
        "InProgress: state; advancing makes the report Resolved",
        "Resolved: final state; refuses further advancement; notifiable"
      ],
