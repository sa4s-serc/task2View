@startuml view-1
title View 1 - Persistent data model (JPA mapping, MySQL reports_db)
hide methods
skinparam linetype ortho

entity "users" as users <<Entity.User, SINGLE_TABLE>> {
  *user_id : PK, IDENTITY
  --
  *role : discriminator (CITIZEN | MUNICIPAL_OPERATOR)
  *name : varchar(50)
  *lastName : varchar(50)
  *phone_number : varchar(20)
  *email : varchar(100), UNIQUE  <<Credentials>>
  *password : varchar(100)  <<Credentials, plain text>>
}

entity "reports" as reports <<Entity.Report>> {
  *report_id : PK, IDENTITY
  --
  *title : varchar(50)
  *description : varchar(1000)
  *category : enum STRING  <<ReportCategory>>
  *current_status : varchar(30)  <<state name>>
  *citizen_editable : boolean
  report_date : DATE (nullable)
  attached_image : varchar (path, nullable)
  --
  <<Location, @Embedded>>
  *city : varchar(80)
  *cap : varchar(5)
  *street : varchar(100)
  *street_number : varchar(10)
  *municipal_area : varchar(80)
  --
  *citizen_id : FK -> users
  operator_id : FK -> users (nullable)
}

entity "status_updates" as su <<Entity.StatusUpdate>> {
  *update_id : PK, IDENTITY
  --
  *update_date : TIMESTAMP
  *new_status : varchar(30)
  *report_id : FK -> reports
  *operator_id : FK -> users
}

entity "internal_notes" as notes <<Entity.InternalNote>> {
  *note_id : PK, IDENTITY
  --
  *text : varchar(1000)
  *created_date : TIMESTAMP
  *report_id : FK -> reports
  *operator_id : FK -> users
}

entity "notifications" as notif <<Entity.Notification>> {
  *notification_id : PK, IDENTITY
  --
  *sent_date : TIMESTAMP
  *message : varchar(1000)
  *notified_status : varchar(50)  <<only assigned | resolved>>
  *report_id : FK -> reports
  *citizen_id : FK -> users
}

users ||--o{ reports : "citizen_id\n(reporting citizen, mandatory)"
users |o--o{ reports : "operator_id\n(assigned operator, set at first status change)"
reports ||--o{ su : "report_id\ncascade ALL, orphanRemoval, EAGER"
reports ||--o{ notes : "report_id\ncascade ALL, orphanRemoval, EAGER"
reports ||--o{ notif : "report_id\n(no cascade; saved on its own)"
users |o--o{ su : "operator_id"
users |o--o{ notes : "operator_id"
users |o--o{ notif : "citizen_id (recipient)"

note bottom of users
  Citizen and MunicipalOperator are Java subclasses of the
  abstract User and share the single "users" table.
  Only rows with role=CITIZEN may be FK targets of
  reports.citizen_id / notifications.citizen_id;
  only role=MUNICIPAL_OPERATOR for operator_id.
  The DB does not enforce this; the Java types do.
end note

note bottom of reports
  Category and State are NOT separate tables:
  - category = enum ReportCategory stored as text
    (BROKEN_STREETLIGHT, DAMAGED_ROAD, ABANDONED_WASTE,
     GENERAL_HAZARD, DAMAGED_STREET_FURNITURE)
  - current_status = text (submitted | assigned | in_progress | resolved);
    the State-pattern object (Entity.ReportStatus) is @Transient and
    rebuilt from this string in @PostLoad.
  Location is an @Embeddable in the reports table, not a table.
  Schema is generated by hibernate.hbm2ddl.auto=update (no DDL scripts).
end note
@enduml
