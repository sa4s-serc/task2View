{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AnvF34rB1scXsgRjd18KHe","type":"tool_result","content":"1\tpackage it.unina.reservations.controller;\n2\t\n3\timport it.unina.reservations.controller.strategy.FirstAvailableAssignment;\n4\timport it.unina.reservations.controller.strategy.AssignmentStrategy;\n5\timport it.unina.reservations.dto.ReservationDTO;\n6\timport it.unina.reservations.dto.ReservationRequestDTO;\n7\timport it.unina.reservations.dto.StatisticsDTO;\n8\timport it.unina.reservations.entity.*;\n9\timport it.unina.reservations.entity.state.ActiveState;\n10\t\n11\timport java.time.LocalDate;\n12\timport java.time.LocalDateTime;\n13\timport java.time.LocalTime;\n14\timport java.time.ZoneId;\n15\timport java.util.*;\n16\t\n17\t/**\n18\t  * English implementation note.\n19\t * MakeReservation (UC7), CancelReservation (UC9), PerformCheckIn (UC10),\n20\t  * English implementation note.\n21\t  * English implementation note.\n22\t * ({@code assignmentStrategy}).\n23\t */\n24\tpublic class ReservationManager {\n25\t\n26\t    private static ReservationManager instance;\n27\t\n28\t    private final ReservationRegistry reservationRegistry = ReservationRegistry.getInstance();\n29\t    private final StudyRoomRegistry roomRegistry = StudyRoomRegistry.getInstance();\n30\t    private final UserRegistry userRegistry = UserRegistry.getInstance();\n31\t    private AssignmentStrategy assignmentStrategy;\n32\t\n33\t\n34\t    private ReservationManager() {}\n35\t\n36\t    public static ReservationManager getInstance() {\n37\t        if (instance == null) {\n38\t            instance = new ReservationManager();\n39\t            instance.setAssignmentStrategy(new FirstAvailableAssignment());\n40\t        }\n41\t        return instance;\n42\t    }\n43\t\n44\t\n45\t    /** English implementation note. */\n46\t    void setAssignmentStrategy(AssignmentStrategy assignmentStrategy){\n47\t        this.assignmentStrategy = assignmentStrategy;\n48\t    }\n49\t\n50\t    /** English implementation note. */\n51\t    private Student resolveStudent(Long studentId){\n52\t        Student student = userRegistry.findStudentById(studentId);\n53\t        if(student == null){\n54\t            throw new IllegalArgumentException(\"Student not found.\");\n55\t        }\n56\t        return student;\n57\t    }\n58\t\n59\t\n60\t    // ------------------------------------------------------------------ UC7\n61\t    /**\n62\t      * English implementation note.\n63\t      * English implementation note.\n64\t     */\n65\t    public ReservationDTO makeReservation(ReservationRequestDTO request) {\n66\t        Long roomId = request.getRoomId();\n67\t        Long areaId = request.getAreaId();\n68\t        Long seatId = request.getSeatId();\n69\t        LocalDate date = request.getDate();\n70\t        Long timeSlotId = request.getTimeSlotId();\n71\t        Long studentId = request.getStudentId();\n72\t\n73\t        // English implementation note.\n74\t        Student student = resolveStudent(studentId);\n75\t        StudyRoom room = resolveRoom(roomId, date);\n76\t        Area area = resolveArea(room, areaId);\n77\t        TimeSlot timeSlot = resolveTimeSlot(room, timeSlotId, date);\n78\t\n79\t        // English implementation note.\n80\t        validateSeatInArea(area, seatId);\n81\t\n82\t        // English implementation note.\n83\t        // English implementation note.\n84\t        synchronized (this){\n85\t            // English implementation note.\n86\t            validateUniqueness(student, date, timeSlot);\n87\t\n88\t            // English implementation note.\n89\t            List<Seat> available = availableSeats(area, date, timeSlot);\n90\t\n91\t            // English implementation note.\n92\t            Seat seat = selectSeat(seatId, date, timeSlot, available);\n93\t\n94\t            // English implementation note.\n95\t            Reservation reservation = createAndSave(student, date, timeSlot, seat);\n96\t            // English implementation note.\n97\t            //    e non si notify reservations mai saved.\n98\t            notifyReservation(reservation);\n99\t            return toDTO(reservation);\n100\t        }\n101\t\n102\t    }\n103\t\n104\t    private void validateSeatInArea(Area area, Long seatId) {\n105\t        if(seatId == null){\n106\t            throw new IllegalArgumentException(\"Seat not provided\");\n107\t        }\n108\t        if(seatId != 0){\n109\t            Seat seat = roomRegistry.findSeatById(seatId);\n110\t            if(seat == null){\n111\t                throw new IllegalArgumentException(\"Invalid seat identifier.\");\n112\t            }\n113\t            // English implementation note.\n114\t            if(!area.getId().equals(seat.getArea().getId())){\n115\t                throw new IllegalArgumentException(\"The seat is not in the selected area\");\n116\t            }\n117\t        }\n118\t    }\n119\t\n120\t    private void notifyReservation(Reservation reservation) {\n121\t        reservation.attach(NotificationManager.getInstance());\n122\t        reservation.notifyObservers();\n123\t    }\n124\t\n125\t    private Reservation createAndSave(Student student, LocalDate date, TimeSlot timeSlot, Seat seat) {\n126\t\n127\t        Reservation reservation = new Reservation();\n128\t        reservation.setDate(date);\n129\t        reservation.setTimeSlot(timeSlot);\n130\t        reservation.setSeat(seat);\n131\t        reservation.setStudent(student); // English implementation note.\n132\t        reservation.setState(ActiveState.getInstance());\n133\t\n134\t        boolean success = reservationRegistry.saveReservation(reservation);\n135\t        if (!success){\n136\t            throw new RuntimeException(\"Server error: the reservation could not be saved. Please try again.\");\n137\t        }\n138\t\n139\t        return reservation;\n140\t    }\n141\t\n142\t    private List<Seat> availableSeats(Area area, LocalDate date, TimeSlot timeSlot) {\n143\t        // English implementation note.\n144\t        List<Seat> available = area.getAvailableSeats(date, timeSlot);\n145\t        if(available.isEmpty()){\n146\t            throw new IllegalArgumentException(\"No seats are available in the selected area\");\n147\t        }\n148\t        return available;\n149\t    }\n150\t\n151\t    private void validateUniqueness(Student student, LocalDate date, TimeSlot timeSlot) {\n152\t        if(student.hasActiveOrConfirmedReservationForDateAndSlot(date, timeSlot.getLabel())){\n153\t            throw new IllegalArgumentException(\"You already have an active or confirmed reservation for this date and time slot\");\n154\t        }\n155\t    }\n156\t\n157\t    private Area resolveArea(StudyRoom room, Long areaId) {\n158\t        if (areaId == null) {\n159\t            throw new IllegalArgumentException(\"Area not specified\");\n160\t        }\n161\t        if (areaId < 1){\n162\t            throw new IllegalArgumentException(\"Invalid area identifier.\");\n163\t        }\n164\t\n165\t        Area area = roomRegistry.findAreaById(areaId);\n166\t        if(area == null || !area.getStudyRoom().getId().equals(room.getId())){\n167\t            throw new IllegalArgumentException(\"The area is not in the selected room\");\n168\t        }\n169\t\n170\t        return area;\n171\t    }\n172\t\n173\t    private StudyRoom resolveRoom(Long roomId, LocalDate date) {\n174\t        if(roomId == null){\n175\t            throw new IllegalArgumentException(\"A study room must be selected\");\n176\t        }\n177\t        if(roomId < 1){\n178\t            throw new IllegalArgumentException(\"Invalid room identifier\");\n179\t        }\n180\t        StudyRoom room;\n181\t        try{\n182\t            room = roomRegistry.findRoomById(roomId);\n183\t        }catch (IllegalArgumentException e){\n184\t            throw new IllegalArgumentException(\"Study room not found.\");\n185\t        }\n186\t        if(room == null){\n187\t            throw new IllegalArgumentException(\"Study room not found.\");\n188\t        }\n189\t        if(!room.isActive()){\n190\t            throw new IllegalArgumentException(\"The room is inactive and is no longer available\");\n191\t        }\n192\t        if(!room.isOpenOnDate(date)){\n193\t            throw new IllegalArgumentException(\"The room is closed on the selected date (weekdays only)\");\n194\t        }\n195\t\n196\t        return room;\n197\t    }\n198\t\n199\t    // ------------------------------------------------------------------ UC9\n200\t    /**\n201\t      * English implementation note.\n202\t      * English implementation note.\n203\t      * English implementation note.\n204\t     */\n205\t    public void cancelReservation(Long reservationId, Long studentId) {\n206\t        Reservation reservation = reservationRegistry.findById(reservationId);\n207\t        if (reservation == null) {\n208\t            throw new IllegalArgumentException(\"Reservation not found\");\n209\t        }\n210\t        validateOwnership(reservation, studentId);\n211\t\n212\t        // English implementation note.\n213\t        // English implementation note.\n214\t        reservation.cancelReservation();\n215\t        reservationRegistry.update(reservation);\n216\t\n217\t        // sendNotification(recipients, message);\n218\t        Student recipient = reservation.getStudent();\n219\t        if (recipient != null) {\n220\t            NotificationManager notificationManager = NotificationManager.getInstance();\n221\t            notificationManager.sendNotification(List.of(notificationManager.toUserDTO(recipient)),\n222\t                        \"Reservation #\" + reservation.getId() + \" has been cancelled.\");\n223\t        }\n224\t    }\n225\t\n226\t    /** English implementation note. */\n227\t    private void validateOwnership(Reservation reservation, Long studentId) {\n228\t        Student proprietario = reservation.getStudent();\n229\t        if (studentId == null || proprietario == null\n230\t                || !proprietario.getId().equals(studentId)) {\n231\t            throw new IllegalArgumentException(\"Access to this reservation is not permitted.\");\n232\t        }\n233\t    }\n234\t\n235\t    // ------------------------------------------------------------------ UC10\n236\t    /**\n237\t      * English implementation note.\n238\t      * English implementation note.\n239\t     */\n240\t    public void performCheckIn(Long reservationId, Long studentId) {\n241\t        Reservation reservation = reservationRegistry.findById(reservationId);\n242\t        if (reservation == null) {\n243\t            throw new IllegalArgumentException(\"Reservation not found\");\n244\t        }\n245\t        validateOwnership(reservation, studentId);\n246\t\n247\t        // English implementation note.\n248\t        reservation.attach(NotificationManager.getInstance());\n249\t\n250\t        // English implementation note.\n251\t        // English implementation note.\n252\t        boolean activeOnCurrentDate;\n253\t        String denialReason = null;\n254\t        try {\n255\t            reservation.validateActiveReservationForCurrentDate();\n256\t            activeOnCurrentDate = true;\n257\t        } catch (IllegalStateException e) {\n258\t            activeOnCurrentDate = false;\n259\t            denialReason = e.getMessage();\n260\t        }\n261\t\n262\t        if (activeOnCurrentDate) {\n263\t            // English implementation note.\n264\t            reservation.performCheckIn();\n265\t            reservationRegistry.update(reservation);\n266\t\n267\t            // English implementation note.\n268\t            Student s = reservation.getStudent();\n269\t            s.setTotalVisitCount(s.getTotalVisitCount() + 1);\n270\t            userRegistry.update(s);\n271\t        } else {\n272\t            throw new IllegalStateException(\"Check-in not permitted: \" + denialReason);\n273\t        }\n274\t    }\n275\t\n276\t    // ------------------------------------------------------------------ UC12\n277\t    /** English implementation note. */\n278\t    public List<ReservationDTO> getReservationHistory(Long studentId) {\n279\t        Student student = userRegistry.findStudentById(studentId);\n280\t        if (student == null) {\n281\t            throw new IllegalArgumentException(\"Student not found\");\n282\t        }\n283\t        List<ReservationDTO> result = new ArrayList<>();\n284\t        for (Reservation p : reservationRegistry.findReservationsByStudent(student.getStudentNumber())) {\n285\t            result.add(toDTO(p));\n286\t        }\n287\t        return result;\n288\t    }\n289\t\n290\t    // ------------------------------------------------------------------ UC16\n291\t    /**\n292\t      * English implementation note.\n293\t      * English implementation note.\n294\t      * English implementation note.\n295\t     */\n296\t    public void manageReservationEnd() {\n297\t        LocalDateTime now = LocalDateTime.now(ZoneId.of(\"Europe/Rome\"));\n298\t        for (Reservation p : reservationRegistry.getEndingReservations()) {\n299\t            StatusEnum status = p.getState().getStatusEnum();\n300\t            LocalDateTime start = LocalDateTime.of(p.getDate(), p.getTimeSlot().getStartTime());\n301\t            LocalDateTime end = LocalDateTime.of(p.getDate(), p.getTimeSlot().getEndTime());\n302\t\n303\t            if (status == StatusEnum.ACTIVE && now.isAfter(start.plusMinutes(Reservation.CHECK_IN_TOLERANCE_MINUTES))) { // English implementation note.\n304\t                // English implementation note.\n305\t                p.attach(NotificationManager.getInstance());\n306\t                p.manageEnd();\n307\t                reservationRegistry.update(p);\n308\t            } else if (status == StatusEnum.CONFIRMED && now.isAfter(end)) {\n309\t                // Slot terminato: diventa COMPLETED (RF19).\n310\t                p.attach(NotificationManager.getInstance());\n311\t                p.manageEnd();\n312\t                reservationRegistry.update(p);\n313\t            }\n314\t        }\n315\t    }\n316\t\n317\t    // ------------------------------------------------------------------ UC13\n318\t    /** English implementation note. */\n319\t    public StatisticsDTO monitoraStatisticheServizio() {\n320\t        LocalDate today = LocalDate.now(ZoneId.of(\"Europe/Rome\"));\n321\t        List<Reservation> allReservations = reservationRegistry.getAll();\n322\t\n323\t        int reservationsToday = 0;\n324\t        int unconfirmedReservations = 0;\n325\t        Set<Long> occupiedSeats = new HashSet<>();\n326\t        for (Reservation p : allReservations) {\n327\t            if (!today.equals(p.getDate())) {\n328\t                continue;\n329\t            }\n330\t            StatusEnum s = p.getState().getStatusEnum();\n331\t            if (s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED || s == StatusEnum.COMPLETED) {\n332\t                reservationsToday++;\n333\t            }\n334\t            if (s == StatusEnum.ACTIVE) {\n335\t                unconfirmedReservations++;\n336\t            }\n337\t            if ((s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED) && p.getSeat() != null) {\n338\t                occupiedSeats.add(p.getSeat().getId());\n339\t            }\n340\t        }\n341\t\n342\t        int total = 0;\n343\t        for (StudyRoom room : roomRegistry.getAllRooms()) {\n344\t            total += room.getTotalSeatCount();\n345\t        }\n346\t\n347\t        StatisticsDTO dto = new StatisticsDTO();\n348\t        dto.setReservationsToday(reservationsToday);\n349\t        dto.setUnconfirmedReservations(unconfirmedReservations);\n350\t        dto.setTotalSeats(total);\n351\t        dto.setOccupiedSeatsToday(occupiedSeats.size());\n352\t        dto.setOccupancyRate(total > 0 ? (occupiedSeats.size() * 100.0 / total) : 0.0);\n353\t        return dto;\n354\t    }\n355\t\n356\t    /** English implementation note. */\n357\t    private TimeSlot resolveTimeSlot(StudyRoom room, Long timeSlotId, LocalDate date) {\n358\t        if(timeSlotId == null){\n359\t            throw new IllegalArgumentException(\"A time slot is required\");\n360\t        }\n361\t        // English implementation note.\n362\t        LocalDate today = LocalDate.now(ZoneId.of(\"Europe/Rome\"));\n363\t        if (date.isBefore(today)){\n364\t            throw new IllegalArgumentException(\"A time slot that has started or passed cannot be booked\");\n365\t        }\n366\t        for (TimeSlot f : room.getScheduledTimeSlots(date)){\n367\t            if(f.getId().equals(timeSlotId)){\n368\t                if(date.isEqual(today) && !f.getStartTime().isAfter(LocalTime.now(ZoneId.of(\"Europe/Rome\")))){\n369\t                    throw new IllegalArgumentException(\"The selected time slot is not available\");\n370\t                }\n371\t                return f;\n372\t            }\n373\t        }\n374\t        throw new IllegalArgumentException(\"The selected time slot is not available\");\n375\t    }\n376\t\n377\t    /** English implementation note. */\n378\t    private  Seat selectSeat(Long seatId, LocalDate date,\n379\t                                           TimeSlot timeSlot, List<Seat> available) {\n380\t        // English implementation note.\n381\t        // English implementation note.\n382\t        if (seatId == null){\n383\t            throw new IllegalArgumentException(\"Invalid seat identifier.\");\n384\t        }\n385\t        if (seatId < 0) {\n386\t            throw new IllegalArgumentException(\"Invalid seat identifier.\");\n387\t        } else if (seatId > 0) {\n388\t            // English implementation note.\n389\t            Seat selected = roomRegistry.findSeatById(seatId);\n390\t            if(selected == null){\n391\t                throw new IllegalArgumentException(\"Seat not found\");\n392\t            }\n393\t\n394\t            if (!selected.isAvailable(date, timeSlot)) {\n395\t                throw new IllegalStateException(\"The selected seat is no longer available\");\n396\t            }\n397\t            return selected;\n398\t        }\n399\t        // English implementation note.\n400\t        return assignmentStrategy.selectSeat(available);\n401\t    }\n402\t\n403\t    /** English implementation note. */\n404\t    private ReservationDTO toDTO(Reservation p) {\n405\t        ReservationDTO dto = new ReservationDTO();\n406\t        dto.setReservationId(p.getId());\n407\t        dto.setDate(p.getDate());\n408\t        dto.setStatus(p.getState().getStatusEnum().name());\n409\t        dto.setTimeSlot(p.getTimeSlot().getLabel());\n410\t        Seat seat = p.getSeat();\n411\t        dto.setSeatId(seat.getId());\n412\t        dto.setNumberSeat(seatNumberInArea(seat));\n413\t        dto.setRoomName(seat.getStudyRoom().getName());\n414\t        dto.setAreaType(seat.getArea() != null ? seat.getArea().getType() : \"common\");\n415\t        return dto;\n416\t    }\n417\t\n418\t    /** English implementation note. */\n419\t    private int seatNumberInArea(Seat seat) {\n420\t        Area area = seat.getArea();\n421\t        if (area == null) {\n422\t            return 0;\n423\t        }\n424\t        List<Seat> list = new ArrayList<>(StudyRoomRegistry.getInstance().getSeatsForArea(area.getId()));\n425\t        list.sort(Comparator.comparing(Seat::getId));\n426\t        for (int i = 0; i < list.size(); i++) {\n427\t            if (list.get(i).getId().equals(seat.getId())) {\n428\t                return i + 1;\n429\t            }\n430\t        }\n431\t        return 0;\n432\t    }\n433\t}\n434\tpackage it.unina.reservations.controller;\n435\t\n436\timport it.unina.reservations.dto.*;\n437\t\n438\timport java.time.LocalDate;\n439\timport java.util.List;\n440\t\n441\t/**\n442\t  * English implementation note.\n443\t  * English implementation note.\n444\t  * English implementation note.\n445\t */\n446\tpublic class LibraryFacade {\n447\t\n448\t    private static LibraryFacade instance;\n449\t\n450\t    private LibraryFacade() {}\n451\t\n452\t    public static LibraryFacade getInstance() {\n453\t        if (instance == null) {\n454\t            instance = new LibraryFacade();\n455\t        }\n456\t        return instance;\n457\t    }\n458\t\n459\t    // --- UserManager (UC1, UC2, UC8) ---\n460\t\n461\t    /**\n462\t      * English implementation note.\n463\t     * @param role \"Student\" o \"Librarian\"\n464\t     * @param name name anagrafico\n465\t     * @param surname surname anagrafico\n466\t     * @param email email istituzionale (dominio unina.it)\n467\t      * English implementation note.\n468\t      * English implementation note.\n469\t     */\n470\t    public UserDTO register(String role, String name, String surname,\n471\t                                   String email, String password, String identifier) {\n472\t        return UserManager.getInstance().register(role, name, surname, email, password, identifier);\n473\t    }\n474\t\n475\t    /**\n476\t      * English implementation note.\n477\t     * @param email email istituzionale dell'account\n478\t     * @param password password dell'account\n479\t     */\n480\t    public UserDTO authenticate(String email, String password) {\n481\t        return UserManager.getInstance().authenticate(email, password);\n482\t    }\n483\t\n484\t    /**\n485\t      * English implementation note.\n486\t      * English implementation note.\n487\t     */\n488\t    public UserDTO viewPersonalProfile(Long studentId) {\n489\t        return UserManager.getInstance().visualizzaProfilo(studentId);\n490\t    }\n491\t\n492\t    // --- StudyRoomManager (UC3, UC4, UC6, UC11) ---\n493\t\n494\t    /**\n495\t      * English implementation note.\n496\t      * English implementation note.\n497\t     */\n498\t    public StudyRoomDTO createStudyRoom(StudyRoomCreationDTO request) {\n499\t        return StudyRoomManager.getInstance().createStudyRoom(request);\n500\t    }\n501\t\n502\t    /**\n503\t      * English implementation note.\n504\t      * English implementation note.\n505\t     */\n506\t    public void deleteStudyRoom(Long studyRoomId) {\n507\t        StudyRoomManager.getInstance().deleteStudyRoom(studyRoomId);\n508\t    }\n509\t\n510\t    /**\n511\t      * English implementation note.\n512\t     * @param date day richiesto (feriale e non past)\n513\t     */\n514\t    public List<StudyRoomDTO> getAvailableStudyRooms(LocalDate date) {\n515\t        return StudyRoomManager.getInstance().getAvailableStudyRooms(date);\n516\t    }\n517\t\n518\t    /**\n519\t      * English implementation note.\n520\t      * English implementation note.\n521\t      * English implementation note.\n522\t     */\n523\t    public List<AvailableTimeSlotDTO> getAvailableTimeSlots(Long roomId, LocalDate date) {\n524\t        return StudyRoomManager.getInstance().getAvailableTimeSlots(roomId, date);\n525\t    }\n526\t\n527\t    /**\n528\t      * English implementation note.\n529\t      * English implementation note.\n530\t      * English implementation note.\n531\t      * English implementation note.\n532\t     */\n533\t    public RoomDetailDTO getRoomDetail(Long roomId, Long timeSlotId, LocalDate date) {\n534\t        return StudyRoomManager.getInstance().getRoomDetail(roomId, timeSlotId, date);\n535\t    }\n536\t\n537\t    /**\n538\t      * English implementation note.\n539\t     */\n540\t    public List<RoomMonitoringDTO> monitoraSale() {\n541\t        return StudyRoomManager.getInstance().monitoraSale();\n542\t    }\n543\t\n544\t    // --- ReservationManager (UC7, UC9, UC10, UC12, UC13, UC16) ---\n545\t\n546\t    /**\n547\t      * English implementation note.\n548\t      * English implementation note.\n549\t     */\n550\t    public ReservationDTO makeReservation(ReservationRequestDTO request) {\n551\t        return ReservationManager.getInstance().makeReservation(request);\n552\t    }\n553\t\n554\t    /**\n555\t      * English implementation note.\n556\t      * English implementation note.\n557\t      * English implementation note.\n558\t     */\n559\t    public void cancelReservation(Long reservationId, Long studentId) {\n560\t        ReservationManager.getInstance().cancelReservation(reservationId, studentId);\n561\t    }\n562\t\n563\t    /**\n564\t      * English implementation note.\n565\t      * English implementation note.\n566\t      * English implementation note.\n567\t     */\n568\t    public void performCheckIn(Long reservationId, Long studentId) {\n569\t        ReservationManager.getInstance().performCheckIn(reservationId, studentId);\n570\t    }\n571\t\n572\t    /**\n573\t      * English implementation note.\n574\t      * English implementation note.\n575\t     */\n576\t    public List<ReservationDTO> getReservationHistory(Long studentId) {\n577\t        return ReservationManager.getInstance().getReservationHistory(studentId);\n578\t    }\n579\t\n580\t    /** English implementation note. */\n581\t    public void manageReservationEnd() {\n582\t        ReservationManager.getInstance().manageReservationEnd();\n583\t    }\n584\t\n585\t    /**\n586\t      * English implementation note.\n587\t     */\n588\t    public StatisticsDTO monitoraStatisticheServizio() {\n589\t        return ReservationManager.getInstance().monitoraStatisticheServizio();\n590\t    }\n591\t\n592\t    // --- NotificationManager (UC14) ---\n593\t\n594\t    /** English implementation note. */\n595\t    public void sendReminders() {\n596\t        NotificationManager.getInstance().sendReminders();\n597\t    }\n598\t}\n599\tpackage it.unina.reservations.controller.strategy;\n600\t\n601\timport it.unina.reservations.entity.Seat;\n602\timport java.util.List;\n603\t\n604\t/**\n605\t  * English implementation note.\n606\t  * English implementation note.\n607\t */\n608\tpublic interface AssignmentStrategy {\n609\t    Seat selectSeat(List<Seat> availableSeats);\n610\t}\n611\tpackage it.unina.reservations.controller.strategy;\n612\t\n613\timport it.unina.reservations.entity.Seat;\n614\t\n615\timport java.util.List;\n616\t\n617\t/** English implementation note. */\n618\tpublic class FirstAvailableAssignment implements AssignmentStrategy {\n619\t\n620\t    /**\n621\t      * English implementation note.\n622\t      * English implementation note.\n623\t     */\n624\t    @Override\n625\t    public Seat selectSeat(List<Seat> availableSeats) {\n626\t        if (availableSeats == null || availableSeats.isEmpty()) {\n627\t            return null;\n628\t        }\n629\t        return availableSeats.getFirst();\n630\t    }\n631\t}\n632\tpackage it.unina.reservations.boundary.SpringBoot;\n633\t\n634\timport it.unina.reservations.controller.LibraryFacade;\n635\timport it.unina.reservations.dto.ReservationDTO;\n636\timport it.unina.reservations.dto.ReservationRequestDTO;\n637\timport org.springframework.format.yeartation.DateTimeFormat;\n638\timport org.springframework.web.bind.yeartation.*;\n639\t\n640\timport java.time.LocalDate;\n641\t\n642\t/**\n643\t  * English implementation note.\n644\t */\n645\t@RestController\n646\t@RequestMapping(\"/api/reservations\")\n647\tpublic class ReservationController {\n648\t\n649\t    /**\n650\t      * English implementation note.\n651\t     */\n652\t    @PostMapping(\"/create\")\n653\t    public ReservationDTO makeReservation(\n654\t            @RequestParam(\"roomId\") Long roomId,\n655\t            @RequestParam(name = \"areaId\", required = false) Long areaId,\n656\t            @RequestParam(name = \"seatId\", required = false, defaultValue = \"0\") Long seatId,\n657\t            @RequestParam(\"date\") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate date,\n658\t            @RequestParam(\"timeSlotId\") Long timeSlotId,\n659\t            @RequestParam(\"studentId\") Long studentId) {\n660\t        return LibraryFacade.getInstance().makeReservation(\n661\t                new ReservationRequestDTO(roomId, areaId, seatId, date, timeSlotId, studentId));\n662\t    }\n663\t\n664\t    /**\n665\t      * English implementation note.\n666\t     */\n667\t    @PutMapping(\"/{reservationId}/cancel\")\n668\t    public void cancelReservation(@PathVariable(\"reservationId\") Long reservationId,\n669\t                                    @RequestParam(\"studentId\") Long studentId) {\n670\t        LibraryFacade.getInstance().cancelReservation(reservationId, studentId);\n671\t    }\n672\t\n673\t    /**\n674\t      * English implementation note.\n675\t     */\n676\t    @PutMapping(\"/{reservationId}/checkIn\")\n677\t    public void performCheckIn(@PathVariable(\"reservationId\") Long reservationId,\n678\t                                @RequestParam(\"studentId\") Long studentId) {\n679\t        LibraryFacade.getInstance().performCheckIn(reservationId, studentId);\n680\t    }\n681\t}\n682\tpackage it.unina.reservations.entity;\n683\t\n684\timport it.unina.reservations.database.PersistenceManager;\n685\t\n686\timport java.time.LocalDate;\n687\timport java.util.ArrayList;\n688\timport java.util.List;\n689\timport java.util.Map;\n690\t\n691\t/**\n692\t  * English implementation note.\n693\t  * English implementation note.\n694\t */\n695\tpublic class ReservationRegistry {\n696\t\n697\t    private static ReservationRegistry instance;\n698\t    private final PersistenceManager persistenceManager;\n699\t\n700\t    private ReservationRegistry() {\n701\t        this.persistenceManager = new PersistenceManager();\n702\t    }\n703\t\n704\t    public static ReservationRegistry getInstance() {\n705\t        if (instance == null) {\n706\t            instance = new ReservationRegistry();\n707\t        }\n708\t        return instance;\n709\t    }\n710\t\n711\t    /**\n712\t      * English implementation note.\n713\t     */\n714\t    public boolean saveReservation(Reservation reservation) {\n715\t        return persistenceManager.save(reservation);\n716\t    }\n717\t\n718\t    /**\n719\t      * English implementation note.\n720\t     */\n721\t    public Reservation update(Reservation reservation) {\n722\t        return persistenceManager.update(reservation);\n723\t    }\n724\t\n725\t    /**\n726\t      * English implementation note.\n727\t     */\n728\t    public Reservation findById(Long id) {\n729\t        return persistenceManager.findById(Reservation.class, id);\n730\t    }\n731\t\n732\t    /**\n733\t      * English implementation note.\n734\t     */\n735\t    public List<Reservation> findReservationsByStudent(String studentNumber) {\n736\t        return persistenceManager.findByField(Reservation.class, \"student.studentNumber\", studentNumber);\n737\t    }\n738\t\n739\t    /**\n740\t      * English implementation note.\n741\t     */\n742\t    public List<Reservation> findActiveReservations(String studentNumber, LocalDate date) {\n743\t        List<Reservation> occupanti = new ArrayList<>();\n744\t        List<Reservation> found = persistenceManager.findByFields(\n745\t                Reservation.class,\n746\t                Map.of(\"student.studentNumber\", studentNumber, \"date\", date));\n747\t        for (Reservation p : found) {\n748\t            if (occupiesSlot(p)) {\n749\t                occupanti.add(p);\n750\t            }\n751\t        }\n752\t        return occupanti;\n753\t    }\n754\t\n755\t    /**\n756\t      * English implementation note.\n757\t     */\n758\t    public List<Reservation> findReservationsBySeat(Long seatId, LocalDate date, Long timeSlotId) {\n759\t        return persistenceManager.findByFields(\n760\t                Reservation.class,\n761\t                Map.of(\"seat.id\", seatId, \"date\", date, \"timeSlot.id\", timeSlotId));\n762\t    }\n763\t\n764\t    /**\n765\t      * English implementation note.\n766\t     */\n767\t    public List<Reservation> findReservationsByRoomAndDate(Long roomId, LocalDate date) {\n768\t        List<Reservation> result = new ArrayList<>();\n769\t        List<Reservation> found = persistenceManager.findByFields(\n770\t                Reservation.class,\n771\t                Map.of(\"seat.area.studyRoom.id\", roomId, \"date\", date));\n772\t        for (Reservation p : found) {\n773\t            if (occupiesSlot(p)) {\n774\t                result.add(p);\n775\t            }\n776\t        }\n777\t        return result;\n778\t    }\n779\t\n780\t    /**\n781\t      * English implementation note.\n782\t     */\n783\t    public List<Reservation> findAllByRoom(Long roomId) {\n784\t        return persistenceManager.findByField(Reservation.class, \"seat.area.studyRoom.id\", roomId);\n785\t    }\n786\t\n787\t    /** English implementation note. */\n788\t    public List<Reservation> getEndingReservations() {\n789\t        List<Reservation> result = new ArrayList<>();\n790\t        result.addAll(persistenceManager.findByField(Reservation.class, \"stateName\", StatusEnum.ACTIVE.name()));\n791\t        result.addAll(persistenceManager.findByField(Reservation.class, \"stateName\", StatusEnum.CONFIRMED.name()));\n792\t        return result;\n793\t    }\n794\t\n795\t    /** English implementation note. */\n796\t    public List<Reservation> getAll() {\n797\t        return persistenceManager.findByFields(Reservation.class, Map.of());\n798\t    }\n799\t\n800\t    /** English implementation note. */\n801\t    public static boolean occupiesSlot(Reservation p) {\n802\t        StatusEnum s = p.getState().getStatusEnum();\n803\t        return s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED;\n804\t    }\n805\t}\n806\tpackage it.unina.reservations.entity;\n807\t\n808\timport it.unina.reservations.entity.state.*;\n809\timport jakarta.persistence.*;\n810\timport java.time.LocalDate;\n811\timport java.time.LocalDateTime;\n812\timport java.time.ZoneId;\n813\t\n814\t/**\n815\t  * English implementation note.\n816\t  * English implementation note.\n817\t  * English implementation note.\n818\t */\n819\t@Entity\n820\t@Table(name = \"reservation\")\n821\tpublic class Reservation extends Subject {\n822\t\n823\t    /** English implementation note. */\n824\t    public static final int CHECK_IN_TOLERANCE_MINUTES = 10;\n825\t\n826\t    @Id\n827\t    @GeneratedValue(strategy = GenerationType.IDENTITY)\n828\t    private Long id;\n829\t\n830\t    private LocalDate date;\n831\t\n832\t\n833\t    // English implementation note.\n834\t    // English implementation note.\n835\t    @Column(name = \"status\", nullable = false)\n836\t    private String stateName;\n837\t\n838\t    @Transient\n839\t    private ReservationState status;\n840\t\n841\t    /** English implementation note. */\n842\t    @PostLoad\n843\t    @PostPersist\n844\t    @PostUpdate\n845\t    private void initializeState() {\n846\t        if (\"ACTIVE\".equals(stateName)) this.status = ActiveState.getInstance();\n847\t        else if (\"CANCELLED\".equals(stateName)) this.status = CancelledState.getInstance();\n848\t        else if (\"EXPIRED\".equals(stateName)) this.status = ExpiredState.getInstance();\n849\t        else if (\"CONFIRMED\".equals(stateName)) this.status = ConfirmedState.getInstance();\n850\t        else if (\"COMPLETED\".equals(stateName)) this.status = CompletedState.getInstance();\n851\t    }\n852\t\n853\t    // English implementation note.\n854\t    // English implementation note.\n855\t    @ManyToOne(fetch = FetchType.EAGER)\n856\t    @JoinColumn(name = \"student_id\", nullable = false)\n857\t    private Student student;\n858\t\n859\t    @ManyToOne(fetch = FetchType.EAGER)\n860\t    @JoinColumn(name = \"seat_id\", nullable = false)\n861\t    private Seat seat;\n862\t\n863\t    @ManyToOne(fetch = FetchType.EAGER)\n864\t    @JoinColumn(name = \"time_slot_id\", nullable = false)\n865\t    private TimeSlot timeSlot;\n866\t\n867\t    // English implementation note.\n868\t    @Column(name = \"reminder_sent\", nullable = false)\n869\t    private boolean reminderSent = false;\n870\t\n871\t    public Reservation() { /* Costruttore empty richiesto da JPA. */ }\n872\t\n873\t    // English implementation note.\n874\t    public Long getId() { return id; }\n875\t\n876\t    public LocalDate getDate() { return date; }\n877\t    public void setDate(LocalDate date) { this.date = date; }\n878\t\n879\t    public ReservationState getState() {\n880\t        if (this.status == null && this.stateName != null) initializeState();\n881\t        return status;\n882\t    }\n883\t\n884\t    /**\n885\t      * English implementation note.\n886\t     */\n887\t    public void setState(ReservationState status) {\n888\t        if (status == null) {\n889\t            throw new IllegalArgumentException(\"Reservation status cannot be null\");\n890\t        }\n891\t        this.status = status;\n892\t        this.stateName = status.getStatusEnum().name();\n893\t        notifyObservers();\n894\t    }\n895\t\n896\t    public boolean isReminderSent() {\n897\t        return reminderSent;\n898\t    }\n899\t    public void setReminderSent(boolean reminderSent) {\n900\t        this.reminderSent = reminderSent;\n901\t    }\n902\t\n903\t    // English implementation note.\n904\t\n905\t    /** English implementation note. */\n906\t    public void cancelReservation() {\n907\t        validateCancellationWindow();\n908\t        boolean cancelled = getState().cancel(this);\n909\t        if (!cancelled) {\n910\t            throw new IllegalStateException(\n911\t                    \"The reservation cannot be cancelled in its current status: \" + getState().getStatusEnum());\n912\t        }\n913\t    }\n914\t\n915\t    /** English implementation note. */\n916\t    public void performCheckIn() {\n917\t        boolean confirmed = getState().checkIn(this);\n918\t        if (!confirmed) {\n919\t            throw new IllegalStateException(\n920\t                    \"Check-in is not permitted in the current status: \" + getState().getStatusEnum());\n921\t        }\n922\t    }\n923\t\n924\t    /** English implementation note. */\n925\t    public void manageEnd() {\n926\t        getState().manageEnd(this);\n927\t    }\n928\t\n929\t    /**\n930\t      * English implementation note.\n931\t      * English implementation note.\n932\t      * English implementation note.\n933\t     */\n934\t    public void forceCancelReservation() {\n935\t        this.status = CancelledState.getInstance();\n936\t        this.stateName = this.status.getStatusEnum().name();\n937\t    }\n938\t\n939\t    /**\n940\t      * English implementation note.\n941\t      * English implementation note.\n942\t      * English implementation note.\n943\t      * English implementation note.\n944\t     */\n945\t    public void validateActiveReservationForCurrentDate() {\n946\t        if (getState() == null || getState().getStatusEnum() != StatusEnum.ACTIVE) {\n947\t            throw new IllegalStateException(\"The reservation is not in ACTIVE status\");\n948\t        }\n949\t        if (!LocalDate.now(ZoneId.of(\"Europe/Rome\")).equals(date)) {\n950\t            throw new IllegalStateException(\"Check-in is only permitted on the reservation date\");\n951\t        }\n952\t        LocalDateTime deadline = LocalDateTime.of(date, timeSlot.getStartTime())\n953\t                .plusMinutes(CHECK_IN_TOLERANCE_MINUTES);\n954\t        if (LocalDateTime.now(ZoneId.of(\"Europe/Rome\")).isAfter(deadline)) {\n955\t            throw new IllegalStateException(\"check-in tolerance of \" + CHECK_IN_TOLERANCE_MINUTES\n956\t                    + \" minutes after the time slot began has been exceeded\");\n957\t        }\n958\t    }\n959\t\n960\t    // English implementation note.\n961\t    private void validateCancellationWindow() {\n962\t        if (date == null || timeSlot == null) {\n963\t            throw new IllegalStateException(\"Reservation has no date or time slot\");\n964\t        }\n965\t        LocalDateTime start = LocalDateTime.of(date, timeSlot.getStartTime());\n966\t        if (LocalDateTime.now(ZoneId.of(\"Europe/Rome\")).isAfter(start.minusHours(6))) {\n967\t            throw new IllegalStateException(\n968\t                    \"Cancellation is not permitted less than 6 hours before the time slot starts\");\n969\t        }\n970\t    }\n971\t\n972\t    public Student getStudent() { return student; }\n973\t\n974\t    public void setStudent(Student student) {\n975\t        this.student = student;\n976\t    }\n977\t\n978\t    public Seat getSeat() { return seat; }\n979\t    public void setSeat(Seat seat) { this.seat = seat; }\n980\t\n981\t    public TimeSlot getTimeSlot() { return timeSlot; }\n982\t    public void setTimeSlot(TimeSlot timeSlot) { this.timeSlot = timeSlot; }\n983\t\n984\t    // --- Pattern Observer (Subject) ---\n985\t    @Override\n986\t    public void notifyObservers() {\n987\t        for (Observer obs : observers) {\n988\t            obs.update(this);\n989\t        }\n990\t    }\n991\t}\n992\tpackage it.unina.reservations.entity.state;\n993\t\n994\timport it.unina.reservations.entity.Reservation;\n995\t\n996\t/**\n997\t  * English implementation note.\n998\t  * English implementation note.\n999\t */\n1000\tpublic interface ReservationState {\n1001\t    boolean cancel(Reservation reservation);\n1002\t    boolean checkIn(Reservation reservation);\n1003\t    void manageEnd(Reservation reservation);\n1004\t    it.unina.reservations.entity.StatusEnum getStatusEnum();\n1005\t}\n1006\tpackage it.unina.reservations.entity.state;\n1007\t\n1008\timport it.unina.reservations.entity.Reservation;\n1009\t\n1010\t/**\n1011\t  * English implementation note.\n1012\t  * English implementation note.\n1013\t */\n1014\tpublic class ConfirmedState implements ReservationState {\n1015\t\n1016\t    private static ConfirmedState instance;\n1017\t\n1018\t    private ConfirmedState() {}\n1019\t\n1020\t    public static ConfirmedState getInstance() {\n1021\t        if (instance == null) {\n1022\t            instance = new ConfirmedState();\n1023\t        }\n1024\t        return instance;\n1025\t    }\n1026\t\n1027\t    @Override\n1028\t    public boolean cancel(Reservation p) {\n1029\t        return false;\n1030\t    }\n1031\t\n1032\t    @Override\n1033\t    public boolean checkIn(Reservation p) {\n1034\t        return false;\n1035\t    }\n1036\t\n1037\t    @Override\n1038\t    public void manageEnd(Reservation p) {\n1039\t        p.setState(CompletedState.getInstance());\n1040\t    }\n1041\t\n1042\t    @Override\n1043\t    public it.unina.reservations.entity.StatusEnum getStatusEnum() {\n1044\t        return it.unina.reservations.entity.StatusEnum.CONFIRMED;\n1045\t    }\n1046\t}\n1047\t"}]},"parent_tool_use_id":null,"session_id":"8029d137-1b9c-4d38-af2e-2dc09b578b50","uuid":"5a2cc433-82ac-46e6-89b4-f65ce0839ded","timestamp":"2026-10-10T08:48:54.063Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/miryalasathvika/.claude/projects/-Users-miryalasathvika-t2v-subjects-plain-agent-IS-seat-L2-Progetto-IS-main-English/8029d137-1b9c-4d38-af2e-2dc09b578b50/tool-results/boqmnr3xa.txt","content":"package it.unina.reservations.controller;\n\nimport it.unina.reservations.controller.strategy.FirstAvailableAssignment;\nimport it.unina.reservations.controller.strategy.AssignmentStrategy;\nimport it.unina.reservations.dto.ReservationDTO;\nimport it.unina.reservations.dto.ReservationRequestDTO;\nimport it.unina.reservations.dto.StatisticsDTO;\nimport it.unina.reservations.entity.*;\nimport it.unina.reservations.entity.state.ActiveState;\n\nimport java.time.LocalDate;\nimport java.time.LocalDateTime;\nimport java.time.LocalTime;\nimport java.time.ZoneId;\nimport java.util.*;\n\n/**\n  * English implementation note.\n * MakeReservation (UC7), CancelReservation (UC9), PerformCheckIn (UC10),\n  * English implementation note.\n  * English implementation note.\n * ({@code assignmentStrategy}).\n */\npublic class ReservationManager {\n\n    private static ReservationManager instance;\n\n    private final ReservationRegistry reservationRegistry = ReservationRegistry.getInstance();\n    private final StudyRoomRegistry roomRegistry = StudyRoomRegistry.getInstance();\n    private final UserRegistry userRegistry = UserRegistry.getInstance();\n    private AssignmentStrategy assignmentStrategy;\n\n\n    private ReservationManager() {}\n\n    public static ReservationManager getInstance() {\n        if (instance == null) {\n            instance = new ReservationManager();\n            instance.setAssignmentStrategy(new FirstAvailableAssignment());\n        }\n        return instance;\n    }\n\n\n    /** English implementation note. */\n    void setAssignmentStrategy(AssignmentStrategy assignmentStrategy){\n        this.assignmentStrategy = assignmentStrategy;\n    }\n\n    /** English implementation note. */\n    private Student resolveStudent(Long studentId){\n        Student student = userRegistry.findStudentById(studentId);\n        if(student == null){\n            throw new IllegalArgumentException(\"Student not found.\");\n        }\n        return student;\n    }\n\n\n    // ------------------------------------------------------------------ UC7\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public ReservationDTO makeReservation(ReservationRequestDTO request) {\n        Long roomId = request.getRoomId();\n        Long areaId = request.getAreaId();\n        Long seatId = request.getSeatId();\n        LocalDate date = request.getDate();\n        Long timeSlotId = request.getTimeSlotId();\n        Long studentId = request.getStudentId();\n\n        // English implementation note.\n        Student student = resolveStudent(studentId);\n        StudyRoom room = resolveRoom(roomId, date);\n        Area area = resolveArea(room, areaId);\n        TimeSlot timeSlot = resolveTimeSlot(room, timeSlotId, date);\n\n        // English implementation note.\n        validateSeatInArea(area, seatId);\n\n        // English implementation note.\n        // English implementation note.\n        synchronized (this){\n            // English implementation note.\n            validateUniqueness(student, date, timeSlot);\n\n            // English implementation note.\n            List<Seat> available = availableSeats(area, date, timeSlot);\n\n            // English implementation note.\n            Seat seat = selectSeat(seatId, date, timeSlot, available);\n\n            // English implementation note.\n            Reservation reservation = createAndSave(student, date, timeSlot, seat);\n            // English implementation note.\n            //    e non si notify reservations mai saved.\n            notifyReservation(reservation);\n            return toDTO(reservation);\n        }\n\n    }\n\n    private void validateSeatInArea(Area area, Long seatId) {\n        if(seatId == null){\n            throw new IllegalArgumentException(\"Seat not provided\");\n        }\n        if(seatId != 0){\n            Seat seat = roomRegistry.findSeatById(seatId);\n            if(seat == null){\n                throw new IllegalArgumentException(\"Invalid seat identifier.\");\n            }\n            // English implementation note.\n            if(!area.getId().equals(seat.getArea().getId())){\n                throw new IllegalArgumentException(\"The seat is not in the selected area\");\n            }\n        }\n    }\n\n    private void notifyReservation(Reservation reservation) {\n        reservation.attach(NotificationManager.getInstance());\n        reservation.notifyObservers();\n    }\n\n    private Reservation createAndSave(Student student, LocalDate date, TimeSlot timeSlot, Seat seat) {\n\n        Reservation reservation = new Reservation();\n        reservation.setDate(date);\n        reservation.setTimeSlot(timeSlot);\n        reservation.setSeat(seat);\n        reservation.setStudent(student); // English implementation note.\n        reservation.setState(ActiveState.getInstance());\n\n        boolean success = reservationRegistry.saveReservation(reservation);\n        if (!success){\n            throw new RuntimeException(\"Server error: the reservation could not be saved. Please try again.\");\n        }\n\n        return reservation;\n    }\n\n    private List<Seat> availableSeats(Area area, LocalDate date, TimeSlot timeSlot) {\n        // English implementation note.\n        List<Seat> available = area.getAvailableSeats(date, timeSlot);\n        if(available.isEmpty()){\n            throw new IllegalArgumentException(\"No seats are available in the selected area\");\n        }\n        return available;\n    }\n\n    private void validateUniqueness(Student student, LocalDate date, TimeSlot timeSlot) {\n        if(student.hasActiveOrConfirmedReservationForDateAndSlot(date, timeSlot.getLabel())){\n            throw new IllegalArgumentException(\"You already have an active or confirmed reservation for this date and time slot\");\n        }\n    }\n\n    private Area resolveArea(StudyRoom room, Long areaId) {\n        if (areaId == null) {\n            throw new IllegalArgumentException(\"Area not specified\");\n        }\n        if (areaId < 1){\n            throw new IllegalArgumentException(\"Invalid area identifier.\");\n        }\n\n        Area area = roomRegistry.findAreaById(areaId);\n        if(area == null || !area.getStudyRoom().getId().equals(room.getId())){\n            throw new IllegalArgumentException(\"The area is not in the selected room\");\n        }\n\n        return area;\n    }\n\n    private StudyRoom resolveRoom(Long roomId, LocalDate date) {\n        if(roomId == null){\n            throw new IllegalArgumentException(\"A study room must be selected\");\n        }\n        if(roomId < 1){\n            throw new IllegalArgumentException(\"Invalid room identifier\");\n        }\n        StudyRoom room;\n        try{\n            room = roomRegistry.findRoomById(roomId);\n        }catch (IllegalArgumentException e){\n            throw new IllegalArgumentException(\"Study room not found.\");\n        }\n        if(room == null){\n            throw new IllegalArgumentException(\"Study room not found.\");\n        }\n        if(!room.isActive()){\n            throw new IllegalArgumentException(\"The room is inactive and is no longer available\");\n        }\n        if(!room.isOpenOnDate(date)){\n            throw new IllegalArgumentException(\"The room is closed on the selected date (weekdays only)\");\n        }\n\n        return room;\n    }\n\n    // ------------------------------------------------------------------ UC9\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void cancelReservation(Long reservationId, Long studentId) {\n        Reservation reservation = reservationRegistry.findById(reservationId);\n        if (reservation == null) {\n            throw new IllegalArgumentException(\"Reservation not found\");\n        }\n        validateOwnership(reservation, studentId);\n\n        // English implementation note.\n        // English implementation note.\n        reservation.cancelReservation();\n        reservationRegistry.update(reservation);\n\n        // sendNotification(recipients, message);\n        Student recipient = reservation.getStudent();\n        if (recipient != null) {\n            NotificationManager notificationManager = NotificationManager.getInstance();\n            notificationManager.sendNotification(List.of(notificationManager.toUserDTO(recipient)),\n                        \"Reservation #\" + reservation.getId() + \" has been cancelled.\");\n        }\n    }\n\n    /** English implementation note. */\n    private void validateOwnership(Reservation reservation, Long studentId) {\n        Student proprietario = reservation.getStudent();\n        if (studentId == null || proprietario == null\n                || !proprietario.getId().equals(studentId)) {\n            throw new IllegalArgumentException(\"Access to this reservation is not permitted.\");\n        }\n    }\n\n    // ------------------------------------------------------------------ UC10\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public void performCheckIn(Long reservationId, Long studentId) {\n        Reservation reservation = reservationRegistry.findById(reservationId);\n        if (reservation == null) {\n            throw new IllegalArgumentException(\"Reservation not found\");\n        }\n        validateOwnership(reservation, studentId);\n\n        // English implementation note.\n        reservation.attach(NotificationManager.getInstance());\n\n        // English implementation note.\n        // English implementation note.\n        boolean activeOnCurrentDate;\n        String denialReason = null;\n        try {\n            reservation.validateActiveReservationForCurrentDate();\n            activeOnCurrentDate = true;\n        } catch (IllegalStateException e) {\n            activeOnCurrentDate = false;\n            denialReason = e.getMessage();\n        }\n\n        if (activeOnCurrentDate) {\n            // English implementation note.\n            reservation.performCheckIn();\n            reservationRegistry.update(reservation);\n\n            // English implementation note.\n            Student s = reservation.getStudent();\n            s.setTotalVisitCount(s.getTotalVisitCount() + 1);\n            userRegistry.update(s);\n        } else {\n            throw new IllegalStateException(\"Check-in not permitted: \" + denialReason);\n        }\n    }\n\n    // ------------------------------------------------------------------ UC12\n    /** English implementation note. */\n    public List<ReservationDTO> getReservationHistory(Long studentId) {\n        Student student = userRegistry.findStudentById(studentId);\n        if (student == null) {\n            throw new IllegalArgumentException(\"Student not found\");\n        }\n        List<ReservationDTO> result = new ArrayList<>();\n        for (Reservation p : reservationRegistry.findReservationsByStudent(student.getStudentNumber())) {\n            result.add(toDTO(p));\n        }\n        return result;\n    }\n\n    // ------------------------------------------------------------------ UC16\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void manageReservationEnd() {\n        LocalDateTime now = LocalDateTime.now(ZoneId.of(\"Europe/Rome\"));\n        for (Reservation p : reservationRegistry.getEndingReservations()) {\n            StatusEnum status = p.getState().getStatusEnum();\n            LocalDateTime start = LocalDateTime.of(p.getDate(), p.getTimeSlot().getStartTime());\n            LocalDateTime end = LocalDateTime.of(p.getDate(), p.getTimeSlot().getEndTime());\n\n            if (status == StatusEnum.ACTIVE && now.isAfter(start.plusMinutes(Reservation.CHECK_IN_TOLERANCE_MINUTES))) { // English implementation note.\n                // English implementation note.\n                p.attach(NotificationManager.getInstance());\n                p.manageEnd();\n                reservationRegistry.update(p);\n            } else if (status == StatusEnum.CONFIRMED && now.isAfter(end)) {\n                // Slot terminato: diventa COMPLETED (RF19).\n                p.attach(NotificationManager.getInstance());\n                p.manageEnd();\n                reservationRegistry.update(p);\n            }\n        }\n    }\n\n    // ------------------------------------------------------------------ UC13\n    /** English implementation note. */\n    public StatisticsDTO monitoraStatisticheServizio() {\n        LocalDate today = LocalDate.now(ZoneId.of(\"Europe/Rome\"));\n        List<Reservation> allReservations = reservationRegistry.getAll();\n\n        int reservationsToday = 0;\n        int unconfirmedReservations = 0;\n        Set<Long> occupiedSeats = new HashSet<>();\n        for (Reservation p : allReservations) {\n            if (!today.equals(p.getDate())) {\n                continue;\n            }\n            StatusEnum s = p.getState().getStatusEnum();\n            if (s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED || s == StatusEnum.COMPLETED) {\n                reservationsToday++;\n            }\n            if (s == StatusEnum.ACTIVE) {\n                unconfirmedReservations++;\n            }\n            if ((s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED) && p.getSeat() != null) {\n                occupiedSeats.add(p.getSeat().getId());\n            }\n        }\n\n        int total = 0;\n        for (StudyRoom room : roomRegistry.getAllRooms()) {\n            total += room.getTotalSeatCount();\n        }\n\n        StatisticsDTO dto = new StatisticsDTO();\n        dto.setReservationsToday(reservationsToday);\n        dto.setUnconfirmedReservations(unconfirmedReservations);\n        dto.setTotalSeats(total);\n        dto.setOccupiedSeatsToday(occupiedSeats.size());\n        dto.setOccupancyRate(total > 0 ? (occupiedSeats.size() * 100.0 / total) : 0.0);\n        return dto;\n    }\n\n    /** English implementation note. */\n    private TimeSlot resolveTimeSlot(StudyRoom room, Long timeSlotId, LocalDate date) {\n        if(timeSlotId == null){\n            throw new IllegalArgumentException(\"A time slot is required\");\n        }\n        // English implementation note.\n        LocalDate today = LocalDate.now(ZoneId.of(\"Europe/Rome\"));\n        if (date.isBefore(today)){\n            throw new IllegalArgumentException(\"A time slot that has started or passed cannot be booked\");\n        }\n        for (TimeSlot f : room.getScheduledTimeSlots(date)){\n            if(f.getId().equals(timeSlotId)){\n                if(date.isEqual(today) && !f.getStartTime().isAfter(LocalTime.now(ZoneId.of(\"Europe/Rome\")))){\n                    throw new IllegalArgumentException(\"The selected time slot is not available\");\n                }\n                return f;\n            }\n        }\n        throw new IllegalArgumentException(\"The selected time slot is not available\");\n    }\n\n    /** English implementation note. */\n    private  Seat selectSeat(Long seatId, LocalDate date,\n                                           TimeSlot timeSlot, List<Seat> available) {\n        // English implementation note.\n        // English implementation note.\n        if (seatId == null){\n            throw new IllegalArgumentException(\"Invalid seat identifier.\");\n        }\n        if (seatId < 0) {\n            throw new IllegalArgumentException(\"Invalid seat identifier.\");\n        } else if (seatId > 0) {\n            // English implementation note.\n            Seat selected = roomRegistry.findSeatById(seatId);\n            if(selected == null){\n                throw new IllegalArgumentException(\"Seat not found\");\n            }\n\n            if (!selected.isAvailable(date, timeSlot)) {\n                throw new IllegalStateException(\"The selected seat is no longer available\");\n            }\n            return selected;\n        }\n        // English implementation note.\n        return assignmentStrategy.selectSeat(available);\n    }\n\n    /** English implementation note. */\n    private ReservationDTO toDTO(Reservation p) {\n        ReservationDTO dto = new ReservationDTO();\n        dto.setReservationId(p.getId());\n        dto.setDate(p.getDate());\n        dto.setStatus(p.getState().getStatusEnum().name());\n        dto.setTimeSlot(p.getTimeSlot().getLabel());\n        Seat seat = p.getSeat();\n        dto.setSeatId(seat.getId());\n        dto.setNumberSeat(seatNumberInArea(seat));\n        dto.setRoomName(seat.getStudyRoom().getName());\n        dto.setAreaType(seat.getArea() != null ? seat.getArea().getType() : \"common\");\n        return dto;\n    }\n\n    /** English implementation note. */\n    private int seatNumberInArea(Seat seat) {\n        Area area = seat.getArea();\n        if (area == null) {\n            return 0;\n        }\n        List<Seat> list = new ArrayList<>(StudyRoomRegistry.getInstance().getSeatsForArea(area.getId()));\n        list.sort(Comparator.comparing(Seat::getId));\n        for (int i = 0; i < list.size(); i++) {\n            if (list.get(i).getId().equals(seat.getId())) {\n                return i + 1;\n            }\n        }\n        return 0;\n    }\n}\npackage it.unina.reservations.controller;\n\nimport it.unina.reservations.dto.*;\n\nimport java.time.LocalDate;\nimport java.util.List;\n\n/**\n  * English implementation note.\n  * English implementation note.\n  * English implementation note.\n */\npublic class LibraryFacade {\n\n    private static LibraryFacade instance;\n\n    private LibraryFacade() {}\n\n    public static LibraryFacade getInstance() {\n        if (instance == null) {\n            instance = new LibraryFacade();\n        }\n        return instance;\n    }\n\n    // --- UserManager (UC1, UC2, UC8) ---\n\n    /**\n      * English implementation note.\n     * @param role \"Student\" o \"Librarian\"\n     * @param name name anagrafico\n     * @param surname surname anagrafico\n     * @param email email istituzionale (dominio unina.it)\n      * English implementation note.\n      * English implementation note.\n     */\n    public UserDTO register(String role, String name, String surname,\n                                   String email, String password, String identifier) {\n        return UserManager.getInstance().register(role, name, surname, email, password, identifier);\n    }\n\n    /**\n      * English implementation note.\n     * @param email email istituzionale dell'account\n     * @param password password dell'account\n     */\n    public UserDTO authenticate(String email, String password) {\n        return UserManager.getInstance().authenticate(email, password);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public UserDTO viewPersonalProfile(Long studentId) {\n        return UserManager.getInstance().visualizzaProfilo(studentId);\n    }\n\n    // --- StudyRoomManager (UC3, UC4, UC6, UC11) ---\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public StudyRoomDTO createStudyRoom(StudyRoomCreationDTO request) {\n        return StudyRoomManager.getInstance().createStudyRoom(request);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public void deleteStudyRoom(Long studyRoomId) {\n        StudyRoomManager.getInstance().deleteStudyRoom(studyRoomId);\n    }\n\n    /**\n      * English implementation note.\n     * @param date day richiesto (feriale e non past)\n     */\n    public List<StudyRoomDTO> getAvailableStudyRooms(LocalDate date) {\n        return StudyRoomManager.getInstance().getAvailableStudyRooms(date);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public List<AvailableTimeSlotDTO> getAvailableTimeSlots(Long roomId, LocalDate date) {\n        return StudyRoomManager.getInstance().getAvailableTimeSlots(roomId, date);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public RoomDetailDTO getRoomDetail(Long roomId, Long timeSlotId, LocalDate date) {\n        return StudyRoomManager.getInstance().getRoomDetail(roomId, timeSlotId, date);\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<RoomMonitoringDTO> monitoraSale() {\n        return StudyRoomManager.getInstance().monitoraSale();\n    }\n\n    // --- ReservationManager (UC7, UC9, UC10, UC12, UC13, UC16) ---\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public ReservationDTO makeReservation(ReservationRequestDTO request) {\n        return ReservationManager.getInstance().makeReservation(request);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void cancelReservation(Long reservationId, Long studentId) {\n        ReservationManager.getInstance().cancelReservation(reservationId, studentId);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void performCheckIn(Long reservationId, Long studentId) {\n        ReservationManager.getInstance().performCheckIn(reservationId, studentId);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    public List<ReservationDTO> getReservationHistory(Long studentId) {\n        return ReservationManager.getInstance().getReservationHistory(studentId);\n    }\n\n    /** English implementation note. */\n    public void manageReservationEnd() {\n        ReservationManager.getInstance().manageReservationEnd();\n    }\n\n    /**\n      * English implementation note.\n     */\n    public StatisticsDTO monitoraStatisticheServizio() {\n        return ReservationManager.getInstance().monitoraStatisticheServizio();\n    }\n\n    // --- NotificationManager (UC14) ---\n\n    /** English implementation note. */\n    public void sendReminders() {\n        NotificationManager.getInstance().sendReminders();\n    }\n}\npackage it.unina.reservations.controller.strategy;\n\nimport it.unina.reservations.entity.Seat;\nimport java.util.List;\n\n/**\n  * English implementation note.\n  * English implementation note.\n */\npublic interface AssignmentStrategy {\n    Seat selectSeat(List<Seat> availableSeats);\n}\npackage it.unina.reservations.controller.strategy;\n\nimport it.unina.reservations.entity.Seat;\n\nimport java.util.List;\n\n/** English implementation note. */\npublic class FirstAvailableAssignment implements AssignmentStrategy {\n\n    /**\n      * English implementation note.\n      * English implementation note.\n     */\n    @Override\n    public Seat selectSeat(List<Seat> availableSeats) {\n        if (availableSeats == null || availableSeats.isEmpty()) {\n            return null;\n        }\n        return availableSeats.getFirst();\n    }\n}\npackage it.unina.reservations.boundary.SpringBoot;\n\nimport it.unina.reservations.controller.LibraryFacade;\nimport it.unina.reservations.dto.ReservationDTO;\nimport it.unina.reservations.dto.ReservationRequestDTO;\nimport org.springframework.format.yeartation.DateTimeFormat;\nimport org.springframework.web.bind.yeartation.*;\n\nimport java.time.LocalDate;\n\n/**\n  * English implementation note.\n */\n@RestController\n@RequestMapping(\"/api/reservations\")\npublic class ReservationController {\n\n    /**\n      * English implementation note.\n     */\n    @PostMapping(\"/create\")\n    public ReservationDTO makeReservation(\n            @RequestParam(\"roomId\") Long roomId,\n            @RequestParam(name = \"areaId\", required = false) Long areaId,\n            @RequestParam(name = \"seatId\", required = false, defaultValue = \"0\") Long seatId,\n            @RequestParam(\"date\") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate date,\n            @RequestParam(\"timeSlotId\") Long timeSlotId,\n            @RequestParam(\"studentId\") Long studentId) {\n        return LibraryFacade.getInstance().makeReservation(\n                new ReservationRequestDTO(roomId, areaId, seatId, date, timeSlotId, studentId));\n    }\n\n    /**\n      * English implementation note.\n     */\n    @PutMapping(\"/{reservationId}/cancel\")\n    public void cancelReservation(@PathVariable(\"reservationId\") Long reservationId,\n                                    @RequestParam(\"studentId\") Long studentId) {\n        LibraryFacade.getInstance().cancelReservation(reservationId, studentId);\n    }\n\n    /**\n      * English implementation note.\n     */\n    @PutMapping(\"/{reservationId}/checkIn\")\n    public void performCheckIn(@PathVariable(\"reservationId\") Long reservationId,\n                                @RequestParam(\"studentId\") Long studentId) {\n        LibraryFacade.getInstance().performCheckIn(reservationId, studentId);\n    }\n}\npackage it.unina.reservations.entity;\n\nimport it.unina.reservations.database.PersistenceManager;\n\nimport java.time.LocalDate;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n  * English implementation note.\n  * English implementation note.\n */\npublic class ReservationRegistry {\n\n    private static ReservationRegistry instance;\n    private final PersistenceManager persistenceManager;\n\n    private ReservationRegistry() {\n        this.persistenceManager = new PersistenceManager();\n    }\n\n    public static ReservationRegistry getInstance() {\n        if (instance == null) {\n            instance = new ReservationRegistry();\n        }\n        return instance;\n    }\n\n    /**\n      * English implementation note.\n     */\n    public boolean saveReservation(Reservation reservation) {\n        return persistenceManager.save(reservation);\n    }\n\n    /**\n      * English implementation note.\n     */\n    public Reservation update(Reservation reservation) {\n        return persistenceManager.update(reservation);\n    }\n\n    /**\n      * English implementation note.\n     */\n    public Reservation findById(Long id) {\n        return persistenceManager.findById(Reservation.class, id);\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<Reservation> findReservationsByStudent(String studentNumber) {\n        return persistenceManager.findByField(Reservation.class, \"student.studentNumber\", studentNumber);\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<Reservation> findActiveReservations(String studentNumber, LocalDate date) {\n        List<Reservation> occupanti = new ArrayList<>();\n        List<Reservation> found = persistenceManager.findByFields(\n                Reservation.class,\n                Map.of(\"student.studentNumber\", studentNumber, \"date\", date));\n        for (Reservation p : found) {\n            if (occupiesSlot(p)) {\n                occupanti.add(p);\n            }\n        }\n        return occupanti;\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<Reservation> findReservationsBySeat(Long seatId, LocalDate date, Long timeSlotId) {\n        return persistenceManager.findByFields(\n                Reservation.class,\n                Map.of(\"seat.id\", seatId, \"date\", date, \"timeSlot.id\", timeSlotId));\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<Reservation> findReservationsByRoomAndDate(Long roomId, LocalDate date) {\n        List<Reservation> result = new ArrayList<>();\n        List<Reservation> found = persistenceManager.findByFields(\n                Reservation.class,\n                Map.of(\"seat.area.studyRoom.id\", roomId, \"date\", date));\n        for (Reservation p : found) {\n            if (occupiesSlot(p)) {\n                result.add(p);\n            }\n        }\n        return result;\n    }\n\n    /**\n      * English implementation note.\n     */\n    public List<Reservation> findAllByRoom(Long roomId) {\n        return persistenceManager.findByField(Reservation.class, \"seat.area.studyRoom.id\", roomId);\n    }\n\n    /** English implementation note. */\n    public List<Reservation> getEndingReservations() {\n        List<Reservation> result = new ArrayList<>();\n        result.addAll(persistenceManager.findByField(Reservation.class, \"stateName\", StatusEnum.ACTIVE.name()));\n        result.addAll(persistenceManager.findByField(Reservation.class, \"stateName\", StatusEnum.CONFIRMED.name()));\n        return result;\n    }\n\n    /** English implementation note. */\n    public List<Reservation> getAll() {\n        return persistenceManager.findByFields(Reservation.class, Map.of());\n    }\n\n    /** English implementation note. */\n    public static boolean occupiesSlot(Reservation p) {\n        StatusEnum s = p.getState().getStatusEnum();\n        return s == StatusEnum.ACTIVE || s == StatusEnum.CONFIRMED;\n    }\n}\npackage it.unina.reservations.entity;\n\nimport it.unina.reservations.entity.state.*;\nimport jakarta.persistence.*;\nimport java.time.LocalDate;\nimport java.time.LocalDateTime;\nimport java.time.ZoneId;\n\n/**\n  * English implementation note.\n  * English implementation note.\n  * English implementation note.\n */\n@Entity\n@Table(name = \"reservation\")\npublic class Reservation extends Subject {\n\n    /** English implementation note. */\n    public static final int CHECK_IN_TOLERANCE_MINUTES = 10;\n\n    @Id\n    @GeneratedValue(strategy = GenerationType.IDENTITY)\n    private Long id;\n\n    private LocalDate date;\n\n\n    // English implementation note.\n    // English implementation note.\n    @Column(name = \"status\", nullable = false)\n    private String stateName;\n\n    @Transient\n    private ReservationState status;\n\n    /** English implementation note. */\n    @PostLoad\n    @PostPersist\n    @PostUpdate\n    private void initializeState() {\n        if (\"ACTIVE\".equals(stateName)) this.status = ActiveState.getInstance();\n        else if (\"CANCELLED\".equals(stateName)) this.status = CancelledState.getInstance();\n        else if (\"EXPIRED\".equals(stateName)) this.status = ExpiredState.getInstance();\n        else if (\"CONFIRMED\".equals(stateName)) this.status = ConfirmedState.getInstance();\n        else if (\"COMPLETED\".equals(stateName)) this.status = CompletedState.getInstance();\n    }\n\n    // English implementation note.\n    // English implementation note.\n    @ManyToOne(fetch = FetchType.EAGER)\n    @JoinColumn(name = \"student_id\", nullable = false)\n    private Student student;\n\n    @ManyToOne(fetch = FetchType.EAGER)\n    @JoinColumn(name = \"seat_id\", nullable = false)\n    private Seat seat;\n\n    @ManyToOne(fetch = FetchType.EAGER)\n    @JoinColumn(name = \"time_slot_id\", nullable = false)\n    private TimeSlot timeSlot;\n\n    // English implementation note.\n    @Column(name = \"reminder_sent\", nullable = false)\n    private boolean reminderSent = false;\n\n    public Reservation() { /* Costruttore empty richiesto da JPA. */ }\n\n    // English implementation note.\n    public Long getId() { return id; }\n\n    public LocalDate getDate() { return date; }\n    public void setDate(LocalDate date) { this.date = date; }\n\n    public ReservationState getState() {\n        if (this.status == null && this.stateName != null) initializeState();\n        return status;\n    }\n\n    /**\n      * English implementation note.\n     */\n    public void setState(ReservationState status) {\n        if (status == null) {\n            throw new IllegalArgumentException(\"Reservation status cannot be null\");\n        }\n        this.status = status;\n        this.stateName = status.getStatusEnum().name();\n        notifyObservers();\n    }\n\n    public boolean isReminderSent() {\n        return reminderSent;\n    }\n    public void setReminderSent(boolean reminderSent) {\n        this.reminderSent = reminderSent;\n    }\n\n    // English implementation note.\n\n    /** English implementation note. */\n    public void cancelReservation() {\n        validateCancellationWindow();\n        boolean cancelled = getState().cancel(this);\n        if (!cancelled) {\n            throw new IllegalStateException(\n                    \"The reservation cannot be cancelled in its current status: \" + getState().getStatusEnum());\n        }\n    }\n\n    /** English implementation note. */\n    public void performCheckIn() {\n        boolean confirmed = getState().checkIn(this);\n        if (!confirmed) {\n            throw new IllegalStateException(\n                    \"Check-in is not permitted in the current status: \" + getState().getStatusEnum());\n        }\n    }\n\n    /** English implementation note. */\n    public void manageEnd() {\n        getState().manageEnd(this);\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void forceCancelReservation() {\n        this.status = CancelledState.getInstance();\n        this.stateName = this.status.getStatusEnum().name();\n    }\n\n    /**\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n      * English implementation note.\n     */\n    public void validateActiveReservationForCurrentDate() {\n        if (getState() == null || getState().getStatusEnum() != StatusEnum.ACTIVE) {\n            throw new IllegalStateException(\"The reservation is not in ACTIVE status\");\n        }\n        if (!LocalDate.now(ZoneId.of(\"Europe/Rome\")).equals(date)) {\n            throw new IllegalStateException(\"Check-in is only permitted on the reservation date\");\n        }\n        LocalDateTime deadline = LocalDateTime.of(date, timeSlot.getStartTime())\n                .plusMinutes(CHECK_IN_TOLERANCE_MINUTES);\n        if (LocalDateTime.now(ZoneId.of(\"Europe/Rome\")).isAfter(deadline)) {\n            throw new IllegalStateException(\"check-in tolerance of \" + CHECK_IN_TOLERANCE_MINUTES\n                    + \" minutes after the time slot began has been exceeded\");\n        }\n    }\n\n    // English implementation note.\n    private void validateCancellationWindow() {\n        if (date == null || timeSlot == null) {\n            throw new IllegalStateException(\"Reservation has no date or time slot\");\n        }\n        LocalDateTime start = LocalDateTime.of(date, timeSlot.getStartTime());\n        if (LocalDateTime.now(ZoneId.of(\"Europe/Rome\")).isAfter(start.minusHours(6))) {\n            throw new IllegalStateException(\n                    \"Cancellation is not permitted less than 6 hours before the time slot starts\");\n        }\n    }\n\n    public Student getStudent() { return student; }\n\n    public void setStudent(Student s