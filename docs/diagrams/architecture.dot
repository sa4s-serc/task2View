digraph task2view_phases {
  graph [
    rankdir=TB
    newrank=true
    splines=true
    nodesep=0.36
    ranksep=0.55
    fontname="Helvetica"
    fontsize=13
    pad=0.28
    bgcolor="white"
    label=<<B>Task2View</B> — research-plan phases with current implementation<br/><FONT POINT-SIZE="10" COLOR="#475569">Same eight phases as Figure 1. Blue = Gemini agent · orange = deterministic / plug-in · gold = catalogs · green = run artifact</FONT>>
    labelloc=t
    fontcolor="#0f172a"
  ];
  node [fontname="Helvetica", fontsize=9, shape=plaintext, margin=0];
  edge [color="#475569", arrowsize=0.65, penwidth=1.2];

  in1 [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#334155">
      <TR><TD BGCOLOR="#334155"><FONT COLOR="white"><B>Input 1</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#f1f5f9" ALIGN="CENTER">Stakeholder / task goal<BR/><FONT POINT-SIZE="8">--goal  free text</FONT></TD></TR>
    </TABLE>>];

  kb [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#a16207">
      <TR><TD BGCOLOR="#a16207"><FONT COLOR="white"><B>Knowledge base</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#fef9c3" ALIGN="CENTER">stakeholders · concerns · viewpoints<BR/>task cues · required information</TD></TR>
    </TABLE>>];

  subgraph cluster_need {
    label=<<B>Phases 1–3</B> — from the need to a viewpoint>;
    fontsize=11;
    fontcolor="#1e3a8a";
    color="#2563eb";
    style=rounded;
    penwidth=1.6;
    margin=14;

    p1 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
        <TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>Phase 1</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#dbeafe" ALIGN="CENTER"><B>Stakeholder-Task<BR/>Interpretation</B></TD></TR>
        <TR><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT POINT-SIZE="8">interpret agent (Gemini)<BR/>maps free text to a catalog role</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">stakeholder_task_profile.json</FONT></TD></TR>
      </TABLE>>];

    p2 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
        <TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>Phase 2</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#dbeafe" ALIGN="CENTER"><B>Concern and<BR/>Architectural Questions</B></TD></TR>
        <TR><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT POINT-SIZE="8">questions agent (Gemini)<BR/>seeded from the selected viewpoint</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">architectural_questions.json</FONT></TD></TR>
      </TABLE>>];

    p3 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
        <TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>Phase 3</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#dbeafe" ALIGN="CENTER"><B>Knowledge-Grounded<BR/>Viewpoint Planning</B></TD></TR>
        <TR><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT POINT-SIZE="8">catalog ranks viewpoints (no LLM)<BR/>then viewpoint agent confirms</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">viewpoint_plan.json</FONT></TD></TR>
      </TABLE>>];

    { rank=same; p1; p2; p3; }
    p1 -> p2 -> p3;
  }

  subgraph cluster_repo {
    label=<<B>Phases 4–8</B> — plan where to look, then extract, generate, validate>;
    fontsize=11;
    fontcolor="#9a3412";
    color="#c2410c";
    style=rounded;
    penwidth=1.6;
    margin=14;

    in2 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#334155">
        <TR><TD BGCOLOR="#334155"><FONT COLOR="white"><B>Input 2</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#f1f5f9" ALIGN="CENTER">Software repository<BR/><FONT POINT-SIZE="8">--code  local path</FONT></TD></TR>
      </TABLE>>];

    p4 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#c2410c">
        <TR><TD BGCOLOR="#c2410c"><FONT COLOR="white"><B>Phase 4</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ffedd5" ALIGN="CENTER"><B>Repository Analysis</B></TD></TR>
        <TR><TD BGCOLOR="#fff7ed" ALIGN="LEFT"><FONT POINT-SIZE="8">drop binaries · file graph<BR/>scoper: composite / pagerank / …</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">repository_scope.json</FONT></TD></TR>
      </TABLE>>];

    p5 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
        <TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>Phase 5</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#dbeafe" ALIGN="CENTER"><B>Evidence Extraction<BR/>and Grounding</B></TD></TR>
        <TR><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT POINT-SIZE="8">extractor: gemini / ciao / archagent<BR/>ground claims on scoped files</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">view_model.json</FONT></TD></TR>
      </TABLE>>];

    p6 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1d4ed8">
        <TR><TD BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>Phase 6</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#dbeafe" ALIGN="CENTER"><B>Need–Evidence<BR/>Reconciliation</B></TD></TR>
        <TR><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT POINT-SIZE="8">critic (Gemini) · notes only<BR/>does not rewrite the viewpoint</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">structure_report.json</FONT></TD></TR>
      </TABLE>>];

    p7 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#c2410c">
        <TR><TD BGCOLOR="#c2410c"><FONT COLOR="white"><B>Phase 7</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ffedd5" ALIGN="CENTER"><B>Specialized View<BR/>Generation</B></TD></TR>
        <TR><TD BGCOLOR="#fff7ed" ALIGN="LEFT"><FONT POINT-SIZE="8">notation adapter<BR/>PlantUML / Mermaid / …</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">architecture_view.puml</FONT></TD></TR>
      </TABLE>>];

    p8 [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#c2410c">
        <TR><TD BGCOLOR="#c2410c"><FONT COLOR="white"><B>Phase 8</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#ffedd5" ALIGN="CENTER"><B>Validation and<BR/>Consistency</B></TD></TR>
        <TR><TD BGCOLOR="#fff7ed" ALIGN="LEFT"><FONT POINT-SIZE="8">drop names without evidence<BR/>compile SVG / PNG / JPEG</FONT></TD></TR>
        <TR><TD BGCOLOR="#dcfce7" ALIGN="LEFT"><FONT POINT-SIZE="8">validation_report.json</FONT></TD></TR>
      </TABLE>>];

    { rank=same; in2; p4; p5; p6; p7; p8; }
    in2 -> p4 -> p5 -> p6 -> p7 -> p8;
  }

  out [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#15803d">
      <TR><TD BGCOLOR="#15803d"><FONT COLOR="white"><B>Output</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#dcfce7" ALIGN="CENTER">Stakeholder-task view</TD></TR>
    </TABLE>>];

  { rank=same; in1; kb; }
  in1 -> p1;
  kb -> p2 [style=dashed, color="#ca8a04"];
  kb -> p3 [style=dashed, color="#ca8a04"];
  p3 -> p4 [color="#1d4ed8", penwidth=1.8];
  p8 -> out;
}
