digraph pipeline_v2 {
  rankdir=TB;
  bgcolor="white";
  compound=true;
  nodesep=0.30;
  ranksep=0.38;
  fontname="Helvetica";
  labelloc="t";
  label=<<b>Task2View pipeline v2</b><br/><font point-size="11" color="#64748b">red = new or changed from v1</font><br/> >;
  fontsize=18;

  node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.4, margin="0.14,0.08"];
  edge [color="#64748b", arrowsize=0.75];

  input [label="repository  +  stakeholder  +  task", fillcolor="#f1f5f9", color="#94a3b8"];

  legend [shape=plaintext, fillcolor="none", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr><td bgcolor="#dbeafe">LLM step</td>
          <td bgcolor="#ffedd5">deterministic</td>
          <td bgcolor="#dcfce7">artifact</td>
          <td bgcolor="#fef9c3">knowledge</td></tr>
    </table>>];

  // ---------- phase 1+2 ----------
  subgraph cluster_p12 {
    label=<  <b>PHASE 1 + 2</b>  ·  interpret the need  >;
    fontsize=12; color="#dc2626"; style="rounded"; penwidth=2.2; margin=10;
    p12 [label=<normalize request &nbsp;+&nbsp; choose the view<br/><font point-size="9" color="#dc2626">one call, not two — neither reads the repo</font>>,
         fillcolor="#dbeafe", color="#3b82f6"];
  }

  kb [label="view-selection\nknowledge base", shape=cylinder, fillcolor="#fef9c3",
      color="#ca8a04", fontsize=10];

  a2 [label="view_specification.json\nview type · granularity · required_information[]",
      shape=note, fillcolor="#dcfce7", color="#22c55e", fontsize=10];

  // ---------- phase 3 ----------
  subgraph cluster_p3 {
    label=<  <b>PHASE 3</b>  ·  scope the repository  ·  <b>REWRITTEN</b>  >;
    fontsize=12; color="#dc2626"; style="rounded"; penwidth=2.6; margin=14;
    g1 [label="build repository graph", fillcolor="#ffedd5", color="#f97316"];
    g2 [label="seed        task cues  ‖  centrality", fillcolor="#ffedd5", color="#dc2626", penwidth=2.2];
    g3 [label="expand 1 hop", fillcolor="#ffedd5", color="#dc2626", penwidth=2.2];
    g4 [label="rank, then cut only for token budget", fillcolor="#ffedd5", color="#dc2626", penwidth=2.2];
    g1 -> g2 -> g3 -> g4;
  }

  a3 [label="repository_scope.json\ncandidate areas · coverage report",
      shape=note, fillcolor="#dcfce7", color="#22c55e", fontsize=10];

  // ---------- phase 4 ----------
  subgraph cluster_p4 {
    label=<  <b>PHASE 4</b>  ·  generate and verify  ·  <b>SPLIT IN THREE</b>  >;
    fontsize=12; color="#dc2626"; style="rounded"; penwidth=2.6; margin=14;

    e4a [label="4a  extract      CIAO ‖ ArchView\nN samples → vote", fillcolor="#dbeafe", color="#3b82f6"];
    vm  [label="view_model.json\nelements + evidence + agreement",
         shape=note, fillcolor="#dcfce7", color="#dc2626", penwidth=2.2, fontsize=10];
    e4b [label="4b  render   (deterministic template)", fillcolor="#ffedd5", color="#dc2626", penwidth=2.2];
    e4c [label="4c  validate      syntax  +  SEMANTIC GATE", fillcolor="#ffedd5", color="#dc2626", penwidth=2.2];
    e4a -> vm -> e4b -> e4c;
  }

  out [label="architecture_view.puml   +   validation_report.json",
       fillcolor="#f1f5f9", color="#475569", penwidth=1.6];

  // ---------- side panel ----------
  subgraph cluster_why {
    label=<  <b>WHY THESE CHANGES</b>  >;
    fontsize=12; color="#dc2626"; style="rounded,filled"; fillcolor="#fef2f2";
    penwidth=1.8; margin=12;
    node [shape=plaintext, fillcolor="none", fontsize=10];

    w3 [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>Phase 3 rewritten</b></td></tr>
      <tr><td align="left">v1 keyword scoping, measured on GR10:</td></tr>
      <tr><td align="left"><font color="#dc2626"><b>42% recall · 0 of 8 views covered</b></font></td></tr>
      <tr><td align="left">always missed the persistence boundary</td></tr>
      <tr><td align="left">and the facade — named for their role,</td></tr>
      <tr><td align="left">not for the task</td></tr>
      <tr><td align="left">+1 hop → <b>95%</b>   ·   +content → <b>100%</b></td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left">so: seed by centrality too, expand,</td></tr>
      <tr><td align="left">and never cut except for budget</td></tr>
      </table>>];

    w4 [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>Phase 4 split in three</b></td></tr>
      <tr><td align="left">v1 could not tell a misread repo from</td></tr>
      <tr><td align="left">a mis-rendered diagram — and it made</td></tr>
      <tr><td align="left">CIAO vs ArchView uninterpretable</td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left">the view model fixes both, and carries</td></tr>
      <tr><td align="left">evidence per element</td></tr>
      </table>>];

    w5 [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>Semantic gate added</b></td></tr>
      <tr><td align="left">v1 checked syntax only — ArchView</td></tr>
      <tr><td align="left">already does that</td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left">the gate discriminates: a random class</td></tr>
      <tr><td align="left">pair passes just <b>6.2%</b> of the time,</td></tr>
      <tr><td align="left">human diagrams score <b>129/129</b></td></tr>
      </table>>];

    w6 [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>Confidence is measured now</b></td></tr>
      <tr><td align="left">no invented floats — agreement is the</td></tr>
      <tr><td align="left">fraction of the N parallel samples</td></tr>
      <tr><td align="left">that produced the element</td></tr>
      </table>>];

    w3 -> w4 -> w5 -> w6 [style=invis];
  }

  input -> p12 [lhead=cluster_p12];
  kb -> p12 [style=dashed, color="#ca8a04"];
  p12 -> a2 [ltail=cluster_p12];
  a2 -> g1 [lhead=cluster_p3];
  g4 -> a3 [ltail=cluster_p3];
  a3 -> e4a [lhead=cluster_p4];
  e4c -> out [ltail=cluster_p4];

  legend -> input [style=invis];
  { rank=same; input; kb; }
}
