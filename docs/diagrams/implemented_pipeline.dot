digraph implemented_pipeline {
  rankdir=LR;
  bgcolor="white";
  compound=true;
  nodesep=0.28;
  ranksep=0.45;
  fontname="Helvetica";
  labelloc="t";
  label=<<b>Task2View — implemented pipeline</b><br/><font point-size="11" color="#64748b">Phases 0–4 running · Gemini only in 4a · default scoper = composite</font><br/> >;
  fontsize=18;

  node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded", penwidth=1.4, margin="0.12,0.07"];
  edge [color="#64748b", arrowsize=0.75];

  legend [shape=plaintext, fillcolor="none", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="5">
      <tr>
        <td bgcolor="#ffedd5">deterministic</td>
        <td bgcolor="#dbeafe">Gemini free tier</td>
        <td bgcolor="#fef9c3">knowledge</td>
        <td bgcolor="#dcfce7">JSON / diagram artifact</td>
      </tr>
    </table>>];

  subgraph cluster_in {
    label=<  <b>TWO INPUTS</b>  >;
    fontsize=12; color="#334155"; style="rounded"; penwidth=1.8; margin=10;
    code [label=<code<br/><font point-size="9">local repository path</font>>, fillcolor="#e2e8f0", color="#475569"];
    goal [label=<goal<br/><font point-size="9">"As a Tester, I need …"</font>>, fillcolor="#e2e8f0", color="#475569"];
    code -> goal [style=invis];
  }

  subgraph cluster_p0 {
    label=<  <b>PHASE 0</b>  ·  clean  >;
    fontsize=12; color="#ea580c"; style="rounded"; penwidth=2.0; margin=10;
    p0 [label=<keep source files only<br/><font point-size="9">drop docs, UML, binaries, VCS</font>>, fillcolor="#ffedd5", color="#ea580c"];
  }

  a0 [label=<<b>cleaned_corpus.json</b><br/><font point-size="9">GR10: 44 java kept, 30 dropped</font>>,
      shape=note, fillcolor="#dcfce7", color="#16a34a"];

  subgraph cluster_p1 {
    label=<  <b>PHASE 1</b>  ·  intake  >;
    fontsize=12; color="#ea580c"; style="rounded"; penwidth=2.0; margin=10;
    p1 [label=<parse role + task from the goal<br/><font point-size="9">normalize against V&amp;B Table 9.1</font>>, fillcolor="#ffedd5", color="#ea580c"];
  }

  a1 [label=<<b>normalized_request.json</b><br/><font point-size="9">role · task · repo · request_id</font>>,
      shape=note, fillcolor="#dcfce7", color="#16a34a"];

  subgraph cluster_p2 {
    label=<  <b>PHASE 2</b>  ·  view selection  >;
    fontsize=12; color="#ea580c"; style="rounded"; penwidth=2.0; margin=10;
    p2 [label=<V&amp;B steps 1–3 + task cues<br/><font point-size="9">no LLM · no repo contents</font>>, fillcolor="#ffedd5", color="#ea580c"];
  }

  kb [label=<<b>knowledge</b><br/><font point-size="9">Table 9.1 · stakeholders<br/>viewpoints · notations</font>>,
      shape=cylinder, fillcolor="#fef9c3", color="#ca8a04"];

  a2 [label=<<b>view_specification.json</b><br/><font point-size="9">GR10: scenario / sequence / plantuml</font>>,
      shape=note, fillcolor="#dcfce7", color="#16a34a"];

  subgraph cluster_p3 {
    label=<  <b>PHASE 3</b>  ·  scope  >;
    fontsize=12; color="#ea580c"; style="rounded"; penwidth=2.0; margin=10;
    p3 [label=<composite scoper<br/><font point-size="9">task seeds ∪ degree ∪ layer ∪ 1-hop<br/>Java graph via javalang</font>>, fillcolor="#ffedd5", color="#ea580c"];
  }

  a3 [label=<<b>repository_scope.json</b><br/><font point-size="9">candidate files · origin · coverage</font>>,
      shape=note, fillcolor="#dcfce7", color="#16a34a"];

  subgraph cluster_p4 {
    label=<  <b>PHASE 4</b>  ·  extract / render / gate  >;
    fontsize=12; color="#2563eb"; style="rounded"; penwidth=2.0; margin=10;
    p4a [label=<4a extract view_model<br/><font point-size="9">Gemini Flash + graph summary</font>>, fillcolor="#dbeafe", color="#2563eb"];
    p4b [label=<4b NotationAdapter<br/><font point-size="9">PlantUML / Mermaid / D2</font>>, fillcolor="#ffedd5", color="#ea580c"];
    p4c [label=<4c semantic + syntax gate<br/><font point-size="9">drop unresolved vs repo graph</font>>, fillcolor="#ffedd5", color="#ea580c"];
    p4a -> p4b -> p4c;
  }

  a4 [label=<<b>view_model.json</b><br/>architecture_view.puml<br/><b>validation_report.json</b>>,
      shape=note, fillcolor="#dcfce7", color="#16a34a"];

  code -> p0 [lhead=cluster_p0];
  p0 -> a0;
  goal -> p1 [lhead=cluster_p1];
  a0 -> p1 [style=dashed, color="#16a34a", label="counts", fontsize=9];
  p1 -> a1;
  a1 -> p2 [lhead=cluster_p2];
  kb -> p2 [lhead=cluster_p2];
  p2 -> a2;
  a0 -> p3 [lhead=cluster_p3];
  a2 -> p3 [lhead=cluster_p3];
  p3 -> a3;
  a3 -> p4a [lhead=cluster_p4];
  p4c -> a4;
}
