digraph phase3 {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  labelloc="t";
  label=<<b>Phase 3: why keyword scoping fails</b><br/><font point-size="11" color="#64748b">measured on GR10, task = "design integration tests for user registration"</font><br/> >;
  fontsize=17;
  node [fontname="Helvetica", fontsize=10.5, shape=box, style="filled,rounded", penwidth=1.4, margin="0.13,0.07"];
  edge [color="#64748b", arrowsize=0.7];
  nodesep=0.25; ranksep=0.40;

  // ---------------- v1 ----------------
  subgraph cluster_v1 {
    label=<  <b>v1</b>  ·  match task keywords against file names  >;
    fontsize=13; color="#dc2626"; style="rounded"; penwidth=2.2; margin=14;

    cue1 [label="cues:  registr…  ·  utente", fillcolor="#fef9c3", color="#ca8a04"];

    hit1 [label=<<table border="0" cellborder="0" cellspacing="1">
        <tr><td align="left"><b>selected — 3 of 9</b></td></tr>
        <tr><td align="left">GUIRegistrazioneUtente</td></tr>
        <tr><td align="left">ControllerRegistrazioneUtente</td></tr>
        <tr><td align="left">Utente</td></tr>
      </table>>, fillcolor="#dcfce7", color="#22c55e"];

    miss1 [label=<<table border="0" cellborder="0" cellspacing="1">
        <tr><td align="left"><b><font color="#dc2626">MISSED — 6 of 9</font></b></td></tr>
        <tr><td align="left">ControllerServiziSistema &nbsp;<i>the facade</i></td></tr>
        <tr><td align="left">ServizioPersistenza &nbsp;<i>persistence</i></td></tr>
        <tr><td align="left">ServizioUtenti &nbsp;<i>domain service</i></td></tr>
        <tr><td align="left">GUIHomePage</td></tr>
        <tr><td align="left">Cittadino &nbsp;·&nbsp; OperatoreComunale</td></tr>
      </table>>, fillcolor="#fee2e2", color="#dc2626", penwidth=2.2];

    cue1 -> hit1; cue1 -> miss1 [style=dashed, color="#dc2626"];
  }

  diag1 [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>the pattern, across all 8 views</b></td></tr>
      <tr><td align="left">persistence boundary missed <b>8/8</b></td></tr>
      <tr><td align="left">system facade missed <b>7/8</b></td></tr>
      <tr><td align="left">dashboard boundary missed <b>6/8</b></td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left">these are named for their <b>architectural role</b>,</td></tr>
      <tr><td align="left">never for the task — so a task keyword</td></tr>
      <tr><td align="left">can never reach them</td></tr>
    </table>>, shape=box, fillcolor="#fef2f2", color="#dc2626", penwidth=1.8, fontsize=10];

  // ---------------- v2 ----------------
  subgraph cluster_v2 {
    label=<  <b>v2</b>  ·  seed from three sources, then expand  >;
    fontsize=13; color="#16a34a"; style="rounded"; penwidth=2.2; margin=14;

    graph2 [label="repository graph\n40 types · 97 edges · cached", fillcolor="#ffedd5", color="#f97316"];

    s_a [label="task seeds\none query per\nrequired_information item", fillcolor="#dbeafe", color="#3b82f6"];
    s_b [label=<<b>centrality seeds</b><br/>top-k hub nodes>,
         fillcolor="#dcfce7", color="#16a34a", penwidth=2.2];
    s_c [label=<<b>layer-coverage seeds</b><br/>top-n per package<br/><font color="#16a34a">catches thin-but-critical layers</font>>,
         fillcolor="#dcfce7", color="#16a34a", penwidth=2.2];

    exp [label="expand 1 hop  ·  union", fillcolor="#ffedd5", color="#f97316"];
    bud [label="cut only for token budget\nfits → scope_strategy = \"full\"", fillcolor="#ffedd5", color="#f97316"];

    graph2 -> s_a; graph2 -> s_b; graph2 -> s_c;
    s_a -> exp; s_b -> exp; s_c -> exp;
    exp -> bud;
  }

  fix [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>centrality alone is not enough</b></td></tr>
      <tr><td align="left">it does catch the facade: ControllerServiziSistema</td></tr>
      <tr><td align="left">ranks <b>#2 of 40</b> (degree 14 vs 4 for the next Control)</td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left">but <font color="#dc2626">ServizioPersistenza ranks only #16</font> (degree 3):</td></tr>
      <tr><td align="left">everything reaches persistence, yet only through</td></tr>
      <tr><td align="left">two services. top-12 centrality still misses it.</td></tr>
      <tr><td align="left"> </td></tr>
      <tr><td align="left"><b>layer coverage catches it.</b> top-2 per package =</td></tr>
      <tr><td align="left">8 seeds, and recovers the facade, the dashboard</td></tr>
      <tr><td align="left">and the persistence boundary together.</td></tr>
    </table>>, shape=box, fillcolor="#f0fdf4", color="#16a34a", penwidth=1.8, fontsize=10];

  // ---------------- results ----------------
  results [shape=plaintext, fillcolor="none", label=<
    <table border="1" cellborder="1" cellspacing="0" cellpadding="7" color="#94a3b8">
      <tr bgcolor="#f1f5f9">
        <td><b>scoping strategy</b></td><td><b>recall</b></td>
        <td><b>views fully covered</b></td><td><b>files selected</b></td></tr>
      <tr><td align="left">file-name keywords &nbsp;<font color="#dc2626">(v1)</font></td>
          <td><font color="#dc2626"><b>42%</b></font></td>
          <td><font color="#dc2626"><b>0 of 8</b></font></td><td>9.1 / 40</td></tr>
      <tr><td align="left">+ full-text grep</td><td>89%</td><td>1 of 8</td><td>28.9 / 40</td></tr>
      <tr><td align="left">name + 1 hop</td><td>95%</td><td>5 of 8</td><td>24.0 / 40</td></tr>
      <tr bgcolor="#f0fdf4"><td align="left">content + 1 hop &nbsp;<font color="#16a34a">(v2)</font></td>
          <td><font color="#16a34a"><b>100%</b></font></td>
          <td><font color="#16a34a"><b>8 of 8</b></font></td><td>37.9 / 40</td></tr>
    </table>>];

  caveat [label=<<table border="0" cellborder="0" cellspacing="2">
      <tr><td align="left"><b>and note the last column</b></td></tr>
      <tr><td align="left">full coverage needs 38 of 40 files.</td></tr>
      <tr><td align="left">at 72k tokens the whole repo already fits —</td></tr>
      <tr><td align="left">so on this data, scoping that works is</td></tr>
      <tr><td align="left">barely scoping at all.</td></tr>
      <tr><td align="left"><b>keep "full" as a comparison arm.</b></td></tr>
    </table>>, shape=box, fillcolor="#fffbeb", color="#ca8a04", penwidth=1.8, fontsize=10];

  miss1 -> graph2 [style=invis];
  bud -> results [style=invis];
  results -> caveat [style=invis];

  cue1 -> diag1 [style=invis];
  graph2 -> fix [style=invis];
}
