@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
classDiagram {
  class { BackgroundColor #F8FAFC }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title UML class diagram: persisted clinic data (JPA entities)
hide empty members
skinparam classAttributeIconSize 0

class "Owner" as Owner {
  lastName: String {indexed}
  city: String {≤ 80}
  telephone: String {10 digits}
}
class "Pet" as Pet {
  name: String {unique per owner}
  birthDate: LocalDate
}
class "Visit" as Visit {
  date: LocalDate
  description: String {≤ 255}
}
class "PetType" as PetType {
  name: String {≤ 80}
}
class "Vet" as Vet {
  lastName: String {≤ 30}
}
class "Specialty" as Specialty {
  name: String {≤ 80}
}

Owner "0..1" *--> "0..*" Pet : pets
Pet   "0..1" *--> "0..*" Visit : visits
Pet   "0..*" --> "1" PetType : type
Vet   "0..*" --> "0..*" Specialty : specialties

note bottom of Vet
  join table vet_specialties
  (vet_id, specialty_id)
end note
note as N1
  Every class also has id: Integer
  (PK, identity) from BaseEntity.
  Tables: owners, pets, visits,
  types, vets, specialties.
  Filled diamond: cascade ALL,
  eager fetch, FK on the part side.
end note
@enduml
