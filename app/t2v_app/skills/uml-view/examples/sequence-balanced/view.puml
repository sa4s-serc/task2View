@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
sequenceDiagram {
  participant { Margin 0 12 }
  lifeLine    { LineColor #94A3B8 }
  group       { FontSize 12 }
}
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype

' ---- body ----
title UML sequence diagram: add an owner (POST /owners/new)
hide footbox
autonumber "<b>00"

actor       "Test client\n(HTTP / MockMvc)"        as client
participant "Owner web controller\n(OwnerController)" as ctl
participant "OwnerRepository\n(Spring Data JPA)"   as repo
participant "Clinic database"                      as db

client -> ctl ++ : POST /owners/new\n(firstName, lastName, address, city, telephone)
ctl -> ctl : bind + validate Owner (@Valid)
alt fields valid
  ctl -> repo ++ : save(owner)
  repo -> db : INSERT INTO owners
  repo --> ctl -- : owner with generated id
  ctl --> client : 302 redirect /owners/{id}\nflash "New Owner Created"
else field errors
  ctl --> client -- : 200 owners/createOrUpdateOwnerForm\nwith field errors (blank, too long,\ntelephone not 10 digits); nothing saved
end
@enduml
