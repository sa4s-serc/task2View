@startuml
' ---- house style (slide) ----
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam maxMessageSize 180
skinparam wrapWidth 180
<style>
root {
  FontName Helvetica
  FontSize 14
  FontColor #1F2937
}
element { BackgroundColor #F1F5F9; LineColor #475569; LineThickness 1.2; RoundCorner 6 }
arrow   { LineColor #475569; LineThickness 1.2; FontSize 12; MaximumWidth 180 }
note    { BackgroundColor #FFF7E0; LineColor #B45309; FontSize 12; MaximumWidth 220 }
title   { FontSize 18; FontStyle bold }
caption { FontSize 12; FontColor #64748B }
legend  { FontSize 12; BackgroundColor white; LineColor #CBD5E1; MaximumWidth 320 }
.accent { BackgroundColor #1D4ED8; FontColor white; LineColor #1E3A8A }
.alert  { BackgroundColor #FEE2E2; FontColor #7F1D1D; LineColor #B91C1C }
.muted  { BackgroundColor #F8FAFC; FontColor #64748B; LineColor #CBD5E1 }
</style>
hide <<accent>> stereotype
hide <<alert>> stereotype
hide <<muted>> stereotype
' ---- layout (Graphviz dot) ----
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction

' ---- body ----
title UML deployment diagram: PetClinic on Kubernetes (k8s/)

node "Client machine" as client <<device>>

node "Kubernetes cluster\n(kind in CI)" as cluster <<executionEnvironment>> {
  artifact "Secret demo-db\n(servicebinding.io/postgresql)" as secret
  node "petclinic Pod\n(1 replica)" as appPod <<executionEnvironment>> {
    artifact "dsyer/petclinic\n(container image)" as appImg
  }
  node "demo-db Pod" as dbPod <<executionEnvironment>> {
    artifact "postgres:18.4\n(container image)" as dbImg
  }
}

client --> appPod : HTTP, Service petclinic\nNodePort :80 -> 8080
appPod --> dbPod  : PostgreSQL :5432\nService demo-db (unconfirmed)
appPod ..> secret : mounts (volume)
dbPod  ..> secret : reads user, password, db

note bottom of appPod
  profile postgres
  probes /livez, /readyz
  binding at /bindings/secret
end note
@enduml
